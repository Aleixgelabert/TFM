	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSIF Event_Stop = INIT_CONTINUOUS OR Event_Dump = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS THEN
		WB_D.B_Open := FALSE;
		WB_F.B_Open := FALSE;
		WB_H.B_Open := FALSE;
		WB_M.B_Open := FALSE;

		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	ELSE
