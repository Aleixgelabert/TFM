			Pause := NOT Pause;
		END_IF

		Init := TRUE;

		IF NOT (WB_D.SF_Open AND WB_D.State = 0) THEN WB_D.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_F.SF_Open AND WB_F.State = 0) THEN WB_F.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_H.SF_Open AND WB_H.State = 0) THEN WB_H.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_M.SF_Open AND WB_M.State = 0) THEN WB_M.B_Open := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_D.B_Open := FALSE;
			WB_F.B_Open := FALSE;
			WB_H.B_Open := FALSE;
			WB_M.B_Open := FALSE;

			TimeCnt  := 0.0;

			IF SF_P_Aft THEN
				TimeCnt := 0.0;
				State   := 5000;
				Next    := 0;
			ELSE
				EVP_Pump := REAL_TO_INT(EVP_Pump_Tgt * Perc * 10.0);
				OUT_LP   := 1;
				State    := State + 100; (*Port Fwd Dump - Pump*)
			END_IF

		END_IF
	END_IF

(*Move Pump*)
3610,3620,3630,3640:
	IF Manual OR NOT Ready THEN
		OUT_LP   := 0;
		State    := 0;

	ELSE
		IF Event_Stop = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS OR Event_Move = INIT_CONTINUOUS
		OR State = 3610 AND SF_S_Fwd
		OR State = 3620 AND SF_S_Aft
		OR State = 3630 AND SF_P_Fwd
		OR State = 3640 AND SF_P_Aft
		THEN
			SoftStop := TRUE;
		END_IF

		IF Event_Move = INIT_CONTINUOUS THEN
			Pause := NOT Pause;
		END_IF

		IF SoftStop OR Pause THEN
			EVP_Pump_Tgt := EVP_Pump_Tgt - CFG.EVP_Pump_Dec * CFG.Cycle;
			EVP_Pump_Tgt := MIN(EVP_Pump_Tgt, CFG.EVP_Pump_Max);
			EVP_Pump_Tgt := MAX(EVP_Pump_Tgt, CFG.EVP_Pump_Min);

			IF EVP_Pump_Tgt = CFG.EVP_Pump_Min OR CFG.EVP_Pump_Dec <= 0
			THEN EVP_Pump := 0;
			ELSE EVP_Pump := REAL_TO_UINT(EVP_Pump_Tgt * Perc * 10.0);
			END_IF

		ELSE
			EVP_Pump_Tgt := EVP_Pump_Tgt + CFG.EVP_Pump_Inc * CFG.Cycle;
			EVP_Pump_Tgt := MIN(EVP_Pump_Tgt, CFG.EVP_Pump_Max);
			EVP_Pump_Tgt := MAX(EVP_Pump_Tgt, CFG.EVP_Pump_Min);

			EVP_Pump := REAL_TO_UINT(EVP_Pump_Tgt * Perc * 10.0);

		END_IF

		IF EVP_Pump = 0 THEN
			OUT_LP := 0;

			IF SoftStop THEN
				TimeCnt := 0.0;
				State   := 5000;
				Next    := 0;
			END_IF

		ELSE
			OUT_LP := 1;

		END_IF
	END_IF


(*****************************************************************************)
(** INIT                                                                    **)
(*****************************************************************************)
(*Init Status - Valves*)
5000:
	OUT_Stop := TRUE;

	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		TimeCnt := 0.0;
		Error   := State;
		State   := 5001; (*Siempre fuerzo el scoop*)

	ELSE
		Init := TRUE;
	
		IF NOT (WB_A.SF_Close AND WB_A.State = 0) THEN WB_A.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_B.SF_Close AND WB_B.State = 0) THEN WB_B.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_C.SF_Close AND WB_C.State = 0) THEN WB_C.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_D.SF_Close AND WB_D.State = 0) THEN WB_D.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_E.SF_Close AND WB_E.State = 0) THEN WB_E.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_F.SF_Close AND WB_F.State = 0) THEN WB_F.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_G.SF_Close AND WB_G.State = 0) THEN WB_G.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_H.SF_Close AND WB_H.State = 0) THEN WB_H.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_I.SF_Close AND WB_I.State = 0) THEN WB_I.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_J.SF_Close AND WB_J.State = 0) THEN WB_J.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_K.SF_Close AND WB_K.State = 0) THEN WB_K.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_L.SF_Close AND WB_L.State = 0) THEN WB_L.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_M.SF_Close AND WB_M.State = 0) THEN WB_M.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_N.SF_Close AND WB_N.State = 0) THEN WB_N.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_R.SF_Close AND WB_R.State = 0) THEN WB_R.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_S.SF_Close AND WB_S.State = 0) THEN WB_S.B_Close := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_A.B_Close := FALSE;
			WB_B.B_Close := FALSE;
			WB_C.B_Close := FALSE;
			WB_D.B_Close := FALSE;
			WB_E.B_Close := FALSE;
			WB_F.B_Close := FALSE;
			WB_G.B_Close := FALSE;
			WB_H.B_Close := FALSE;
			WB_I.B_Close := FALSE;
			WB_J.B_Close := FALSE;
			WB_K.B_Close := FALSE;
			WB_L.B_Close := FALSE;
			WB_M.B_Close := FALSE;
			WB_N.B_Close := FALSE;
			WB_R.B_Close := FALSE;
			WB_S.B_Close := FALSE;

			State := 5001;

		END_IF
	END_IF

(*Init Status - Scoop UP*)
5001:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSE
		Init := TRUE;
	
		IF NOT (WB_PUD.SF_Close AND WB_PUD.State = 0) THEN WB_PUD.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_SUD.SF_Close AND WB_SUD.State = 0) THEN WB_SUD.B_Close := TRUE; Init := FALSE; END_IF

		IF CFG.EnScoopAF THEN
			IF NOT (WB_PAF.SF_Close AND WB_PAF.State = 0) THEN WB_PAF.B_Close := TRUE; Init := FALSE; END_IF (*test1*)
			IF NOT (WB_SAF.SF_Close AND WB_SAF.State = 0) THEN WB_SAF.B_Close := TRUE; Init := FALSE; END_IF (*test2*)
		END_IF

		IF Init THEN
			WB_PUD.B_Close := FALSE;
			WB_SUD.B_Close := FALSE;

			WB_PAF.B_Close := FALSE; (*test3*)
			WB_SAF.B_Close := FALSE; (*test4*)

			TimeCnt := 0.0;	 (*test5*)
			State   := Next; (*test6*)

			IF State = 0 THEN
				OUT_P_Fwd := FALSE;
				OUT_P_Aft := FALSE;
				OUT_S_Fwd := FALSE;
				OUT_S_Aft := FALSE;
				OUT_12    := FALSE;
			END_IF

			(*State := 5002;*) (*test7*)

		END_IF
	END_IF

(*Init Status - Scoop FWD*) (*No enta mas!*)
(*5002:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSE
		Init := TRUE;
	
		IF NOT (WB_PAF.SF_Close AND WB_PAF.State = 0) THEN WB_PAF.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_SAF.SF_Close AND WB_SAF.State = 0) THEN WB_SAF.B_Close := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_PAF.B_Close := FALSE;
			WB_SAF.B_Close := FALSE;

			TimeCnt := 0.0;
			State   := Next;

		END_IF
	END_IF*)

END_CASE

