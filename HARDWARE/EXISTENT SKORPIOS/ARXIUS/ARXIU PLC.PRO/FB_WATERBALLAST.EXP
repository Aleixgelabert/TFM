			IF SF_S_Aft THEN
				State := State + 200; (*if already empty jump pump*)
			ELSE
				EVP_Pump := REAL_TO_INT(EVP_Pump_Tgt * Perc * 10.0);
				OUT_LP   := 1;
				State    := State + 100; (*Port Fwd Dump - Pump*)
			END_IF

		END_IF
	END_IF

(*DUMP Pump*)
2310,2320,2330,2340:
	IF Manual OR NOT Ready THEN
		OUT_LP   := 0;
		State    := 0;

	ELSE
		IF Event_Stop = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS OR Event_Move = INIT_CONTINUOUS
		OR State = 2310 AND SF_P_Fwd
		OR State = 2320 AND SF_P_Aft
		OR State = 2330 AND SF_S_Fwd
		OR State = 2340 AND SF_S_Aft
		THEN
			SoftStop := TRUE;
		END_IF

		IF Event_Dump = INIT_CONTINUOUS THEN
			Pause := NOT Pause;
		END_IF

		IF SoftStop OR Pause THEN
			EVP_Pump_Tgt := EVP_Pump_Tgt - CFG.EVP_Pump_Dec * CFG.Cycle;
			EVP_Pump_Tgt := MIN(EVP_Pump_Tgt, CFG.EVP_Pump_Max);
			EVP_Pump_Tgt := MAX(EVP_Pump_Tgt, CFG.EVP_Pump_Min);

			IF EVP_Pump_Tgt = CFG.EVP_Pump_Min OR CFG.EVP_Pump_Dec <= 0
			THEN EVP_Pump := 0;
			ELSE EVP_Pump := REAL_TO_UINT(EVP_Pump_Tgt * Perc * 10.0);
			END_IF

		ELSE
			EVP_Pump_Tgt := EVP_Pump_Tgt + CFG.EVP_Pump_Inc * CFG.Cycle;
			EVP_Pump_Tgt := MIN(EVP_Pump_Tgt, CFG.EVP_Pump_Max);
			EVP_Pump_Tgt := MAX(EVP_Pump_Tgt, CFG.EVP_Pump_Min);

			EVP_Pump := REAL_TO_UINT(EVP_Pump_Tgt * Perc * 10.0);

		END_IF

		IF EVP_Pump = 0 THEN
			OUT_LP := 0;

			IF SoftStop THEN
				TimeCnt := 0.0;
				State   := State + 100;
			END_IF

		ELSE
			OUT_LP := 1;

		END_IF
	END_IF

(*Port Dump - Valves2*)
2410,2420:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSIF Event_Stop = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS OR Event_Move = INIT_CONTINUOUS THEN
		WB_E.B_Open  := FALSE;
		WB_F.B_Close := FALSE;

		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	ELSE
		Init := TRUE;
	
		IF NOT (WB_E.SF_Open  AND WB_E.State = 0) THEN WB_E.B_Open  := TRUE; Init := FALSE; END_IF
		IF NOT (WB_F.SF_Close AND WB_F.State = 0) THEN WB_F.B_Close := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_E.B_Open  := FALSE;
			WB_F.B_Close := FALSE;

			TimeCnt  := 0.0;
			State    := 2500; (*Port Dump*)

		END_IF
	END_IF

(*Stbd Dump - Valves2*)
2430,2440:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSIF Event_Stop = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS OR Event_Move = INIT_CONTINUOUS THEN
		WB_H.B_Open  := FALSE;
		WB_L.B_Close := FALSE;

		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	ELSE
		Init := TRUE;
	
		IF NOT (WB_H.SF_Open  AND WB_H.State = 0) THEN WB_H.B_Open  := TRUE; Init := FALSE; END_IF
		IF NOT (WB_L.SF_Close AND WB_L.State = 0) THEN WB_L.B_Close := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_H.B_Open  := FALSE;
			WB_L.B_Close := FALSE;

			TimeCnt  := 0.0;
			State    := 2500; (*Port Dump*)

		END_IF
	END_IF

(*DUMP - WAIT*)
2500:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > TimeDump OR Event_Stop = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS OR Event_Move = INIT_CONTINUOUS THEN
		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	END_IF

