			WB_F.B_Open := FALSE;
			WB_H.B_Open := FALSE;
			WB_J.B_Open := FALSE;

			TimeCnt  := 0.0;

			IF SF_P_Aft THEN
				State := State + 200; (*if already empty jumo pump*)
			ELSE
				EVP_Pump := REAL_TO_INT(EVP_Pump_Tgt * Perc * 10.0);
				OUT_LP   := 1;
				State    := State + 100; (*Port Fwd Dump - Pump*)
			END_IF

		END_IF
	END_IF

(*Stbd Fwd Dump - Valves*)
2230:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
