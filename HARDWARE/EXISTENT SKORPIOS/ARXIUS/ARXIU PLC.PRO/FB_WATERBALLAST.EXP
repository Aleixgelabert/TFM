		END_IF

		Init := TRUE;

		IF NOT (WB_A.SF_Open AND WB_A.State = 0) THEN WB_A.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_F.SF_Open AND WB_F.State = 0) THEN WB_F.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_H.SF_Open AND WB_H.State = 0) THEN WB_H.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_K.SF_Open AND WB_K.State = 0) THEN WB_K.B_Open := TRUE; Init := FALSE; END_IF

