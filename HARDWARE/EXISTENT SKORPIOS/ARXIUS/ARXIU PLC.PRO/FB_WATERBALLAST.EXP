			WB_A.B_Open := FALSE;
			WB_E.B_Open := FALSE;
			WB_K.B_Open := FALSE;
			WB_L.B_Open := FALSE;

			TimeCnt  := 0.0;

			IF SF_S_Fwd THEN
				TimeCnt := 0.0;
				State   := 5000;
				Next    := 0;
			ELSE
				EVP_Pump := REAL_TO_INT(EVP_Pump_Tgt * Perc * 10.0);
				OUT_LP   := 1;
				State    := State + 100; (*Port Fwd Dump - Pump*)
			END_IF

		END_IF
	END_IF

