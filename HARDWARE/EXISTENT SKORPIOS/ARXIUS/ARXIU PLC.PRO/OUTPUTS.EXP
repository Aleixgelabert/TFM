	N28_DO3_CH1_2 := EV2111;
	N28_DO2_CH1_4 := EV2109;
	N28_DO1_CH2_2 := EV2107;
	N28_DO0_CH2_4 := EV2105;
	N28_DO7_CH3_2 := EV2103;
	N28_DO6_CH3_4 := EV2101;

(*Node29 - MF24*)
	N29_DO3_CH1_2 := EV2411;
	N29_DO2_CH1_4 := EV2409;
	N29_DO1_CH2_2 := EV2407;
	N29_DO0_CH2_4 := EV2405;
	N29_DO7_CH3_2 := EV2403;
	N29_DO6_CH3_4 := EV2401;

(*Node30 - MF23*)
	N30_DO3_CH1_2 := EV2311;
	N30_DO2_CH1_4 := EV2309;
	N30_DO1_CH2_2 := EV2307;
	N30_DO0_CH2_4 := EV2305;
	N30_DO7_CH3_2 := EV2303;
	N30_DO6_CH3_4 := EV2301;

(*Node31 - MF20*)
	N31_DO3_CH1_2 := EV2011;
	N31_DO2_CH1_4 := EV2009;
	N31_DO1_CH2_2 := EV2007;
	N31_DO0_CH2_4 := EV2005;
	N31_DO7_CH3_2 := EV2003;
	N31_DO6_CH3_4 := EV2001;

(*Node32 - MF19*)
	N32_DO3_CH1_2 := EV1911;
	N32_DO2_CH1_4 := EV1909;
	N32_DO1_CH2_2 := EV1907;
	N32_DO0_CH2_4 := EV1905;
	N32_DO7_CH3_2 := EV1903;
	N32_DO6_CH3_4 := EV1901;

(*Node33 - MF13 - Traveller*)
	N33_DO3_CH1_2 := EV1302;
	N33_DO2_CH1_4 := EV1301;
	N33_DO1_CH2_2 := EV1303;

(*Node35 - MF09 - Traveller*)
(*	IF EVP905.Bar > 0 THEN
		N35_EVP3_CH1_2 := EVP905.mA := REAL_TO_UINT(EVP905.Bar * EVP905.Cal_K + EVP905.Cal_Off);
	ELSE
		N35_EVP3_CH1_2 := EVP905.mA := 0;
	END_IF*)

	N35_DO3_CH1_2 := EV905;
	N35_DO2_CH1_4 := EV906;
	N35_DO1_CH2_2 := EV901;
	N35_DO0_CH2_4 := EV902;
	N35_DO7_CH3_2 := EV903;
	N35_DO6_CH3_4 := EV904;
	N35_DO5_CH4_2 := EV907;
	N35_DO4_CH4_4 := EV908;

(*Node47 - MF11*)
	N47_DO1_CH2_2 := EV1101;

(*Node50/59*)
	IF NOT ENGINE.Engine_ON THEN
		IF    EVP402_3 > 0 THEN EVP402_3 :=  MAX_PSX;
		ELSIF EVP402_3 < 0 THEN EVP402_3 := -MAX_PSX;
		END_IF
		IF    EVP404_5 > 0 THEN EVP404_5 :=  MAX_PSX;
		ELSIF EVP404_5 < 0 THEN EVP404_5 := -MAX_PSX;
		END_IF
		IF    EVP406_7 > 0 THEN EVP406_7 :=  MAX_PSX;
		ELSIF EVP406_7 < 0 THEN EVP406_7 := -MAX_PSX;
		END_IF

		IF    EVP1202_3 > 0 THEN EVP1202_3 :=  MAX_PSX;
		ELSIF EVP1202_3 < 0 THEN EVP1202_3 := -MAX_PSX;
		END_IF
		IF    EVP1204_5 > 0 THEN EVP1204_5 :=  MAX_PSX;
		ELSIF EVP1204_5 < 0 THEN EVP1204_5 := -MAX_PSX;
		END_IF
		IF    EVP1206_7 > 0 THEN EVP1206_7 :=  MAX_PSX;
		ELSIF EVP1206_7 < 0 THEN EVP1206_7 := -MAX_PSX;
		END_IF
		IF    EVP1208_9 > 0 THEN EVP1208_9 :=  MAX_PSX;
		ELSIF EVP1208_9 < 0 THEN EVP1208_9 := -MAX_PSX;
		END_IF
		IF    EVP1210_1 > 0 THEN EVP1210_1 :=  MAX_PSX;
		ELSIF EVP1210_1 < 0 THEN EVP1210_1 := -MAX_PSX;
		END_IF
		IF    EVP1212_3 > 0 THEN EVP1212_3 :=  MAX_PSX;
		ELSIF EVP1212_3 < 0 THEN EVP1212_3 := -MAX_PSX;
		END_IF
		IF    EVP1214_5 > 0 THEN EVP1214_5 :=  MAX_PSX;
		ELSIF EVP1214_5 < 0 THEN EVP1214_5 := -MAX_PSX;
		END_IF
		(*IF  EVP1216_7 > 0 THEN EVP1216_7 :=  MAX_PSX; (*Board. Proper value when not Engine.*)
		ELSIF EVP1216_7 < 0 THEN EVP1216_7 := -MAX_PSX;
		END_IF
		IF    EVP1218_9 > 0 THEN EVP1218_9 :=  MAX_PSX;
		ELSIF EVP1218_9 < 0 THEN EVP1218_9 := -MAX_PSX;
		END_IF*)
		(*IF  EVP1220_1 > 0 THEN EVP1220_1 :=  MAX_PSX; (*Keel Fill. Not Without Engine.*)
		ELSIF EVP1220_1 < 0 THEN EVP1220_1 :=  0;
		END_IF*)

		IF    EVP1602_3 > 0 THEN EVP1602_3 :=  MAX_PSX;
		ELSIF EVP1602_3 < 0 THEN EVP1602_3 := -MAX_PSX;
		END_IF
		IF    EVP1604_5 > 0 THEN EVP1604_5 :=  MAX_PSX;
		ELSIF EVP1604_5 < 0 THEN EVP1604_5 := -MAX_PSX;
		END_IF
		IF    EVP1606_7 > 0 THEN EVP1606_7 :=  MAX_PSX;
		ELSIF EVP1606_7 < 0 THEN EVP1606_7 := -MAX_PSX;
		END_IF
		IF    EVP1608_9 > 0 THEN EVP1608_9 :=  MAX_PSX;
		ELSIF EVP1608_9 < 0 THEN EVP1608_9 := -MAX_PSX;
		END_IF
		IF    EVP1610_1 > 0 THEN EVP1610_1 :=  MAX_PSX;
		ELSIF EVP1610_1 < 0 THEN EVP1610_1 := -MAX_PSX;
		END_IF

	END_IF

	PSX50( SP:= EVP1202_3, IN:= N50_IN, OUT:= N50_OUT );
	PSX51( SP:= EVP1204_5, IN:= N51_IN, OUT:= N51_OUT );
	PSX52( SP:= EVP1206_7, IN:= N52_IN, OUT:= N52_OUT );
	PSX53( SP:= EVP1208_9, IN:= N53_IN, OUT:= N53_OUT );
	PSX54( SP:= EVP1210_1, IN:= N54_IN, OUT:= N54_OUT );
	PSX55( SP:= EVP1212_3, IN:= N55_IN, OUT:= N55_OUT );
	PSX56( SP:= EVP1214_5, IN:= N56_IN, OUT:= N56_OUT );
	PSX57( SP:= EVP1216_7, IN:= N57_IN, OUT:= N57_OUT );
	PSX58( SP:= EVP1218_9, IN:= N58_IN, OUT:= N58_OUT );
	PSX59( SP:= EVP1220_1, IN:= N59_IN, OUT:= N59_OUT );

	PSX60( SP:= EVP402_3, IN:= N60_IN, OUT:= N60_OUT );
	PSX61( SP:= EVP404_5, IN:= N61_IN, OUT:= N61_OUT );
	PSX64( SP:= EVP406_7, IN:= N64_IN, OUT:= N64_OUT );

	PSX70( SP:= EVP1602_3, IN:= N70_IN, OUT:= N70_OUT );
	PSX71( SP:= EVP1604_5, IN:= N71_IN, OUT:= N71_OUT );
	PSX72( SP:= EVP1606_7, IN:= N72_IN, OUT:= N72_OUT );
	PSX73( SP:= EVP1608_9, IN:= N73_IN, OUT:= N73_OUT );
	PSX74( SP:= EVP1610_1, IN:= N74_IN, OUT:= N74_OUT );

(*-------------------*)
(*-- Panel Buttons --*)
(*-------------------*)
SIDimmerUp( T_Cont:= T#0ms, T_DClk:= T#0ms);
SIDimmerDw(In:= N103_IN.5, T_Cont:= T#0ms, T_DClk:= T#0ms);

IF SIDimmerUp.Event = INIT_CONTINUOUS
OR SIDimmerDw.Event = INIT_CONTINUOUS
THEN

	IF byDimmerState = 2
	THEN byDimmerState := 0;
	ELSE byDimmerState := byDimmerState + 1;
	END_IF

END_IF

CASE byDimmerState OF
0:
	wDimmerBackLight := 100;
	byDimmerLedBar   := 16#9F; (*16#80 + 16#1F*)
	byDimmerDeckLink := 16#07;
	byDimmerBLink    := 16#3F;

1:
	wDimmerBackLight := Dimmer_Panels;
	byDimmerLedBar   := REAL_TO_USINT(Dimmer_LedBar   * 0.31) + 16#80;
	byDimmerDeckLink := REAL_TO_USINT(Dimmer_DEckLink * 0.07);
	byDimmerBLink    := REAL_TO_USINT(Dimmer_Panels   * 0.63);

2:
	wDimmerBackLight := 100;
	byDimmerLedBar   := 16#9F; (*16#80 + 16#1F*)
	byDimmerDeckLink := 16#07;
	byDimmerBLink    := 16#3F;

END_CASE

IF byDimmerState > 0 AND MAIN.aSys_Enable[2] AND wDimmerBackLight > 0 THEN
	N102_OUT := 16#FFFF;
	N103_OUT := 16#FFFF;
	N104_OUT := 16#FFFF;
	N105_OUT := 16#FFFF;
	N106_OUT := 16#FFFF;
	N107_OUT := 16#FFFF;
	N108_OUT := 16#FFE0;
	N109_OUT := 16#FFE0;
	N110_OUT := 16#FFFF;
	N111_OUT := 16#FFFF;
	N112_OUT := 16#FFFF;
	N113_OUT := 16#FFFF;
	N114_OUT := 16#FFFF;
	N115_OUT := 16#FFFF;
	N116_OUT := 16#FFFF;
	N117_OUT := 16#FFFF;
	N118_OUT := 16#FFFF;
	N119_OUT := 16#FFFF;

	N120_LED_R := 16#0000;
	N120_LED_G := 16#03DE;
	N120_LED_B := 16#0021;
	N121_LED_R := 16#00FF;
	N121_LED_G := 16#0000;
	N121_LED_B := 16#0000;

ELSE
	N102_OUT := 0;
	N103_OUT := 0;
	N104_OUT := 0;
	N105_OUT := 0;
	N106_OUT := 0;
	N107_OUT := 0;
	N108_OUT := 0;
	N109_OUT := 0;
	N110_OUT := 0;
	N111_OUT := 0;
	N112_OUT := 0;
	N113_OUT := 0;
	N114_OUT := 0;
	N115_OUT := 0;
	N116_OUT := 0;
	N117_OUT := 0;
	N118_OUT := 0;
	N119_OUT := 0;

	N120_LED_R := 0;
	N120_LED_G := 0;
	N120_LED_B := 0;
	N121_LED_R := 0;
	N121_LED_G := 0;
	N121_LED_B := 0;
END_IF

IF wDimmerBackLight = 0 THEN wDimmerBackLight := 1; END_IF

N102_DIMMER := wDimmerBackLight;
N103_DIMMER := wDimmerBackLight;
N104_DIMMER := wDimmerBackLight;
N105_DIMMER := wDimmerBackLight;
N106_DIMMER := wDimmerBackLight;
N107_DIMMER := wDimmerBackLight;
N108_DIMMER := wDimmerBackLight;
N109_DIMMER := wDimmerBackLight;
N110_DIMMER := wDimmerBackLight;
N111_DIMMER := wDimmerBackLight;
N112_DIMMER := wDimmerBackLight;
N113_DIMMER := wDimmerBackLight;
N114_DIMMER := wDimmerBackLight;
N115_DIMMER := wDimmerBackLight;
N116_DIMMER := wDimmerBackLight;
N117_DIMMER := wDimmerBackLight;
N118_DIMMER := wDimmerBackLight;
N119_DIMMER := wDimmerBackLight;

N120_LED_Bright := byDimmerBLink;
N121_LED_Bright := byDimmerBLink;

N102_BTIME := 10;
N103_BTIME := 10;
N104_BTIME := 10;
N105_BTIME := 10;
IF MAIN.fbWB.Pause THEN
	N106_BTIME := 100;
	N107_BTIME := 100;
ELSE
	N106_BTIME := 10;
	N107_BTIME := 10;
END_IF
N108_BTIME := 10;
N109_BTIME := 10;
N110_BTIME := 10;
N111_BTIME := 10;
N112_BTIME := 10;
N113_BTIME := 10;
N114_BTIME := 10;
N115_BTIME := 10;
N116_BTIME := 10;
N117_BTIME := 10;
N118_BTIME := 10;
N119_BTIME := 10;

(*FRO TACK*)
N102_BLINK.2 := MAIN.fbSE301.OUT_CylIn;
N102_BLINK.3 := MAIN.fbSE301.OUT_CylOut;
N113_BLINK.3 := MAIN.fbSE301.OUT_CylIn;
N113_BLINK.2 := MAIN.fbSE301.OUT_CylOut;
(*A3 TACK*)
N102_BLINK.4 := MAIN.fbSE303.OUT_CylIn;
N102_BLINK.5 := MAIN.fbSE303.OUT_CylOut;
N113_BLINK.5 := MAIN.fbSE303.OUT_CylIn;
N113_BLINK.4 := MAIN.fbSE303.OUT_CylOut;
(*J5*)
N118_BLINK.6 := MAIN.fbSE305.OUT_CylIn;
N118_BLINK.7 := MAIN.fbSE305.OUT_CylOut;
N119_BLINK.7 := MAIN.fbSE305.OUT_CylIn;
N119_BLINK.6 := MAIN.fbSE305.OUT_CylOut;
(*J4*)
N118_BLINK.8 := MAIN.fbSE307.OUT_CylIn;
N118_BLINK.9 := MAIN.fbSE307.OUT_CylOut;
N119_BLINK.9 := MAIN.fbSE307.OUT_CylIn;
N119_BLINK.8 := MAIN.fbSE307.OUT_CylOut;
(*FORESTAY*)
N104_BLINK.1 := MAIN.fbSE309.OUT_CylIn;
N104_BLINK.0 := MAIN.fbSE309.OUT_CylOut;
N105_BLINK.0 := MAIN.fbSE309.OUT_CylIn;
N105_BLINK.1 := MAIN.fbSE309.OUT_CylOut;
(*J2*)
N114_BLINK.4 := MAIN.fbSE311.OUT_CylIn;
