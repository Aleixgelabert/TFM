	ELSE
		N21_EVP3_CH1_2 := EVP709.mA := 0;
	END_IF

	N21_DO1_CH2_2 := EV701;
	N21_DO0_CH2_4 := EV702;
	N21_DO5_CH4_2 := EV703;
	N21_DO4_CH4_4 := EV704;

	N22_DO3_CH1_2 := EV709;
	N22_DO2_CH1_4 := EV710;
	N22_DO1_CH2_2 := EV707;
	N22_DO0_CH2_4 := EV708;
	N22_DO7_CH3_2 := EV705;
	N22_DO6_CH3_4 := EV706;

(*Node23 - MF08*)
	N23_DO3_CH1_2 := EV803;
	N23_DO2_CH1_4 := EV804;
	N23_DO1_CH2_2 := EV801;
	N23_DO0_CH2_4 := EV802;

(*Node26 - MF25*)
	N26_DO3_CH1_2 := EV2502;
	N26_DO2_CH1_4 := EV2504;
	N26_DO1_CH2_2 := EV2501;
	N26_DO0_CH2_4 := EV2503;
	N26_DO7_CH3_2 := EV2506;
	N26_DO6_CH3_4 := EV2508;
	N26_DO5_CH4_2 := EV2505;
	N26_DO4_CH4_4 := EV2507;

(*Node27 - MF22*)
	N27_DO3_CH1_2 := EV2211;
