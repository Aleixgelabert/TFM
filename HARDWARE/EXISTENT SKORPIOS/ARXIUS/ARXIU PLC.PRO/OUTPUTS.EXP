
(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM OUTPUTS
VAR CONSTANT
	BUF_SIZE : WORD := 4095;
	MAX_PSX  : INT  := 1000; (*100*10*)
END_VAR
VAR
	PSX50 : FB_PSX_VALVE;
	PSX51 : FB_PSX_VALVE;
	PSX52 : FB_PSX_VALVE;
	PSX53 : FB_PSX_VALVE;
	PSX54 : FB_PSX_VALVE;
	PSX55 : FB_PSX_VALVE;
	PSX56 : FB_PSX_VALVE;
	PSX57 : FB_PSX_VALVE;
	PSX58 : FB_PSX_VALVE;
	PSX59 : FB_PSX_VALVE;

	PSX60 : FB_PSX_VALVE;
	PSX61 : FB_PSX_VALVE;
	PSX64 : FB_PSX_VALVE;

	PSX70 : FB_PSX_VALVE;
	PSX71 : FB_PSX_VALVE;
	PSX72 : FB_PSX_VALVE;
	PSX73 : FB_PSX_VALVE;
	PSX74 : FB_PSX_VALVE;

	tsTime    :TIMESTRUCT;
	sDate     :STRING;
	sLocal    :STRING;
	sDaySec   :STRING;


	SIMob      : FB_SMART_INPUT;
	SIDimmerUp : FB_SMART_INPUT;
	SIDimmerDw : FB_SMART_INPUT;

	wDimmerBackLight : WORD;
	byDimmerLedBar   : BYTE;
	byDimmerDeckLink : BYTE;
	byDimmerBLink    : BYTE;
	byDimmerState    : BYTE;

	(*Mob : BOOL;*)

	sValue : STRING;

	engCnt : REAL;

	(*UDP Stream*)
	fbUdpSend        : FB_UDP_SEND;
	fbSocketCloseAll : FB_SocketCloseAll;
    bCloseAll 	     : BOOL := TRUE;

	aBuffer : ARRAY[0..BUF_SIZE] OF BYTE;
	wBufPos : DWORD;

	i   : INT;
	chk : BYTE;
	(*Bobstay_Ignore : BOOL;*)


	fbResetCan1 : IOF_DeviceReset;
	fbResetCan2 : IOF_DeviceReset;
	fbResetCan3 : IOF_DeviceReset;
	fbResetCan4 : IOF_DeviceReset;
	fbResetCan5 : IOF_DeviceReset;

	ResetCan1 : BOOL;
	ResetCan2 : BOOL;
	ResetCan3 : BOOL;
	ResetCan4 : BOOL;
	ResetCan5 : BOOL;

	W_CAN_PWR : BOOL := TRUE;
	W_CAN_CNT : REAL := 20.0;

END_VAR
VAR PERSISTENT
	Dimmer_Panels   AT %Q*: WORD;
	Dimmer_LedBar   AT %Q*: WORD;
	Dimmer_DeckLink AT %Q*: WORD;

END_VAR
(* @END_DECLARATION := '0' *)
W_CAN_CNT := W_CAN_CNT + MAIN.Cycle_Time;
W_CAN_PWR := W_CAN_CNT > 20.0;

(*Node00-PLC*)
N0_DO1 := ALARMS.Buzzer;
(*N0_DO2 := Engine Stop*)
N0_DO3 := W_CAN_PWR;
N0_DO4 := ENGINE.Engine_ON;
(*N0_DO5 := Engine Ignition*)
(*N0_DO6 := Engine Start*)
N0_DO7 := KEY_PP1;
N0_DO8 := KEY_PP2;

N0_AO1 := REAL_TO_INT(THR_PP1 * 3276.7); (*0..10V*)
N0_AO2 := REAL_TO_INT(THR_PP2 * 3276.7); (*0..10V*)


IF NOT TANK.Enable OR ENGINE.Engine_STOP OR NOT MAIN.aSys_Enable[8] THEN

	IF engCnt > 5 THEN
		N0_DO2 := FALSE;
	ELSE
		engCnt := engCnt + MAIN.Cycle_Time;
	END_IF

ELSE
	N0_DO2 := TRUE;


END_IF

(***STERN Nodes***)
(*Node36/37 - TANK + GS + MF00 + PP *)
	N36_EVP3_CH1_2 := EVP001;
	N36_EVP2_CH1_4 := EVP002;

	N36_DO7_CH3_2 := EV1501;
	N36_DO6_CH3_4 := EV1502;

(*Node38 - LIGHT*)
	N38_DO3_CH1_2 := L_Red;
	N38_DO2_CH1_4 := L_Anchor;
	N38_DO1_CH2_2 := L_Steam;
	N38_DO0_CH2_4 := L_Deck;
	N38_DO7_CH3_2 := L_Nav;
(*	N38_DO6_CH3_4 := ;*)
	N38_DO5_CH4_2 := ENGINE.Engine_ON;
	N38_DO4_CH4_4 := ALARMS.Buzzer;

(*Node39 - MF10A - Keel*)
	N39_DO7_CH3_2 := EV1001;
	N39_DO6_CH3_4 := EV1003;
	N39_DO5_CH4_2 := EV1002;
	N39_DO4_CH4_4 := EV1004;

	N39_EVP3_CH1_2 := EVP1006;
	N39_EVP2_CH1_4 := EVP1008;
	N39_EVP1_CH2_2 := EVP1007;
	N39_EVP0_CH2_4 := EVP1009;

(*Node40 - MF10B - Keel*)
	N40_EVP3_CH1_2 := EVP1005.mA := REAL_TO_UINT(EVP1005.Bar * EVP1005.Cal_K + EVP1005.Cal_Off);
	N40_EVP2_CH1_4 := EVP1010.mA := REAL_TO_UINT(EVP1010.Bar * EVP1010.Cal_K + EVP1010.Cal_Off);

	N40_DO1_CH2_2 := EV1011;
	N40_DO0_CH2_4 := EV1012;

(*Node41 - MF05*)
	IF EVP513.Bar > 0 THEN
		N41_EVP3_CH1_2 := EVP513.mA := REAL_TO_UINT(EVP513.Bar * EVP513.Cal_K + EVP513.Cal_Off);
	ELSE
		N41_EVP3_CH1_2 := EVP513.mA := 0;
	END_IF

	N41_DO1_CH2_2 := EV501;
	N41_DO0_CH2_4 := EV502;
	N41_DO7_CH3_2 := EV503;
	N41_DO6_CH3_4 := EV504;
	N41_DO5_CH4_2 := EV505;
	N41_DO4_CH4_4 := EV506;
	N40_DO7_CH3_2 := EV507;
	N40_DO6_CH3_4 := EV508;

(*Node42 - MF01 EVC + PP*)
	N42_DO3_CH1_2 := EV107;
(*	N42_DO2_CH1_4 := *)
	N42_DO1_CH2_2 := EV105;
	N42_DO0_CH2_4 := EV106;
	N42_DO7_CH3_2 := EV103;
	N42_DO6_CH3_4 := EV104;
	N42_DO5_CH4_2 := EV101;
	N42_DO4_CH4_4 := EV102;

(*Node43 - MF03A*)
	N43_DO3_CH1_2 := EV311;
	N43_DO2_CH1_4 := EV312;
	N43_DO1_CH2_2 := EV309;
	N43_DO0_CH2_4 := EV310;
	N43_DO7_CH3_2 := EV307;
	N43_DO6_CH3_4 := EV308;

(*Node44 - MF03A*)
	IF EVP313.Bar > 0 THEN
		N44_EVP3_CH1_2 := EVP313.mA := REAL_TO_UINT(EVP313.Bar * EVP313.Cal_K + EVP313.Cal_Off);
	ELSE
		N44_EVP3_CH1_2 := EVP313.mA := 0;
	END_IF

	N44_DO1_CH2_2 := EV301;
	N44_DO0_CH2_4 := EV302;
	N44_DO7_CH3_2 := EV303;
	N44_DO6_CH3_4 := EV304;
	N44_DO5_CH4_2 := EV305;
	N44_DO4_CH4_4 := EV306;

(*Node48 - DGB Seal*)
	N48_DO3_CH1_2 := EV_SealP_V;
	N48_DO2_CH1_4 := EV_SealP_P;
	N48_DO1_CH2_2 := EV_SealS_V;
	N48_DO0_CH2_4 := EV_SealS_P;

(***STERN Nodes***)
(*Node20 - MF06*)
	N20_DO3_CH1_2 := EV601;
	N20_DO2_CH1_4 := EV602;
	N20_DO1_CH2_2 := EV603;
	N20_DO0_CH2_4 := EV604;
	N20_DO7_CH3_2 := EV605;
	N20_DO6_CH3_4 := EV606;
	N20_DO5_CH4_2 := EV607;
