	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2501 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2505 );

	(*DGB Seal - Node48*)
	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P_SealP );
	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P_SealS );


	(*Next State*)
	State := 210;

210: (*Save Sensors Buffer*)
	fbSaveList( bEnable:= TRUE, pBuffer:= ADR(aBuffer), wBufLen:= wBufPos );

	IF fbSaveList.bDone THEN
		State  := 220;
	END_IF

220: (*Create Parameters Buffer*)
	fbSaveList( bEnable:= FALSE );
	fbSaveList.sFilePath := '\Hard Disk\FTP\';
	fbSaveList.sFileName := 'Parameters';
	fbSaveList.sFileExt  := '.txt';
	fbSaveList.Backup    := TRUE;

	wBufPos := 0;

(*1-Engine*)
	F_WRITE_ENGINE_CFG    ( 'Engine'    , BUF_SIZE, ADR(aBuffer), wBufPos, stEngineCfg     );
	F_WRITE_POWERPACK_CFG ( 'Powerpack' , BUF_SIZE, ADR(aBuffer), wBufPos, stPowerpackCfg  );
	F_WRITE_PROPULSION_CFG( 'Propulsion', BUF_SIZE, ADR(aBuffer), wBufPos, stPropulsionCfg );

(*2- HP Fucntions*)
	F_WRITE_SE_CYLINDER_POS_CFG	( 'A3Tack', BUF_SIZE, ADR(aBuffer), wBufPos, stSE301Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'FrTack', BUF_SIZE, ADR(aBuffer), wBufPos, stSE303Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'J5'    , BUF_SIZE, ADR(aBuffer), wBufPos, stSE305Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'J4'    , BUF_SIZE, ADR(aBuffer), wBufPos, stSE307Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG ( 'Fsy'   , BUF_SIZE, ADR(aBuffer), wBufPos, stSE309Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'J2'    , BUF_SIZE, ADR(aBuffer), wBufPos, stSE311Cfg   );

	F_WRITE_SE_CYLINDER_CFG		( 'JibIO' , BUF_SIZE, ADR(aBuffer), wBufPos, stSE501Cfg   );
	F_WRITE_SE_CYLINDER_CFG		( 'JibUD' , BUF_SIZE, ADR(aBuffer), wBufPos, stSE503Cfg   );
	F_WRITE_SE_CYLINDER_CFG		( 'Vang'  , BUF_SIZE, ADR(aBuffer), wBufPos, stSE505Cfg   );

	F_WRITE_LIFT_PROP_CFG       ( 'PropUpDw', BUF_SIZE, ADR(aBuffer), wBufPos, stDE601Cfg );
	F_WRITE_DE_CYLINDER_POS_CFG	( 'TrimTab' , BUF_SIZE, ADR(aBuffer), wBufPos, stDE605Cfg );

	F_WRITE_SE_CYLINDER_CFG		( 'Inn'   , BUF_SIZE, ADR(aBuffer), wBufPos, stSE701Cfg   );
	F_WRITE_SE_CYLINDER_CFG		( 'Out'   , BUF_SIZE, ADR(aBuffer), wBufPos, stSE703Cfg   );
	F_WRITE_SE_CYLINDER_CFG		( 'Cunn'  , BUF_SIZE, ADR(aBuffer), wBufPos, stSE705Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'Runn'  , BUF_SIZE, ADR(aBuffer), wBufPos, stSE707Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'Chksy' , BUF_SIZE, ADR(aBuffer), wBufPos, stSE709Cfg   );

	F_WRITE_SE_CYLINDER_POS_CFG	( 'BsyP'  , BUF_SIZE, ADR(aBuffer), wBufPos, stSE901Cfg   );
	(*F_WRITE_SE_CYLINDER_POS_CFG	( 'BsyS'  , BUF_SIZE, ADR(aBuffer), wBufPos, stSE903Cfg   );*)

(*3- Water Ballast*)
	F_WRITE_WB_CFG        ( 'WB'        , BUF_SIZE, ADR(aBuffer), wBufPos, stWBCfg        );
	F_WRITE_WB_VALVESF_CFG( 'WBValves'  , BUF_SIZE, ADR(aBuffer), wBufPos, stWBValveSFCfg );
	F_WRITE_WB_VALVELS_CFG( 'WBValvesLS', BUF_SIZE, ADR(aBuffer), wBufPos, stWBValveLSCfg );

(*4- LP Functions*)
	F_WRITE_WINCHE_CFG ( 'W1202', BUF_SIZE, ADR(aBuffer), wBufPos, stW1202Cfg );
	F_WRITE_WINCHE_CFG ( 'W1204', BUF_SIZE, ADR(aBuffer), wBufPos, stW1204Cfg );
	F_WRITE_WINCHE_CFG ( 'W1206', BUF_SIZE, ADR(aBuffer), wBufPos, stW1206Cfg );
	F_WRITE_WINCHE_CFG ( 'W1208', BUF_SIZE, ADR(aBuffer), wBufPos, stW1208Cfg );
	F_WRITE_WINCHE_CFG ( 'W1210', BUF_SIZE, ADR(aBuffer), wBufPos, stW1210Cfg );
	F_WRITE_WINCHE_CFG ( 'W1212', BUF_SIZE, ADR(aBuffer), wBufPos, stW1212Cfg );
	F_WRITE_WINCHE_CFG ( 'W1214', BUF_SIZE, ADR(aBuffer), wBufPos, stW1214Cfg );
	F_WRITE_WINCHE_CFG ( 'W1602', BUF_SIZE, ADR(aBuffer), wBufPos, stW1602Cfg );
	F_WRITE_WINCHE_CFG ( 'W1604', BUF_SIZE, ADR(aBuffer), wBufPos, stW1604Cfg );

	F_ADD_STRINGX4_TO_BUFFER( S1:= 'WRAMP_Min', S2:='$t', S3:= REAL_TO_STRING( stWRampCfg.Spd_Min), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'WRAMP_Inc', S2:='$t', S3:= REAL_TO_STRING( stWRampCfg.Spd_Inc), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'WRAMP_Dec', S2:='$t', S3:= REAL_TO_STRING( stWRampCfg.Spd_Dec), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	F_WRITE_BOARD_CFG     ( 'Board'    , BUF_SIZE, ADR(aBuffer), wBufPos, stBoardCfg     );
	F_WRITE_KEEL_CFG      ( 'Keel'     , BUF_SIZE, ADR(aBuffer), wBufPos, stKeelCfg      );
	F_WRITE_TRAVELLER_CFG ( 'Traveller', BUF_SIZE, ADR(aBuffer), wBufPos, stTravellerCfg );

	F_WRITE_LP_FUNC_CFG ( 'BowThr'    , BUF_SIZE, ADR(aBuffer), wBufPos, stBowThrCfg     );
	F_WRITE_LP_FUNC_CFG ( 'BowThrUpDw', BUF_SIZE, ADR(aBuffer), wBufPos, stBowThrUpDwCfg );

	F_WRITE_TACK_VALVE_CFG ( 'TackValve', BUF_SIZE, ADR(aBuffer), wBufPos, stTackValveCfg );

	F_WRITE_MAST_SETUP_CFG ( 'MastSetup', BUF_SIZE, ADR(aBuffer), wBufPos, stMastSetup );


(*UDP Parameters*)
	F_ADD_STRING_TO_BUFFER  ( S1:= '$n#UDP Parameters:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPHost', S2:='$t', S3:= sUDPSendHost                   , S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPPort', S2:='$t', S3:= UDINT_TO_STRING( nUDPSendPort ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPTime', S2:='$t', S3:= UINT_TO_STRING ( nUDPSendTime ), S4:='$n$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPRecvPort', S2:='$t', S3:= UDINT_TO_STRING( nUDPRecvPort ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPAlarmsHost', S2:='$t', S3:= sUDPAlarmsHost                   , S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPAlarmsPort', S2:='$t', S3:= UDINT_TO_STRING( nUDPAlarmsPort ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	(*Next State*)
	State := 230;


230: (*Save PArameters Buffer*)
	fbSaveList( bEnable:= TRUE, pBuffer:= ADR(aBuffer), wBufLen:= wBufPos );

	IF fbSaveList.bDone THEN
		(*Loaded := FALSE;*)	(*No hace falta hacer el Reload despues de save.*)
								(*En CK las rampas las calulo siempre.*)
		State  := 300;
	END_IF


300: (*Calule coefficents*)
	F_CALC_ENGINE_COEF    ( Cycle:= MAIN.Cycle_Time, Cfg:= stEngineCfg     );
	F_CALC_PROPULSION_COEF(                          Cfg:= stPropulsionCfg );
	F_CALC_KEEL_COEF      (                          Cfg:= stKeelCfg       );

	(*Next State*)
	Loaded := TRUE;
	State  := 0;

END_CASE
END_PROGRAM
