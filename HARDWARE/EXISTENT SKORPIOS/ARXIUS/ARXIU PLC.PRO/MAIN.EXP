	LS := LS2409,
	P  := P2500,
	CFG:= PARAMS.stWBValveLSCfg,
	OUT_Open => EV2409,
	OUT_Close=> EV2411,
);

fbWB_N(
	Enable:= aHP_Enable[19] AND TANK.Enable AND aSys_Enable[2],
	Manual:= fbWB.Manual,
	LS := LS2501,
	P  := P2500,
	CFG:= PARAMS.stWBValveLSCfg,
	OUT_Open => EV2501,
	OUT_Close=> EV2503,
);
EV2502 := EV2503;
EV2504 := EV2501;

fbWB_I(
	Enable:= aHP_Enable[19] AND TANK.Enable AND aSys_Enable[2],
	Manual:= fbWB.Manual,
	LS := LS2505,
	P  := P2500,
	CFG:= PARAMS.stWBValveLSCfg,
	OUT_Open => EV2505,
	OUT_Close=> EV2507,
);
EV2506 := EV2507;
EV2508 := EV2505;

(*WINCHES*********************************************************************)
fbW1202(
	Enable:= aLP_Enable[4] AND TANK.Enable AND ENGINE.Pump_ON AND aSys_Enable[2],
	Ready := POWERPACK.WinchReady,(* AND ENGINE.Pump_ON,*)
	Perc  := POWERPACK.LP_Perc,

	IN_1    := INPUTS.B1202_1,
	IN_2    := INPUTS.B1202_2,
	IN_3    := INPUTS.B1202_G,

	P_A := P1202,
	P_B := P1203,
	CFG := PARAMS.stW1202Cfg,
	RAMP:= PARAMS.stWRampCfg,

	OUT_TWC => EVP1202_3,
);
fbW1204(
	Enable:= aLP_Enable[5] AND TANK.Enable AND ENGINE.Pump_ON AND aSys_Enable[2],
	Ready := POWERPACK.WinchReady,(* AND ENGINE.Pump_ON,*)
	Perc  := POWERPACK.LP_Perc,

	IN_1    := INPUTS.B1204_1,
	IN_2    := INPUTS.B1204_2,
	IN_3    := INPUTS.B1204_G,

	P_A := P1204,
	P_B := P1205,
	CFG := PARAMS.stW1204Cfg,
	RAMP:= PARAMS.stWRampCfg,

	OUT_TWC => EVP1204_5,
);
fbW1206(
	Enable:= aLP_Enable[6] AND TANK.Enable AND ENGINE.Pump_ON AND aSys_Enable[2],
