	fbSE303 : FB_SE_CYLINDER_POS;	(* 2*)
	fbSE305 : FB_SE_CYLINDER_POS;	(* 3*)
	fbSE307 : FB_SE_CYLINDER_POS;	(* 4*)
	fbSE309 : FB_SE_CYLINDER_POS;	(* 5*)
	fbSE311 : FB_SE_CYLINDER_POS;	(* 6*)

	fbSE501 : FB_DE_CYLINDER;		(* 7*)
	fbSE503 : FB_SE_CYLINDER;		(* 8*)
	fbSE505 : FB_SE_CYLINDER_QR;	(* 9*)

	fbDE601 : FB_LIFTING_PROPELLER;	(*10*)
	fbDE605 : FB_DE_CYLINDER_POS;	(*11*)

