	fbWB_SUD : FB_WB_VALVE_LS;
    fbWB_SAF : FB_WB_VALVE_LS;

	WB_Scoop_Link : BOOL;

	(*Winches*)
	fbW1202	: FB_WINCHE_V2;	(*4*)
	fbW1204	: FB_WINCHE_V2;	(*5*)
	fbW1206	: FB_WINCHE_V2; (*6*)
	fbW1208	: FB_WINCHE_V2;	(*7*)
	fbW1210	: FB_WINCHE_V2;	(*8*)
	fbW1212	: FB_WINCHE_V2;	(*9*)
	fbW1214	: FB_WINCHE_V2;	(*10*)

	fbBoard      : FB_BOARD;	(*11,12*)
	fbKeel       : FB_KEEL;		(*13,19*)

	fbW1602	: FB_WINCHE_V2;	(*14*)
	fbW1604	: FB_WINCHE_V2;	(*15*)

	fbTraveller : FB_TRAVELLER;		(*16*)

	fbBowThr     : FB_LP_FUNC_SF;	(*17*)
	fbBowThrUpDw : FB_LP_FUNC_SF;	(*18*)

	(*Extra functions*)
	fbTackValve : FB_TACK_VALVE;

	fbMastSetup : FB_MAST_SETUP;

	(*SYSTEM STATUS*)
	HMI_Enable : BOOL;
	HMI_ShutDw : BOOL;

	SIEnable : ARRAY[1..3] OF FB_SMART_INPUT;
	SIShutDw : ARRAY[1..3] OF FB_SMART_INPUT;

	SITankEnable   : FB_SMART_INPUT;
	SIEngineEnable : FB_SMART_INPUT;
	SIPropEnable   : FB_SMART_INPUT;
	SIPropUDEnable : FB_SMART_INPUT;

	EventEnable : EN_SMART_INPUT_STATE;
	EventShutDw : EN_SMART_INPUT_STATE;

	SysLabel : STRING;
	LoadLAbel: STRING;
	SysPass  : STRING;
	SysColor : DWORD;
	SysState : WORD := 0;
	SysDClick : BOOL;
	AutoOffCnt : REAL;

END_VAR
VAR PERSISTENT
	aHP_Enable  AT %Q*: ARRAY[1..32] OF BOOL;
	aLP_Enable  AT %Q*: ARRAY[1..32] OF BOOL;
	aWB_Enable  AT %Q*: ARRAY[1..32] OF BOOL;

	aSys_Enable AT %Q*: ARRAY[1..16] OF BOOL;
	(*
	1 - Tank
	2 - SysSail
	3 - SysProp
	4 - EnableHP1
	5 - EnableHP2
	6 - EnablePP1
	7 - EnablePP2
	8 - EngineEnable 
	9 - PropEnable   
	10 - Dimmer_ON
	...
	16 - TackValve
	*)

	Prop_UsedTime 	AT %Q* : REAL;
	W1202_USedTime	AT %Q* : REAL;
	W1204_USedTime	AT %Q* : REAL;
	W1206_USedTime	AT %Q* : REAL;
	W1208_USedTime	AT %Q* : REAL;
	W1210_USedTime	AT %Q* : REAL;
	W1212_USedTime	AT %Q* : REAL;
	W1214_USedTime	AT %Q* : REAL;
	W1602_USedTime	AT %Q* : REAL;
	W1604_USedTime	AT %Q* : REAL;

END_VAR
(* @END_DECLARATION := '0' *)
(*PARAMS;*)
INPUTS;
TANK;

(*SYSTEM STATE: ENABLED / PROP ONLY / DISABLE*)
SIEnable[1](In:= HMI_Enable,  T_Cont:= T#0ms, T_DClk:= T#0ms);
(*SIEnable[2](In:= N103_IN.0 ,  T_Cont:= T#0ms, T_DClk:= T#0ms);
SIEnable[3](In:= N108_IN.1 ,  T_Cont:= T#0ms, T_DClk:= T#0ms);*)
SIShutDw[1](In:= HMI_ShutDw,  T_Cont:= T#1000ms, T_DClk:= T#0ms);
(*SIShutDw[2](In:= N103_IN.1 ,  T_Cont:= T#1000ms, T_DClk:= T#500ms);
SIShutDw[3](In:= N108_IN.0 ,  T_Cont:= T#1000ms, T_DClk:= T#500ms);*)

SITankEnable  (T_Cont:= T#1000ms, T_DClk:=T#0ms);
SIEngineEnable(T_Cont:= T#1000ms, T_DClk:=T#0ms);
SIPropEnable  (T_Cont:= T#1000ms, T_DClk:=T#0ms);
SIPropUDEnable(T_Cont:= T#1000ms, T_DClk:=T#0ms);

IF    SIEnable[1].Event <> NONE THEN EventEnable := SIEnable[1].Event;
ELSIF SIEnable[2].Event <> NONE THEN EventEnable := SIEnable[2].Event;
ELSIF SIEnable[3].Event <> NONE THEN EventEnable := SIEnable[3].Event;
ELSE							     EventEnable := NONE;
END_IF

IF    SIShutDw[1].Event <> NONE THEN EventShutDw := SIShutDw[1].Event;
ELSIF SIShutDw[2].Event <> NONE THEN EventShutDw := SIShutDw[2].Event;
ELSIF SIShutDw[3].Event <> NONE THEN EventShutDw := SIShutDw[3].Event;
ELSE							     EventShutDw := NONE;
END_IF

CASE SysState OF

0:  (*DISABLED*)
	IF EventEnable = INIT_CONTINUOUS (*SysPass = '2005062'*) THEN
		aSys_Enable[2] := TRUE;
		aSys_Enable[3] := TRUE;

		SysState := 2;
	END_IF

	SysLabel := 'SYSTEM$nDISABLED';
	SysColor := 16#000000FF;

1: (*PROP ONLY*)
	IF EventShutDw = INIT_CONTINUOUS THEN
		aSys_Enable[2] := FALSE;
		aSys_Enable[3] := FALSE;
		SysState       := 0;

	ELSIF EventEnable = INIT_CONTINUOUS (*SysPass = '2005062'*) THEN
		aSys_Enable[2] := TRUE;
		aSys_Enable[3] := TRUE;
		SysState       := 2;

	END_IF

	SysLabel := 'ONLY$nPROPULSION';
	SysColor := 16#00000000;

2: (*ENABLE*)
	IF EventShutDw = INIT_CONTINUOUS OR AutoOffCnt > 2400 THEN
		aSys_Enable[2] := FALSE;
		aSys_Enable[3] := TRUE;
		SysPass        := '';
		SysState       := 1;
	END_IF

	SysLabel := 'SAILING$nENABLED';
	SysColor := 16#0000FF00;

END_CASE

IF SITankEnable.Event   = INIT_CONTINUOUS THEN aSys_Enable[1] := NOT aSys_Enable[1]; END_IF
IF SIEngineEnable.Event = INIT_CONTINUOUS THEN aSys_Enable[8] := NOT aSys_Enable[8]; END_IF
IF SIPropEnable.Event   = INIT_CONTINUOUS THEN aSys_Enable[9] := NOT aSys_Enable[9]; END_IF
IF SIPropUDEnable.Event = INIT_CONTINUOUS THEN aHP_Enable[10] := NOT aHP_Enable[10]; END_IF

(*Loadind Status*)
IF PARAMS.Loaded THEN
	LoadLabel := '';
ELSE
	LoadLabel := '(Loading...)';
END_IF


