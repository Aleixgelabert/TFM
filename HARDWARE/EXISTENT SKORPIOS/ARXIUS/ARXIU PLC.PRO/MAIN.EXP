	OUT_TWC => EVP1206_7,
);
fbW1208(
	Enable:= aLP_Enable[7] AND TANK.Enable AND ENGINE.Pump_ON AND aSys_Enable[2],
	Ready := POWERPACK.WinchReady,(* AND ENGINE.Pump_ON,*)
	Perc  := POWERPACK.LP_Perc,

