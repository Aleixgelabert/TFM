	RAMP:= PARAMS.stWRampCfg,

	OUT_TWC => EVP1208_9,
);
fbW1210(
	Enable:= aLP_Enable[8] AND TANK.Enable AND ENGINE.Pump_ON AND aSys_Enable[2],
	Ready := POWERPACK.WinchReady,(* AND ENGINE.Pump_ON,*)
	Perc  := POWERPACK.LP_Perc,

	IN_1    := INPUTS.B1210_1,
