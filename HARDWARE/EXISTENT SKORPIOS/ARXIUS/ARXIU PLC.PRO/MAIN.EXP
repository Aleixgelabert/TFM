	P_B := P1603,
	CFG := PARAMS.stW1602Cfg,
	RAMP:= PARAMS.stWRampCfg,

	OUT_TWC => EVP1602_3,
);
fbW1604(
	Enable:= aLP_Enable[15] AND TANK.Enable AND ENGINE.Pump_ON AND aSys_Enable[2],
	Ready := POWERPACK.WinchReady,(* AND ENGINE.Pump_ON,*)
	Perc  := POWERPACK.LP_Perc,

	IN_1    := INPUTS.B1604_1,
	IN_2    := INPUTS.B1604_2,
	IN_3    := INPUTS.B1604_G,

	P_A := P1604,
	P_B := P1605,
	CFG := PARAMS.stW1604Cfg,
	RAMP:= PARAMS.stWRampCfg,

	OUT_TWC => EVP1604_5,
);

fbTraveller(
	Enable := aLP_Enable[16] AND TANK.Enable AND aSys_Enable[2],
	Ready  := ENGINE.Pump_ON,
	Perc   := POWERPACK.LP_Perc,

	IN_A := INPUTS.BTravA,
	IN_B := INPUTS.BTravB,
	IN_T := INPUTS.BTravT,
	IN_D := INPUTS.BTravD,

	P_A :=  P1301,
	P_B :=  P1302,
	LS  := LS1303,
	CFG := PARAMS.stTravellerCfg,

	OUT_EVRA => EV1301,
	OUT_EVRB => EV1302,
	OUT_EVAB => EV1303,
	OUT_TWC  => EVP1606_7
);
EV905 := EV908 := fbTraveller.OUT_EVPA;
EV907 := EV906 := fbTraveller.OUT_EVPB;

fbBowThr(
	Enable:= aLP_Enable[17] AND TANK.Enable AND ENGINE.Pump_ON AND aSys_Enable[2],
	Ready := POWERPACK.WinchReady AND ENGINE.Pump_ON AND (SF404 OR NOT PARAMS.stBowThrUpDwCfg.SF2_Limit),
	Perc  := POWERPACK.LP_Perc,

	IN_1 := INPUTS.BBowThrP,
	IN_2 := INPUTS.BBowThrS,

	CFG := PARAMS.stBowThrCfg,

	OUT_TWC => EVP402_3,
);
fbBowThrUpDw(
	Enable:= aLP_Enable[18] AND TANK.Enable AND ENGINE.Pump_ON AND aSys_Enable[2],
	Ready := POWERPACK.WinchReady AND ENGINE.Pump_ON,
	Perc  := POWERPACK.LP_Perc,

	IN_1 := INPUTS.BBowThrU,
	IN_2 := INPUTS.BBowThrD,

	IN_SF1 := SF405,
	IN_SF2 := SF404,

	CFG := PARAMS.stBowThrUpDwCfg,

	OUT_TWC => EVP404_5,
);

fbTackValve(
	Enable := aSys_Enable[16] AND NOT SF000.Alarm.Alarm (*AND aSys_Enable[2]*),
	Clear  := ALARMS.Clear,

	Heel_Ready  := TOFARO.Recv_Live,
	Heel_Value  := TOFARO.rHeel,

	Port_Ready := N21_DI0_CH7_4,
	Port_Open  := N22_DI0_CH7_4,
	Port_Close := N22_DI1_CH7_2,

	Stbd_Ready := N21_DI1_CH7_2,
	Stbd_Open  := N22_DI6_CH8_4,
	Stbd_Close := N22_DI7_CH8_2,

	CFG := PARAMS.stTackValveCfg,

	OUT_Port_Open  => N36_DO5_CH4_2,
	OUT_Port_Close => N36_DO4_CH4_4,
	OUT_Stbd_Open  => N36_DO1_CH2_2,
	OUT_Stbd_Close => N36_DO0_CH2_4,

);

fbMastSetup(
	IN_MS  := N116_IN.0,
	IN_1th := N109_IN.2,
	IN_2th := N109_IN.4,
	IN_3th := N109_IN.3,
	IN_FH  := N109_IN.0,

	IN_HS := N117_IN.1,
	IN_A3 := N108_IN.0,
	IN_F0 := N108_IN.4,
	IN_J2 := N108_IN.2,
	IN_J4 := N108_IN.3,

	END_MS := N109_IN.5 OR N109_IN.6 OR N109_IN.7,
	END_HS := N108_IN.5 OR N108_IN.6 OR N108_IN.7,

	FSY_P   :=  P309,
	FSY_LS  := LS309,

	BDef_P  :=  P707,
	BDef_LS := LS707,

	TDef_P  :=  P709,
	TDef_LS := LS709,

	TABLE := PARAMS.stMastSetup,

	FSY_In  => fbSE309.IN_RemIn,
	FSY_Out => fbSE309.IN_RemOut,

	BDef_In  => fbSE707.IN_RemIn,
	BDef_Out => fbSE707.IN_RemOut,

	TDef_In  => fbSE709.IN_RemIn,
	TDef_Out => fbSE709.IN_RemOut
);

(*Cylinders*)
IF fbSE301.State <> 0
OR fbSE303.State <> 0
OR fbSE305.State <> 0
OR fbSE307.State <> 0
OR fbSE309.State <> 0
OR fbSE311.State <> 0

OR fbSE501.State <> 0
OR fbSE503.State <> 0
OR fbSE505.State <> 0

OR fbDE601.State <> 0
OR fbDE605.State <> 0

OR fbSE701.State <> 0
OR fbSE703.State <> 0
OR fbSE705.State <> 0
OR fbSE707.State <> 0
OR fbSE709.State <> 0

OR fbBSY.State_P <> 0
OR fbBSY.State_S <> 0
(*
OR fbSE901.State <> 0
OR fbSE903.State <> 0
*)
(*Water Ballast*)
OR fbWB.State <> 0
OR fbWB_A.State <> 0
OR fbWB_B.State <> 0
OR fbWB_C.State <> 0
OR fbWB_D.State <> 0
OR fbWB_E.State <> 0
OR fbWB_F.State <> 0
OR fbWB_G.State <> 0
OR fbWB_H.State <> 0
OR fbWB_I.State <> 0
OR fbWB_J.State <> 0
OR fbWB_K.State <> 0
OR fbWB_L.State <> 0
OR fbWB_M.State <> 0
OR fbWB_N.State <> 0
OR fbWB_R.State <> 0
OR fbWB_S.State <> 0
OR fbWB_PUD.State <> 0
OR fbWB_PAF.State <> 0
OR fbWB_SUD.State <> 0
OR fbWB_SAF.State <> 0

(*Winches*)
OR fbW1202.State <> 0
OR fbW1204.State <> 0
OR fbW1206.State <> 0
OR fbW1208.State <> 0
OR fbW1210.State <> 0
OR fbW1212.State <> 0
OR fbW1214.State <> 0

OR fbW1602.State <> 0
OR fbW1604.State <> 0

OR fbBoard.State       <> 0
OR fbKeel.State        <> 0
OR fbTraveller.State   <> 0

OR fbBowThr.State     <> 0
OR fbBowThrUpDw.State <> 0

OR NOT aSys_Enable[2]
THEN AutoOffCnt := 0.0;
ELSE AutoOffCnt := AutoOffCnt + Cycle_Time;
END_IF

POWERPACK;
ENGINE;
ALARMS;
OUTPUTS;
TOFARO;

IF ENGINE.fbPropulsion.MoveEV THEN Prop_UsedTime := Prop_UsedTime + Cycle_Time; END_IF

IF fbW1202.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1204.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1206.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1208.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1210.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1212.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1214.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1602.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1604.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF


(*Save Persistent Vars when power down*)
(*fbUPS();*)
END_PROGRAM
