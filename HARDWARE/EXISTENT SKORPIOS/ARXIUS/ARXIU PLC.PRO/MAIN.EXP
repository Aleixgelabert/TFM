(*	fbSE901 : FB_SE_CYLINDER_POS_FINE;	(*17*) (* Añadir tack y Fine, mejor hacer un unico FB FB_SE_FINE_CYLINDER_POS*)
	fbSE903 : FB_SE_CYLINDER_POS_FINE;	(*18*) (* Con 4 inputs para in Out 2 de ellos fine, y 2 inputs para el tack*)*)

	fbWB   : FB_WATERBALLAST;		(*19*)
	fbWB_A : FB_WB_VALVE;
	fbWB_B : FB_WB_VALVE_LS;
	fbWB_C : FB_WB_VALVE_LS;
	fbWB_D : FB_WB_VALVE;
	fbWB_E : FB_WB_VALVE;
	fbWB_F : FB_WB_VALVE;
	fbWB_G : FB_WB_VALVE;
	fbWB_H : FB_WB_VALVE;
	fbWB_I : FB_WB_VALVE_LS;
	fbWB_J : FB_WB_VALVE;
	fbWB_K : FB_WB_VALVE;
	fbWB_L : FB_WB_VALVE;
	fbWB_M : FB_WB_VALVE;
	fbWB_N : FB_WB_VALVE_LS;
	fbWB_R : FB_WB_VALVE_LS;
	fbWB_S : FB_WB_VALVE_LS;

	fbWB_PUD : FB_WB_VALVE_LS;
