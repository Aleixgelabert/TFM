	CFG := PARAMS.stW1212Cfg,
	RAMP:= PARAMS.stWRampCfg,

	OUT_TWC => EVP1212_3,
);
fbW1214(
	Enable:= aLP_Enable[10] AND TANK.Enable AND ENGINE.Pump_ON AND aSys_Enable[2],
	Ready := POWERPACK.WinchReady,(* AND ENGINE.Pump_ON,*)
	Perc  := POWERPACK.LP_Perc,

	IN_1    := INPUTS.B1214_1,
	IN_2    := INPUTS.B1214_2,
	IN_3    := INPUTS.B1214_G,

	P_A := P1214,
	P_B := P1215,
	CFG := PARAMS.stW1214Cfg,
	RAMP:= PARAMS.stWRampCfg,

	OUT_TWC => EVP1214_5,
);

fbBoard(
	Enable := aLP_Enable[11] AND TANK.Enable AND aSys_Enable[2],
	Ready  := ENGINE.Pump_ON,

	EngReady := ENGINE.Engine_ON AND NOT ENGINE.Propulion_ON,
	Latching := aLP_Enable[12],

	Keel_Pos := fbKeel.LS_Pos,
	Keel_Err := fbKeel.LS_Err,

	IN_P := INPUTS.BBoardP,
	IN_S := INPUTS.BBoardS,
	IN_C := INPUTS.BBoardC,

	PA_P := P802,
	PA_S := P804,
	PB_P := P1216,
	PB_S := P1219,

	LS_P := LS801,
	LS_S := LS803,

	SF_P := SF801,
	SF_S := SF803,

	CFG := PARAMS.stBoardCfg,

	OUT_TWC_P => EVP1216_7,
	OUT_TWC_S => EVP1218_9,

	OUT_EVB_P => EV801,
	OUT_EVB_S => EV803,

	OUT_EVT_P => EV802,
	OUT_EVT_S => EV804
);
EVP1218_9 := -EVP1218_9; (*Inverted rev 19*)

fbKeel(
	Enable := aLP_Enable[13] AND TANK.Enable AND aSys_Enable[2] AND (NOT SF1002.Alarm.Alarm OR fbKeel.BypassSF),
	Ready  := ENGINE.Pump_ON,

	EngReady := ENGINE.Engine_ON AND NOT ENGINE.Propulion_ON,
	Latching := aLP_Enable[19],

	AutoEase := aLP_Enable[20],

	IN_I := INPUTS.BKeelS,
	IN_O := INPUTS.BKeelP,
	IN_C := INPUTS.BKeelC,
	IN_F := INPUTS.BKeelF,
	IN_T := INPUTS.BKeelT,

	LS_BOARD_P := LS801,
	LS_BOARD_S := LS803,

	P_I :=  P1001,
	P_O :=  P1002,
	LS1 := LS1001,
	LS2 := LS1002,

	CFG := PARAMS.stKeelCfg,

	EV_Eng_PI => EV1001,
	EV_Eng_EI => EV1003,
	EV_Eng_PO => EV1002,
	EV_Eng_EO => EV1004,
	EV_PP_I  => EV1012,
	EV_PP_O  => EV1011,

(*	EVP_Eng_I : UINT;*)
(*	EVP_Eng_O : UINT;*)

	EVP_SE_I  => EVP1006,
	EVP_SE_O  => EVP1007,
	EVP_FE_I  => EVP1008,
	EVP_FE_O  => EVP1009,

	P_Fill  => EVP1005.Bar,
	P_Empty => EVP1010.Bar,

	EVP_Fill => EVP1220_1,

);


fbW1602(
	Enable:= aLP_Enable[14] AND TANK.Enable AND ENGINE.Pump_ON AND aSys_Enable[2],
	Ready := POWERPACK.WinchReady,(* AND ENGINE.Pump_ON,*)
	Perc  := POWERPACK.LP_Perc,

	IN_1    := INPUTS.B1602_1,
	IN_2    := INPUTS.B1602_2,
	IN_3    := INPUTS.B1602_G,

