BBoardS[1] := MAIN.fbMastSetup.State_MS = 0 AND N108_IN.7;
BBoardC[1] := MAIN.fbMastSetup.State_MS = 0 AND N108_IN.5;

BBoardP[2] := MAIN.fbMastSetup.State_HS = 0 AND N109_IN.6;
BBoardS[2] := MAIN.fbMastSetup.State_HS = 0 AND N109_IN.7;
BBoardC[2] := MAIN.fbMastSetup.State_HS = 0 AND N109_IN.5;

