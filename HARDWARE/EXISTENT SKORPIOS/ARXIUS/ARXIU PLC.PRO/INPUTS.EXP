B306[2] := N119_IN.6;
(*J4*)
B307[1] := N118_IN.8;
B308[1] := N118_IN.9;
B307[2] := N119_IN.9;
B308[2] := N119_IN.8;
(*FORESTAY*)
B309[1] := N104_IN.1;
B310[1] := N104_IN.0;
