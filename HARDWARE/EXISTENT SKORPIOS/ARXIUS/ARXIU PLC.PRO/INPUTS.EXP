BWB_S_Aft[2] := N107_IN.3;
BWB_Fill [2] := N107_IN.4;
BWB_Dump [2] := N107_IN.5;
BWB_Stop [2] := N107_IN.7;
BWB_12   [2] := N107_IN.8;
BWB_Move [2] := N107_IN.9;

(*Ligths*)
L_Red_Trig   ( CLK:= N103_IN.0 );
L_Anchor_Trig( CLK:= N103_IN.1 );
L_Steam_Trig ( CLK:= N103_IN.2 );
L_Deck_Trig  ( CLK:= N103_IN.3 );
L_Nav_Trig   ( CLK:= N103_IN.4 );

L_HMI_Red_Trig   ( );
L_HMI_Anchor_Trig( );
L_HMI_Steam_Trig ( );
L_HMI_Deck_Trig  ( );
L_HMI_Nav_Trig   ( );

L_Red    := L_Red_Trig.CLK    OR L_HMI_Red_Trig.CLK;
L_Anchor := L_Anchor_Trig.CLK OR L_HMI_Anchor_Trig.CLK;
L_Steam  := L_Steam_Trig.CLK  OR L_HMI_Steam_Trig.CLK;
L_Deck   := L_Deck_Trig.CLK   OR L_HMI_Deck_Trig.CLK;
L_Nav    := L_Nav_Trig.CLK    OR L_HMI_Nav_Trig.CLK;

Override_Trig( CLK:= N117_IN.1 );
RemPort_Trig ( CLK:= N105_IN.4 );
RemStbd_Trig ( CLK:= N104_IN.5 );
RemOff_Trig  ( CLK:= N20_DI0 OR N20_DI1 OR N20_DI3 OR N20_DI4);

IF Override_Trig.Q THEN
	Override_ON := NOT Override_ON;
END_IF

IF RemPort_Trig.Q THEN
	RemPort_ON := NOT RemPort_ON;
END_IF

IF RemStbd_Trig.Q THEN
	RemStbd_ON := NOT RemStbd_ON;
END_IF

IF RemOff_Trig.Q THEN
	RemPort_ON := FALSE;
	RemStbd_ON := FALSE;
END_IF

(*W1202 - Prim Stbd*)
IF NOT RemStbd_ON THEN
	B1202_1[1] := N10_DI0;
	B1202_2[1] := N10_DI1;
ELSE
	B1202_1[1] := FALSE;
	B1202_2[1] := FALSE;
END_IF

B1202_G    := N10_DI2;
B1202_1[4] := N120_IN.3;
B1202_2[4] := N120_IN.8;

(* W1204 - Pit Stbd*)
B1204_1[1] := N10_DI6;
B1204_2[1] := N10_DI7;
B1204_G    := FALSE;
B1204_1[4] := N120_IN.1;
B1204_2[4] := N120_IN.6;

(*W1206 - MAIN*)
B1206_1[1] := N20_DI0;
B1206_2[1] := N20_DI1;
B1206_G    := N20_DI2;
B1206_1[2] := N20_DI3;
B1206_2[2] := N20_DI4;
B1206_1[4] := N120_IN.0;
B1206_2[4] := N120_IN.5;

IF RemStbd_ON AND RemPOrt_ON THEN
	B1206_1[3] := N10_DI0 OR N11_DI0;
	B1206_2[3] := N10_DI1 OR N11_DI1;
ELSIF RemStbd_ON THEN
	B1206_1[3] := N10_DI0;
	B1206_2[3] := N10_DI1;
ELSIF RemPort_ON THEN
	B1206_1[3] := N11_DI0;
	B1206_2[3] := N11_DI1;
ELSE
	B1206_1[3] := FALSE;
	B1206_2[3] := FALSE;
END_IF

(*W1208 - Runn Port*)
B1208_1[1] := N13_DI0;
B1208_2[1] := N13_DI1;
B1208_G    := N13_DI2;
B1208_1[4] := N121_IN.0;
B1208_2[4] := N121_IN.4;

(*W1210 - Prim Port*)
IF NOT RemPort_ON THEN
	B1210_1[1] := N11_DI0;
	B1210_2[1] := N11_DI1;
ELSE
	B1210_1[1] := FALSE;
	B1210_2[1] := FALSE;
END_IF

B1210_G    := N11_DI2;
B1210_1[4] := N121_IN.1;
B1210_2[4] := N121_IN.5;

(*W1212 - Sec Port*)
B1212_1[1] := N11_DI3;
