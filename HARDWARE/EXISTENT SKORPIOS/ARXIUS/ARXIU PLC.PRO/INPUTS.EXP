(*
tsTime  := fbLocalTime.systemTime;
sDate   := DWORD_TO_STRING( tsTime.wYear * 10000 + tsTime.wMonth * 100 + tsTime.wDay );
sLocal  := REAL_TO_STRING ( tsTime.wHour * 10000.0 + tsTime.wMinute * 100.0 + tsTime.wSecond + tsTime.wMilliseconds / 1000.0 );
sDaySec := REAL_TO_STRING ( tsTime.wHour * 3600.0  + tsTime.wMinute * 60.0  + tsTime.wSecond + tsTime.wMilliseconds / 1000.0 );
*)

