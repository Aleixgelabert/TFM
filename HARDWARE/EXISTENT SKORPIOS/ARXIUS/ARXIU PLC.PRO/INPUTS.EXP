BTravB[1] := N116_IN.2;
BTravT[1] := N116_IN.1;
BTravD[1] := N116_IN.1 AND N116_IN.0;

BTravA[2] := N117_IN.3;
BTravB[2] := N117_IN.2;
BTravT[2] := N117_IN.0;
BTravD[2] := N117_IN.0 AND N117_IN.1;

BTravA[3] := N38_DI0_CH7_4; (******************************Verificar cual es Port y Stbd***)
BTravB[3] := N38_DI1_CH7_2;

(*KEEL*)
BKeelP[1] := N110_IN.0;
BKeelS[1] := N110_IN.4;
BKeelC[1] := N110_IN.3;
BKeelF[1] := N110_IN.2;
BKeelT[1] := N110_IN.5;

