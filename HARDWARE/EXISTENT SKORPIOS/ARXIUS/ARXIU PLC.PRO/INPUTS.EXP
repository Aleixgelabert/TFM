Outhaul		=  6500 kg or 450 bar
Vang 		= 19500 kg or 450 bar
JibInOut	=  5500 kg or 470 bar
JibUpDw		=  5000 kg or 440 bar
*)

(* @END_DECLARATION := '0' *)
(*Node00 - PLC*)
Prop_DynRPM( CNT:= N0_CNT1, CycleTime:= 20, MaxWidth:= 500, Accuracy:= 20 );

IF PARAMS.stPropulsionCfg.PropRPM_K > 0
THEN Prop_RPM := Prop_DynRPM.RPM / PARAMS.stPropulsionCfg.PropRPM_K;
ELSE Prop_RPM := Prop_DynRPM.RPM;
END_IF

THR1_Prop_V( IN:= N0_AI1 / 3276.7 );
THR2_Prop_V( IN:= N0_AI2 / 3276.7 );

THR_Prop_Fwd := N0_DI2;
THR_Prop_Rev := N0_DI3;
THR_Prop_Chk := THR1_Prop_V.AVG + THR2_Prop_V.AVG;
THR_Prop_Err := N0_AI1_Err OR THR1_Prop_V.AVG < 0.5 OR THR1_Prop_V.AVG > 4.5
			 OR N0_AI2_Err OR THR2_Prop_V.AVG < 0.5 OR THR2_Prop_V.AVG > 4.5
			 OR THR_Prop_Chk > 5.5 OR THR_Prop_Chk < 4.5;

IF THR_Prop_Fwd THEN
	THR_Prop := THR1_Prop_V.AVG;

ELSIF THR_Prop_Rev THEN
	THR_Prop := -THR1_Prop_V.AVG;

ELSE
	THR_Prop := 0.0;

END_IF

IF ALARMS.Clear THEN
	THR_Alarm.Alarm := FALSE;
	THR_Alarm.Adver := FALSE;
	THR_Alarm.AlCnt := 0;
	THR_Alarm.AlLen := 0.0;

END_IF

IF THR_Prop_Err THEN
	IF NOT THR_Alarm.Alarm THEN
		THR_Alarm.AlCnt  := THR_Alarm.AlCnt + 1;
		THR_Alarm.AlLen  := 0.0;
		THR_Alarm.TimeInit := INPUTS.sLocal;
		THR_Alarm.AlInit   := TRUE;

		THR_Alarm.Text   := 'Propulsion Throttle Error.';

	ELSE
		THR_Alarm.AlLen  := THR_Alarm.AlLen + MAIN.Cycle_Time;

	END_IF

	THR_Alarm.Adver := TRUE;
	THR_Alarm.Alarm := TRUE;

ELSE
	IF THR_Alarm.Alarm THEN
		THR_Alarm.TimeEnd := INPUTS.sLocal;
		THR_Alarm.AlEnd   := TRUE;

	END_IF

	THR_Alarm.Alarm := FALSE;

END_IF

(*SF000 := N0_DI1;*)
F_CALC_SENSOR_NC ( N0_DI1, ALARMS.Clear, MAIN.Cycle_Time, 0.0, SF000 );

