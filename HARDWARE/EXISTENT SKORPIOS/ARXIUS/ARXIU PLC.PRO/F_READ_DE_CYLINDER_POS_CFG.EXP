
(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN\/PARAMETERS' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_READ_DE_CYLINDER_POS_CFG : BOOL
VAR_INPUT
	sHead : STRING;
	rTime : REAL;
END_VAR
VAR_IN_OUT
	stConfig : ST_DE_CYLINDER_POS_CFG;
	fbIdList : FB_IDLIST;
END_VAR
(* @END_DECLARATION := '0' *)

stConfig.TgtLS_In  := F_IDLIST_GETREAL( CONCAT(sHead, '_TgtLS_In'  ), fbIdList );
stConfig.TgtLS_Out := F_IDLIST_GETREAL( CONCAT(sHead, '_TgtLS_Out' ), fbIdList );
stConfig.TgtLS_Mid := F_IDLIST_GETREAL( CONCAT(sHead, '_TgtLS_Mid' ), fbIdList );
stConfig.TgtLS_DB  := F_IDLIST_GETREAL( CONCAT(sHead, '_TgtLS_DB'  ), fbIdList );

stConfig.TimeMax  := F_IDLIST_GETREAL( CONCAT(sHead, '_TimeMax'  ), fbIdList );
stConfig.Cycle    := rTime;

stConfig.LS_Limit_In  := F_IDLIST_GETBOOL( CONCAT(sHead, '_LS_Limit_In'  ), fbIdList );
stConfig.LS_Limit_Out := F_IDLIST_GETBOOL( CONCAT(sHead, '_LS_Limit_Out' ), fbIdList );

stConfig.HP  := F_IDLIST_GETBYTE( CONCAT(sHead, '_HP'  ), fbIdList );

END_FUNCTION
