F_ADD_STRINGX4_TO_BUFFER( S1:= CONCAT(sHead, '_Spd31' ), S2:='$t', S3:= REAL_TO_STRING( stConfig.Spd3[1] ), S4:='$n', wSize := wSize, pBuffer := pBuffer, wPos := wPos );

F_ADD_STRINGX4_TO_BUFFER( S1:= CONCAT(sHead, '_Spd17' ), S2:='$t', S3:= REAL_TO_STRING( stConfig.Spd1[7] ), S4:='$n', wSize := wSize, pBuffer := pBuffer, wPos := wPos );
F_ADD_STRINGX4_TO_BUFFER( S1:= CONCAT(sHead, '_Spd27' ), S2:='$t', S3:= REAL_TO_STRING( stConfig.Spd2[7] ), S4:='$n', wSize := wSize, pBuffer := pBuffer, wPos := wPos );
F_ADD_STRINGX4_TO_BUFFER( S1:= CONCAT(sHead, '_Spd37' ), S2:='$t', S3:= REAL_TO_STRING( stConfig.Spd3[7] ), S4:='$n', wSize := wSize, pBuffer := pBuffer, wPos := wPos );

F_ADD_STRINGX4_TO_BUFFER( S1:= CONCAT(sHead, '_P1_Max' ), S2:='$t', S3:= REAL_TO_STRING( stConfig.P1_Max ), S4:='$n', wSize := wSize, pBuffer := pBuffer, wPos := wPos );
F_ADD_STRINGX4_TO_BUFFER( S1:= CONCAT(sHead, '_P2_Max' ), S2:='$t', S3:= REAL_TO_STRING( stConfig.P2_Max ), S4:='$n', wSize := wSize, pBuffer := pBuffer, wPos := wPos );
F_ADD_STRINGX4_TO_BUFFER( S1:= CONCAT(sHead, '_P3_Max' ), S2:='$t', S3:= REAL_TO_STRING( stConfig.P3_Max ), S4:='$n', wSize := wSize, pBuffer := pBuffer, wPos := wPos );

F_ADD_STRINGX4_TO_BUFFER( S1:= CONCAT(sHead, '_A_Spd1' ), S2:='$t', S3:= BOOL_TO_STRING( stConfig.A_Spd1 ), S4:='$n', wSize := wSize, pBuffer := pBuffer, wPos := wPos );

F_ADD_STRINGX4_TO_BUFFER( S1:= CONCAT(sHead, '_TimeMax' ), S2:='$t', S3:= REAL_TO_STRING( stConfig.TimeMax ), S4:='$n', wSize := wSize, pBuffer := pBuffer, wPos := wPos );

(*F_ADD_STRINGX4_TO_BUFFER( S1:= CONCAT(sHead, '_PP'  ), S2:='$t', S3:= BYTE_TO_STRING( stConfig.PP ), S4:='$n', wSize := wSize, pBuffer := pBuffer, wPos := wPos );*)

(*Calc Values*)

aux1 := (stConfig.Spd1[7]-stConfig.Spd1[1])/6.0;
aux2 := (stConfig.Spd2[7]-stConfig.Spd2[1])/6.0;
aux3 := (stConfig.Spd3[7]-stConfig.Spd3[1])/6.0;

stConfig.Spd1[2] := stConfig.Spd1[1] + Aux1;
stConfig.Spd1[3] := stConfig.Spd1[2] + Aux1;
stConfig.Spd1[4] := stConfig.Spd1[3] + Aux1;
stConfig.Spd1[5] := stConfig.Spd1[4] + Aux1;
stConfig.Spd1[6] := stConfig.Spd1[5] + Aux1;

stConfig.Spd2[2] := stConfig.Spd2[1] + Aux2;
stConfig.Spd2[3] := stConfig.Spd2[2] + Aux2;
stConfig.Spd2[4] := stConfig.Spd2[3] + Aux2;
stConfig.Spd2[5] := stConfig.Spd2[4] + Aux2;
stConfig.Spd2[6] := stConfig.Spd2[5] + Aux2;

stConfig.Spd3[2] := stConfig.Spd3[1] + Aux3;
stConfig.Spd3[3] := stConfig.Spd3[2] + Aux3;
stConfig.Spd3[4] := stConfig.Spd3[3] + Aux3;
stConfig.Spd3[5] := stConfig.Spd3[4] + Aux3;
stConfig.Spd3[6] := stConfig.Spd3[5] + Aux3;

END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_CALC_CAN_NODESTATE : BOOL
VAR_INPUT
	State : USINT;
	Clear : BOOL;
END_VAR
VAR_IN_OUT
	Node : ST_CAN_NODESTATE;
END_VAR

(* @END_DECLARATION := '0' *)
IF Clear THEN
	Node.Alarm.Alarm := FALSE;
	Node.Alarm.Adver := FALSE;
	Node.Alarm.AlCnt := 0;
	Node.Alarm.AlLen := 0.0;
END_IF

IF State <> 0 AND State <> 23 THEN
	IF NOT Node.Alarm.Alarm THEN
		Node.Alarm.AlCnt  := Node.Alarm.AlCnt + 1;
		Node.Alarm.AlLen  := 0.0;
		Node.Alarm.TimeInit := INPUTS.sLocal;
		Node.Alarm.AlInit   := TRUE;

	ELSE
		Node.Alarm.AlLen  := Node.Alarm.AlLen + MAIN.Cycle_Time;

	END_IF

	Node.Alarm.Adver := TRUE;
	Node.Alarm.Alarm := TRUE;

	Node.Alarm.Text  := CONCAT( Node.Desc  , ' error ' );
	Node.Alarm.Text  := CONCAT( Node.Alarm.Text  , USINT_TO_STRING(State) );

ELSE
	IF Node.Alarm.Alarm THEN
		Node.Alarm.TimeEnd := INPUTS.sLocal;
		Node.Alarm.AlEnd   := TRUE;

	END_IF

	Node.Alarm.Alarm := FALSE;
END_IF

END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_CALC_CAN_STATE : BOOL
VAR_INPUT
	State : UINT;
	Clear : BOOL;
END_VAR
VAR_IN_OUT
	Node : ST_CAN_NODESTATE;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)
IF Clear THEN
	Node.Alarm.Alarm := FALSE;
	Node.Alarm.Adver := FALSE;
	Node.Alarm.AlCnt := 0;
	Node.Alarm.AlLen := 0.0;
END_IF

IF State <> 0 THEN
	IF NOT Node.Alarm.Alarm THEN
		Node.Alarm.AlCnt  := Node.Alarm.AlCnt + 1;
		Node.Alarm.AlLen  := 0.0;
		Node.Alarm.TimeInit := INPUTS.sLocal;
		Node.Alarm.AlInit   := TRUE;

	ELSE
		Node.Alarm.AlLen  := Node.Alarm.AlLen + MAIN.Cycle_Time;

	END_IF

	Node.Alarm.Adver := TRUE;
	Node.Alarm.Alarm := TRUE;

	Node.Alarm.Text  := CONCAT( Node.Desc  , ' error ' );
	Node.Alarm.Text  := CONCAT( Node.Alarm.Text  , UINT_TO_STRING(State) );

ELSE
	IF Node.Alarm.Alarm THEN
		Node.Alarm.TimeEnd := INPUTS.sLocal;
		Node.Alarm.AlEnd   := TRUE;

	END_IF

	Node.Alarm.Alarm := FALSE;
END_IF

END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_CALC_ENGINE_COEF : BOOL
VAR_INPUT
	Cycle : REAL;
END_VAR
VAR_IN_OUT
	Cfg : ST_ENGINE_CFG;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)
Cfg.CycleMaxInc_RPM := Cfg.MaxInc_RPM * Cycle;
Cfg.CycleMaxDec_RPM := Cfg.MaxDec_RPM * Cycle;

IF Cfg.Max_RPM <> 0.0 THEN
	Cfg.Boost_K := Cfg.Boost_RPM / Cfg.Max_RPM;
END_IF

IF Cfg.Max_Torque > Cfg.Min_Torque THEN
	Cfg.Inc_RMP_Perc_WOP_K := Cfg.Inc_RMP_Perc_WOP / (100.0*(Cfg.Max_Torque - Cfg.Min_Torque));
	Cfg.Dec_Flow_Perc_WP_K := Cfg.Dec_Flow_Perc_WP / (100.0*(Cfg.Max_Torque - Cfg.Min_Torque));
END_IF
END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_CALC_KEEL_COEF : BOOL
VAR_INPUT
END_VAR
VAR_IN_OUT
	Cfg : ST_KEEL_CFG;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)
IF CFG.EVP_Out_Eng_Max <> CFG.EVP_Out_Eng_Min THEN
	CFG.EVP_Out_Fill_K   := (CFG.EVP_Out_Fill_Max - CFG.EVP_Out_Fill_Min) / (CFG.EVP_Out_Eng_Max - CFG.EVP_Out_Eng_Min);
    CFG.EVP_Out_Fill_Off := CFG.EVP_Out_Fill_Min - CFG.EVP_Out_Eng_Min * CFG.EVP_Out_Fill_K;

ELSE
	CFG.EVP_Out_Fill_K   := 0;
    CFG.EVP_Out_Fill_Off := 0;
END_IF

END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_CALC_PROPULSION_COEF : BOOL
VAR_IN_OUT
	Cfg : ST_PROPULSION_CFG;
END_VAR
VAR
	i : INT;
	d : REAL;

END_VAR
(* @END_DECLARATION := '0' *)
d := (Cfg.aThrt_V[4] - Cfg.aThrt_V[0]) / 4.0; (*REVERSE*)

Cfg.aThrt_V[1] := Cfg.aThrt_V[0] + d;
Cfg.aThrt_V[2] := Cfg.aThrt_V[1] + d;
Cfg.aThrt_V[3] := Cfg.aThrt_V[2] + d;

d := (Cfg.aThrt_V[10] - Cfg.aThrt_V[6]) / 4.0; (*FORWARD*)

Cfg.aThrt_V[7] := Cfg.aThrt_V[6] + d;
Cfg.aThrt_V[8] := Cfg.aThrt_V[7] + d;
Cfg.aThrt_V[9] := Cfg.aThrt_V[8] + d;

FOR i := 0 TO 9 BY 1 DO

	IF Cfg.aThrt_V[i+1] <> Cfg.aThrt_V[i] THEN

		Cfg.aEng_K[i] := (Cfg.aEng_RPM[i+1] - Cfg.aEng_RPM[i]) / (Cfg.aThrt_V[i+1] - Cfg.aThrt_V[i]);
		Cfg.aEVP_K[i] := (Cfg.aEVP_mA [i+1] - Cfg.aEVP_mA [i]) / (Cfg.aThrt_V[i+1] - Cfg.aThrt_V[i]);

		Cfg.aEng_Off[i] := Cfg.aEng_RPM[i] - Cfg.aThrt_V[i] * Cfg.aEng_K[i];
		Cfg.aEVP_Off[i] := Cfg.aEVP_mA [i] - Cfg.aThrt_V[i] * Cfg.aEVP_K[i];

	ELSE

		Cfg.aEng_K[i] := 0.0;
		Cfg.aEVP_K[i] := 0.0;

		Cfg.aEng_Off[i] := 0.0;
		Cfg.aEVP_Off[i] := 0.0;

	END_IF

END_FOR

END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_CALC_SENSOR_BAR : BOOL
VAR_INPUT
	IN    : REAL;
	Clear : BOOL;
END_VAR
VAR_IN_OUT
	Sensor : ST_SENSOR_BAR;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)

(*AVG*)
IF Sensor.Avg_Pos > 4 THEN Sensor.Avg_Pos := 0; END_IF

Sensor.Avg_Sum := Sensor.Avg_Sum + IN - Sensor.Avg_Buf[Sensor.Avg_Pos];
Sensor.Avg_Buf[Sensor.Avg_Pos] := IN;
Sensor.Avg_Pos := Sensor.Avg_Pos + 1;

Sensor.Raw := Sensor.Avg_Sum / 5.0;
Sensor.Err := Sensor.Raw < Sensor.MinRaw OR Sensor.Raw > Sensor.MaxRaw;

(*CALIB*)
Sensor.Bar := Sensor.Raw * Sensor.Cal_K + Sensor.Cal_Off;

(*ALARM*)
IF Clear THEN
	Sensor.Alarm.Alarm := FALSE;
	Sensor.Alarm.Adver := FALSE;
	Sensor.Alarm.AlCnt := 0;
	Sensor.Alarm.AlLen := 0.0;
(*	Sensor.AdverVal    := Sensor.Bar;*) (*Lo reseteo *)

END_IF

IF Sensor.Err THEN
	IF NOT Sensor.Alarm.Alarm OR NOT Sensor.AlErr THEN
		Sensor.Alarm.AlCnt  := Sensor.Alarm.AlCnt + 1;
		Sensor.Alarm.AlLen  := 0.0;
		Sensor.Alarm.TimeInit := INPUTS.sLocal;
		Sensor.Alarm.AlInit   := TRUE;

		Sensor.Alarm.Text := CONCAT( Sensor.Desc, ' Press. Sensor Broken/Disconnected.' );

	ELSE
		Sensor.Alarm.AlLen  := Sensor.Alarm.AlLen + MAIN.Cycle_Time;

	END_IF

	Sensor.Alarm.Alarm := TRUE;
	Sensor.Alarm.Adver := TRUE;

	Sensor.AlErr    := TRUE;
	Sensor.AlMax    := FALSE;
	Sensor.AlMin    := FALSE;
	Sensor.AdverVal := 0.0;

ELSIF Sensor.MaxBar > 0 AND Sensor.Bar > Sensor.MaxBar THEN
	IF NOT Sensor.Alarm.Alarm OR NOT Sensor.AlMax THEN
		Sensor.Alarm.AlCnt  := Sensor.Alarm.AlCnt + 1;
		Sensor.Alarm.AlLen  := 0.0;
		Sensor.Alarm.TimeInit := INPUTS.sLocal;
		Sensor.Alarm.AlInit   := TRUE;

		Sensor.AdverVal     := Sensor.Bar;
	ELSE
		Sensor.Alarm.AlLen  := Sensor.Alarm.AlLen + MAIN.Cycle_Time;
	END_IF

	Sensor.Alarm.Alarm := TRUE;
	Sensor.Alarm.Adver := TRUE;

	Sensor.AlErr    := FALSE;
	Sensor.AlMax    := TRUE;
	Sensor.AlMin    := FALSE;
 	Sensor.AdverVal := MAX( Sensor.Bar, Sensor.AdverVal );

	Sensor.Alarm.Text := CONCAT( Sensor.Desc      , ' Overpressured: ' );
	Sensor.Alarm.Text := CONCAT( Sensor.Alarm.Text, REAL_TO_STRING(Sensor.AdverVal) );

ELSIF Sensor.MinBar > 0 AND Sensor.Bar < Sensor.MinBar THEN
	IF NOT Sensor.Alarm.Alarm OR NOT Sensor.AlMin THEN
		Sensor.Alarm.AlCnt  := Sensor.Alarm.AlCnt + 1;
		Sensor.Alarm.AlLen  := 0.0;
		Sensor.Alarm.TimeInit := INPUTS.sLocal;
		Sensor.Alarm.AlInit   := TRUE;

		Sensor.AdverVal     := Sensor.Bar;
	ELSE
		Sensor.Alarm.AlLen  := Sensor.Alarm.AlLen + MAIN.Cycle_Time;
	END_IF

	Sensor.Alarm.Alarm := TRUE;
	Sensor.Alarm.Adver := TRUE;

	Sensor.AlErr    := FALSE;
	Sensor.AlMax    := FALSE;
	Sensor.AlMin    := TRUE;
	Sensor.AdverVal := MIN( Sensor.Bar, Sensor.AdverVal );

	Sensor.Alarm.Text     := CONCAT( Sensor.Desc      , ' Underpressured: ' );
	Sensor.Alarm.Text     := CONCAT( Sensor.Alarm.Text, REAL_TO_STRING(Sensor.AdverVal) );

ELSE
	IF Sensor.Alarm.Alarm THEN
		Sensor.Alarm.TimeEnd := INPUTS.sLocal;
		Sensor.Alarm.AlEnd   := TRUE;

	END_IF

	Sensor.Alarm.Alarm := FALSE;
	Sensor.AlErr       := FALSE;
	Sensor.AlMax       := FALSE;
	Sensor.AlMin       := FALSE;

END_IF
END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_CALC_SENSOR_KG : BOOL
VAR_INPUT
	IN  : REAL;
END_VAR
VAR_IN_OUT
	Sensor : ST_SENSOR_KG;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)
Sensor.Raw := IN * Sensor.Cal_K;
Sensor.Kg  := Sensor.Raw * (Sensor.Cal_C / 100.0);

END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_CALC_SENSOR_NC : BOOL
VAR_INPUT
	IN    : BOOL;
	Clear : BOOL;
	Cycle : REAL;
	Delay : REAL;
END_VAR
VAR_IN_OUT
	Sensor : ST_SENSOR_SWITCH;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)
IF Clear THEN
	Sensor.Alarm.Alarm := FALSE;
	Sensor.Alarm.Adver := FALSE;
	Sensor.Alarm.AlCnt := 0;
	Sensor.Alarm.AlLen := 0.0;
END_IF

IF NOT IN THEN
	IF Sensor.Count >= Delay THEN
		IF NOT Sensor.Alarm.Alarm THEN
			Sensor.Alarm.AlCnt  := Sensor.Alarm.AlCnt + 1;
			Sensor.Alarm.AlLen  := 0.0;
			Sensor.Alarm.TimeInit := INPUTS.sLocal;
			Sensor.Alarm.AlInit   := TRUE;

			Sensor.Alarm.Text   := Sensor.Desc;

		ELSE
			Sensor.Alarm.AlLen  := Sensor.Alarm.AlLen + MAIN.Cycle_Time;

		END_IF

		Sensor.Alarm.Adver := TRUE;
		Sensor.Alarm.Alarm := TRUE;

	ELSE
		Sensor.Count := Sensor.Count + Cycle;

	END_IF

ELSE
	IF Sensor.Alarm.Alarm THEN
		Sensor.Alarm.TimeEnd := INPUTS.sLocal;
		Sensor.Alarm.AlEnd   := TRUE;

	END_IF

	Sensor.Alarm.Alarm := FALSE;
	Sensor.Count       := 0;
END_IF


END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_CALC_SENSOR_POS : BOOL
VAR_INPUT
	IN    : REAL;
	Clear : BOOL;
END_VAR
VAR_IN_OUT
	Sensor : ST_SENSOR_POS;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)

(*AVG*)
IF Sensor.Avg_Pos > 4 THEN Sensor.Avg_Pos := 0; END_IF

Sensor.Avg_Sum := Sensor.Avg_Sum + IN - Sensor.Avg_Buf[Sensor.Avg_Pos];
Sensor.Avg_Buf[Sensor.Avg_Pos] := IN;
Sensor.Avg_Pos := Sensor.Avg_Pos + 1;

Sensor.Raw := Sensor.Avg_Sum / 5.0;
Sensor.Err := Sensor.Raw < Sensor.MinRaw OR Sensor.Raw > Sensor.MaxRaw;

(*CALIB*)
IF Sensor.Cal_Apply THEN
	IF Sensor.Cal_Min > 0.0 AND Sensor.Cal_Max > 0.0 AND Sensor.Cal_Min <> Sensor.Cal_Max THEN
		Sensor.Cal_K   := 100.0 / (Sensor.Cal_Max - Sensor.Cal_Min);
		Sensor.Cal_Off := -Sensor.Cal_Min * Sensor.Cal_K;

		Sensor.Cal_Min := 0.0;
		Sensor.Cal_Max := 0.0;
	END_IF

	Sensor.Cal_Apply := FALSE;
END_IF

Sensor.Pos := Sensor.Raw * Sensor.Cal_K + Sensor.Cal_Off;

(*ALARM*)
IF Clear THEN
	Sensor.Alarm.Alarm := FALSE;
	Sensor.Alarm.Adver := FALSE;
	Sensor.Alarm.AlCnt := 0;
	Sensor.Alarm.AlLen := 0.0;

END_IF

IF Sensor.Err THEN
	IF NOT Sensor.Alarm.Alarm THEN
		Sensor.Alarm.AlCnt  := Sensor.Alarm.AlCnt + 1;
		Sensor.Alarm.AlLen  := 0.0;
		Sensor.Alarm.TimeInit := INPUTS.sLocal;
		Sensor.Alarm.AlInit   := TRUE;

		Sensor.Alarm.Text   := CONCAT( Sensor.Desc, ' Position. Sensor Broken/Disconnected.' );

	ELSE
		Sensor.Alarm.AlLen  := Sensor.Alarm.AlLen + MAIN.Cycle_Time;
	END_IF

	Sensor.Alarm.Alarm := TRUE;
	Sensor.Alarm.Adver := TRUE;

ELSE
	IF Sensor.Alarm.Alarm THEN
		Sensor.Alarm.TimeEnd := INPUTS.sLocal;
		Sensor.Alarm.AlEnd   := TRUE;

	END_IF

	Sensor.Alarm.Alarm := FALSE;
END_IF
END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_CALC_SENSOR_TEMP : BOOL
VAR_INPUT
	IN    : REAL;
	Clear : BOOL;
	Cycle : REAL;
END_VAR
VAR_IN_OUT
	Sensor : ST_SENSOR_TEMP;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)

(*AVG*)
IF Sensor.Avg_Pos > 4 THEN Sensor.Avg_Pos := 0; END_IF

Sensor.Avg_Sum := Sensor.Avg_Sum + IN - Sensor.Avg_Buf[Sensor.Avg_Pos];
Sensor.Avg_Buf[Sensor.Avg_Pos] := IN;
Sensor.Avg_Pos := Sensor.Avg_Pos + 1;

Sensor.Raw := Sensor.Avg_Sum / 5.0;
Sensor.Err := Sensor.Raw < Sensor.MinRaw OR Sensor.Raw > Sensor.MaxRaw;

(*CALIB*)
Sensor.Deg := Sensor.Raw * Sensor.Cal_K + Sensor.Cal_Off;

(*ALARM*)
IF Clear THEN
	Sensor.Alarm.Alarm := FALSE;
	Sensor.Alarm.Adver := FALSE;
	Sensor.Alarm.AlCnt := 0;
	Sensor.Alarm.AlLen := 0.0;
	Sensor.AdverLv     := 0;
(*	Sensor.AdverVal    := Sensor.Deg;*)

END_IF

IF Sensor.Err THEN
	IF NOT Sensor.Alarm.Alarm THEN
		Sensor.Alarm.AlCnt  := Sensor.Alarm.AlCnt + 1;
		Sensor.Alarm.AlLen  := 0.0;
		Sensor.Alarm.TimeInit := INPUTS.sLocal;
		Sensor.Alarm.AlInit   := TRUE;

		Sensor.Alarm.Text := CONCAT( Sensor.Desc , ' Temperature. Sensor Broken/Disconnected.' );

	ELSE
		Sensor.Alarm.AlLen  := Sensor.Alarm.AlLen + MAIN.Cycle_Time;

	END_IF

	Sensor.Alarm.Alarm := TRUE;
	Sensor.Alarm.Adver := TRUE;

	Sensor.AlErr    := TRUE;
	Sensor.AlLow    := FALSE;
	Sensor.AlHig    := FALSE;
	Sensor.AlMax    := FALSE;
	Sensor.AdverLv  := 4;
	Sensor.AdverVal := 0.0;

ELSIF Sensor.Deg > Sensor.MaxDeg THEN
	IF NOT Sensor.Alarm.Alarm THEN
		Sensor.Alarm.AlCnt  := Sensor.Alarm.AlCnt + 1;
		Sensor.Alarm.AlLen  := 0.0;
		Sensor.Alarm.TimeInit := INPUTS.sLocal;
		Sensor.Alarm.AlInit   := TRUE;

		Sensor.AdverVal     := Sensor.Deg;

	ELSE
		Sensor.Alarm.AlLen  := Sensor.Alarm.AlLen + MAIN.Cycle_Time;

	END_IF

	Sensor.Alarm.Alarm := TRUE;
	Sensor.AlErr       := FALSE;
	Sensor.AlLow       := FALSE;

	IF Sensor.Count > Sensor.Delay THEN
		Sensor.AlHig := FALSE;
		Sensor.AlMax := TRUE;
	ELSE
		Sensor.AlHig := TRUE;
		Sensor.AlMax := FALSE;

		Sensor.Count := Sensor.Count + Cycle;
	END_IF

	IF Sensor.AdverLv < 4 THEN
		Sensor.Alarm.Adver := TRUE;
		Sensor.AdverLv     := 3;
		Sensor.AdverVal    := MAX( Sensor.Deg, Sensor.AdverVal );

		Sensor.Alarm.Text  := CONCAT( Sensor.Desc      , ' Max. Temperature exceeded: '  );
		Sensor.Alarm.Text  := CONCAT( Sensor.Alarm.Text, REAL_TO_STRING(Sensor.AdverVal) );
	END_IF

ELSIF Sensor.Deg > Sensor.HigDeg THEN
	IF NOT Sensor.Alarm.Alarm THEN
		Sensor.Alarm.AlCnt  := Sensor.Alarm.AlCnt + 1;
		Sensor.Alarm.AlLen  := 0.0;
		Sensor.Alarm.TimeInit := INPUTS.sLocal;
		Sensor.Alarm.AlInit   := TRUE;

		Sensor.AdverVal     := Sensor.Deg;

	ELSE
		Sensor.Alarm.AlLen  := Sensor.Alarm.AlLen + MAIN.Cycle_Time;

	END_IF

	Sensor.Alarm.Alarm := TRUE;
	Sensor.AlErr       := FALSE;
	Sensor.AlLow       := FALSE;
	Sensor.AlHig       := TRUE;
	Sensor.AlMax       := FALSE;

	IF Sensor.AdverLv < 3 THEN
		Sensor.Alarm.Adver := TRUE;
		Sensor.AdverLv     := 2;
		Sensor.AdverVal    := MAX( Sensor.Deg, Sensor.AdverVal );

		Sensor.Alarm.Text  := CONCAT( Sensor.Desc      , ' High Temperature exceeded: '  );
		Sensor.Alarm.Text  := CONCAT( Sensor.Alarm.Text, REAL_TO_STRING(Sensor.AdverVal) );
	END_IF

ELSIF Sensor.Deg > Sensor.LowDeg THEN
	Sensor.Alarm.Alarm := FALSE;
	Sensor.AlErr       := FALSE;
	Sensor.AlLow       := TRUE;
	Sensor.AlHig       := FALSE;
	Sensor.AlMax       := FALSE;

	IF Sensor.AdverLv < 2 THEN
		Sensor.Alarm.Adver := TRUE;
		Sensor.AdverLv     := 1;
		Sensor.AdverVal    := MAX( Sensor.Deg, Sensor.AdverVal );

		Sensor.Alarm.Text  := CONCAT( Sensor.Desc      , ' Mild Temperature exceeded: ' );
		Sensor.Alarm.Text  := CONCAT( Sensor.Alarm.Text, REAL_TO_STRING(Sensor.AdverVal) );
	END_IF
ELSE
	IF Sensor.Alarm.Alarm THEN
		Sensor.Alarm.TimeEnd := INPUTS.sLocal;
		Sensor.Alarm.AlEnd   := TRUE;

	END_IF

	Sensor.Alarm.Alarm := FALSE;
	Sensor.AlErr       := FALSE;
	Sensor.AlLow       := FALSE;
	Sensor.AlHig       := FALSE;
	Sensor.AlMax       := FALSE;
	Sensor.Count       := 0;

END_IF
END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/PGN FB' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK FB_CODE_0000 (*Torque / Speed Control*)
VAR_INPUT
	Enable   : BOOL;
	Source   : BYTE := 16#17;
	Priority : BYTE := 16#06;

	TaskTime     : WORD; (*PLC Taks Time (ms) eg: 10ms*)
	TransmitTime : WORD; (*Synchronous Transmision Time (ms) eg: 100ms*)

	SpeedCtrl  : BOOL;
	TorqueCtrl : BOOL;
	SpeedLimit : REAL;
	TorqueLimit: SINT;
END_VAR
VAR_OUTPUT
	OUT : VARTYPE_EXTCANQUEUE;
	OUT_Enable : BOOL;
END_VAR
VAR
	TimeCnt : WORD;
	dwSrc   : DWORD;
	dwPty   : DWORD;

	bySpeedCtrl  : BYTE;
	byTorqueCtrl : BYTE;
END_VAR
(* @END_DECLARATION := '0' *)
IF Enable THEN
	TimeCnt := TimeCnt + TaskTime;

	IF TransmitTime <= TimeCnt THEN
		TimeCnt := 0;
		dwSrc   := Source;
		dwPty   := Priority AND 16#07;
		dwPty   := SHL( dwPty, 26 );

		bySpeedCtrl  := BOOL_TO_BYTE(SpeedCtrl);
		byTorqueCtrl := BOOL_TO_BYTE(TorqueCtrl) * 2;

		OUT.rxData[0] := bySpeedCtrl OR byTorqueCtrl;

		REAL_TO_BUFFER( pBuffer:= ADR(OUT.rxData[1]), ByteSize := 2, Value:= SpeedLimit, Scale:= 0.125, Offset := 0.0 );

		OUT.rxData[3] := TorqueLimit + 125;
		OUT.rxData[4] := 16#00;
		OUT.rxData[5] := 16#00;
		OUT.rxData[6] := 16#00;
		OUT.rxData[7] := 16#00;

		OUT.length := 8;
		Out.cobId  := 16#80000000 OR dwSrc OR dwPty;
		OUT_Enable := TRUE;
	ELSE
		OUT_Enable := FALSE;

	END_IF
ELSE
	Out_Enable := FALSE;

END_IF
END_FUNCTION_BLOCK


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/PGN FB' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK FB_CODE_F001 (*Electronic Brake Controller*)
VAR_INPUT
	Enable   : BOOL;
	Source   : BYTE := 16#17;
	Priority : BYTE := 16#06;

	TaskTime     : WORD; (*PLC Taks Time (ms) eg: 10ms*)
	TransmitTime : WORD; (*Synchronous Transmision Time (ms) eg: 100ms*)

	EngineStop : BOOL;
END_VAR
VAR_OUTPUT
	OUT : VARTYPE_EXTCANQUEUE;
	OUT_Enable : BOOL;
END_VAR
VAR
	TimeCnt : WORD;
	dwSrc   : DWORD;
	dwPty   : DWORD;
END_VAR
(* @END_DECLARATION := '0' *)
IF Enable THEN
	TimeCnt := TimeCnt + TaskTime;

	IF TransmitTime <= TimeCnt THEN
		TimeCnt := 0;
		dwSrc   := Source;
		dwPty   := Priority AND 16#07;
		dwPty   := SHL( dwPty, 26 );

		OUT.rxData[0] := 16#00;
		OUT.rxData[1] := 16#00;
		OUT.rxData[2] := 16#00;

		IF EngineStop
		THEN OUT.rxData[3] := 16#10;
		ELSE OUT.rxData[3] := 16#00;
		END_IF

		OUT.rxData[4] := 16#00;
		OUT.rxData[5] := 16#00;
		OUT.rxData[6] := 16#00;
		OUT.rxData[7] := 16#00;

		OUT.length := 8;
		Out.cobId  := 16#80F00100 OR dwSrc OR dwPty;
		OUT_Enable := TRUE;
	ELSE
		OUT_Enable := FALSE;

	END_IF
ELSE
	Out_Enable := FALSE;

END_IF
END_FUNCTION_BLOCK


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/PGN FB' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK FB_CODE_F003 (*Torque / Speed Control*)
VAR_INPUT
	Enable   : BOOL;
	Source   : BYTE := 16#31;
	Priority : BYTE := 16#03;

	TaskTime     : WORD; (*PLC Taks Time (ms) eg: 10ms*)
	TransmitTime : WORD; (*Synchronous Transmision Time (ms) eg: 50ms*)

	PedalPerc : REAL;
END_VAR
VAR_OUTPUT
	OUT : VARTYPE_EXTCANQUEUE;
	OUT_Enable : BOOL;
END_VAR
VAR
	TimeCnt : WORD;
	dwSrc   : DWORD;
	dwPty   : DWORD;

	bySpeedCtrl  : BYTE;
	byTorqueCtrl : BYTE;
END_VAR
(* @END_DECLARATION := '0' *)
IF Enable THEN
	TimeCnt := TimeCnt + TaskTime;

	IF TransmitTime <= TimeCnt THEN
		TimeCnt := 0;
		dwSrc   := Source;
		dwPty   := Priority AND 16#07;
		dwPty   := SHL( dwPty, 26 );

		OUT.rxData[0] := 16#00;

		REAL_TO_BUFFER( pBuffer:= ADR(OUT.rxData[1]), ByteSize := 1, Value:= PedalPerc, Scale:= 0.4, Offset := 0.0 );

		OUT.rxData[2] := 16#00;
		OUT.rxData[3] := 16#00;
		OUT.rxData[4] := 16#00;
		OUT.rxData[5] := 16#00;
		OUT.rxData[6] := 16#00;
		OUT.rxData[7] := 16#00;

		OUT.length := 8;
		Out.cobId  := 16#80F00300 OR dwSrc OR dwPty;
		OUT_Enable := TRUE;
	ELSE
		OUT_Enable := FALSE;

	END_IF
ELSE
	Out_Enable := FALSE;

END_IF
END_FUNCTION_BLOCK


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/PGN FB' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK FB_CODE_FF70 (*Torque / Speed Control*)
VAR_INPUT
	Enable   : BOOL;
	Source   : BYTE := 16#10;
	Priority : BYTE := 16#02;

	TaskTime     : WORD; (*PLC Taks Time (ms) eg: 10ms*)
	TransmitTime : WORD; (*Synchronous Transmision Time (ms) eg: 50ms*)

	PedalPerc  : REAL;
	PedalID    : BYTE;
	PedalFault : BOOL;
END_VAR
VAR_OUTPUT
	OUT : VARTYPE_EXTCANQUEUE;
	OUT_Enable : BOOL;
END_VAR
VAR
	TimeCnt : WORD;
	dwSrc   : DWORD;
	dwPty   : DWORD;

	bySpeedCtrl  : BYTE;
	byTorqueCtrl : BYTE;
END_VAR
(* @END_DECLARATION := '0' *)
IF Enable THEN
	TimeCnt := TimeCnt + TaskTime;

	IF TransmitTime <= TimeCnt THEN
		TimeCnt := 0;
		dwSrc   := Source;
		dwPty   := Priority AND 16#07;
		dwPty   := SHL( dwPty, 26 );

		REAL_TO_BUFFER( pBuffer:= ADR(OUT.rxData[0]), ByteSize := 2, Value:= PedalPerc, Scale:= 0.1, Offset := 0.0 );

		OUT.rxData[2] := PedalID;
		OUT.rxData[3] := 16#00;
		OUT.rxData[3].0 := PedalFault;
		OUT.rxData[4] := 16#00;
		OUT.rxData[5] := 16#00;
		OUT.rxData[6] := 16#00;
		OUT.rxData[7] := 16#00;

		OUT.length := 8;
		Out.cobId  := 16#80FF7000 OR dwSrc OR dwPty;
		OUT_Enable := TRUE;
	ELSE
		OUT_Enable := FALSE;

	END_IF
ELSE
	Out_Enable := FALSE;

END_IF
END_FUNCTION_BLOCK


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/PGN FB' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK FB_CODE_FF71 (*Torque / Speed Control*)
VAR_INPUT
	Enable   : BOOL;
	Source   : BYTE := 0;(*16#10;*)
	Priority : BYTE := 16#02;

	TaskTime     : WORD; (*PLC Taks Time (ms) eg: 10ms*)
	TransmitTime : WORD; (*Synchronous Transmision Time (ms) eg: 50ms*)

	PedalPerc  : REAL;
	PedalID    : BYTE;
	PedalFault : BOOL;
END_VAR
VAR_OUTPUT
	OUT : VARTYPE_EXTCANQUEUE;
	OUT_Enable : BOOL;
END_VAR
VAR
	TimeCnt : WORD;
	dwSrc   : DWORD;
	dwPty   : DWORD;

	bySpeedCtrl  : BYTE;
	byTorqueCtrl : BYTE;
END_VAR
(* @END_DECLARATION := '0' *)
IF Enable THEN
	TimeCnt := TimeCnt + TaskTime;

	IF TransmitTime <= TimeCnt THEN
		TimeCnt := 0;
		dwSrc   := Source;
		dwPty   := Priority AND 16#07;
		dwPty   := SHL( dwPty, 26 );

		REAL_TO_BUFFER( pBuffer:= ADR(OUT.rxData[0]), ByteSize := 2, Value:= PedalPerc, Scale:= 0.1, Offset := 0.0 );

		OUT.rxData[2] := PedalID; (*ID*)
		OUT.rxData[3] := 16#00;
		OUT.rxData[3].0 := PedalFault;
		OUT.rxData[4] := 16#00;
		OUT.rxData[5] := 16#00;
		OUT.rxData[6] := 16#00;
		OUT.rxData[7] := 16#00;

		OUT.length := 8;
		Out.cobId  := 16#80FF7100 OR dwSrc OR dwPty;
		OUT_Enable := TRUE;
	ELSE
		OUT_Enable := FALSE;

	END_IF
ELSE
	Out_Enable := FALSE;

END_IF
END_FUNCTION_BLOCK


