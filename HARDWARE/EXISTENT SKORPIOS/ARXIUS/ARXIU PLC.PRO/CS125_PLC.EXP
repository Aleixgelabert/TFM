F_CALC_SENSOR_BAR( N41_AI2_CH5_4 * 0.004, ALARMS.Clear,  P503 );
F_CALC_SENSOR_BAR( N41_AI1_CH6_2 * 0.004, ALARMS.Clear,  P507 );
F_CALC_SENSOR_BAR( N41_AI0_CH6_4 * 0.004, ALARMS.Clear,  P505 );

