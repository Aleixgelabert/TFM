	B1210_1[1] := N11_DI0;
	B1210_2[1] := N11_DI1;
ELSE
	B1210_1[1] := FALSE;
	B1210_2[1] := FALSE;
END_IF

B1210_G    := N11_DI2;
B1210_1[4] := N121_IN.1;
B1210_2[4] := N121_IN.5;

(*W1212 - Sec Port*)
