OR fbW1202.State <> 0
OR fbW1204.State <> 0
OR fbW1206.State <> 0
OR fbW1208.State <> 0
OR fbW1210.State <> 0
OR fbW1212.State <> 0
OR fbW1214.State <> 0

OR fbW1602.State <> 0
OR fbW1604.State <> 0

OR fbBoard.State       <> 0
OR fbKeel.State        <> 0
OR fbTraveller.State   <> 0

OR fbBowThr.State     <> 0
OR fbBowThrUpDw.State <> 0

OR NOT aSys_Enable[2]
THEN AutoOffCnt := 0.0;
ELSE AutoOffCnt := AutoOffCnt + Cycle_Time;
END_IF

POWERPACK;
ENGINE;
ALARMS;
OUTPUTS;
TOFARO;

IF ENGINE.fbPropulsion.MoveEV THEN Prop_UsedTime := Prop_UsedTime + Cycle_Time; END_IF

IF fbW1202.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1204.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1206.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1208.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1210.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1212.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1214.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1602.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF
IF fbW1604.OUT_TWC <> 0 THEN W1202_USedTime := W1202_USedTime + Cycle_Time; END_IF


(*Save Persistent Vars when power down*)
(*fbUPS();*)
END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM OUTPUTS
VAR CONSTANT
	BUF_SIZE : WORD := 4095;
	MAX_PSX  : INT  := 1000; (*100*10*)
END_VAR
VAR
	PSX50 : FB_PSX_VALVE;
	PSX51 : FB_PSX_VALVE;
	PSX52 : FB_PSX_VALVE;
	PSX53 : FB_PSX_VALVE;
	PSX54 : FB_PSX_VALVE;
	PSX55 : FB_PSX_VALVE;
	PSX56 : FB_PSX_VALVE;
	PSX57 : FB_PSX_VALVE;
	PSX58 : FB_PSX_VALVE;
	PSX59 : FB_PSX_VALVE;

	PSX60 : FB_PSX_VALVE;
	PSX61 : FB_PSX_VALVE;
	PSX64 : FB_PSX_VALVE;

	PSX70 : FB_PSX_VALVE;
	PSX71 : FB_PSX_VALVE;
	PSX72 : FB_PSX_VALVE;
	PSX73 : FB_PSX_VALVE;
	PSX74 : FB_PSX_VALVE;

	tsTime    :TIMESTRUCT;
	sDate     :STRING;
	sLocal    :STRING;
	sDaySec   :STRING;


	SIMob      : FB_SMART_INPUT;
	SIDimmerUp : FB_SMART_INPUT;
	SIDimmerDw : FB_SMART_INPUT;

	wDimmerBackLight : WORD;
	byDimmerLedBar   : BYTE;
	byDimmerDeckLink : BYTE;
	byDimmerBLink    : BYTE;
	byDimmerState    : BYTE;

	(*Mob : BOOL;*)

	sValue : STRING;

	engCnt : REAL;

	(*UDP Stream*)
	fbUdpSend        : FB_UDP_SEND;
	fbSocketCloseAll : FB_SocketCloseAll;
    bCloseAll 	     : BOOL := TRUE;

	aBuffer : ARRAY[0..BUF_SIZE] OF BYTE;
	wBufPos : DWORD;

	i   : INT;
	chk : BYTE;
	(*Bobstay_Ignore : BOOL;*)


	fbResetCan1 : IOF_DeviceReset;
	fbResetCan2 : IOF_DeviceReset;
	fbResetCan3 : IOF_DeviceReset;
	fbResetCan4 : IOF_DeviceReset;
	fbResetCan5 : IOF_DeviceReset;

	ResetCan1 : BOOL;
	ResetCan2 : BOOL;
	ResetCan3 : BOOL;
	ResetCan4 : BOOL;
	ResetCan5 : BOOL;

	W_CAN_PWR : BOOL := TRUE;
	W_CAN_CNT : REAL := 20.0;

END_VAR
VAR PERSISTENT
	Dimmer_Panels   AT %Q*: WORD;
	Dimmer_LedBar   AT %Q*: WORD;
	Dimmer_DeckLink AT %Q*: WORD;

END_VAR
(* @END_DECLARATION := '0' *)
W_CAN_CNT := W_CAN_CNT + MAIN.Cycle_Time;
W_CAN_PWR := W_CAN_CNT > 20.0;

(*Node00-PLC*)
N0_DO1 := ALARMS.Buzzer;
(*N0_DO2 := Engine Stop*)
N0_DO3 := W_CAN_PWR;
N0_DO4 := ENGINE.Engine_ON;
(*N0_DO5 := Engine Ignition*)
(*N0_DO6 := Engine Start*)
N0_DO7 := KEY_PP1;
N0_DO8 := KEY_PP2;

N0_AO1 := REAL_TO_INT(THR_PP1 * 3276.7); (*0..10V*)
N0_AO2 := REAL_TO_INT(THR_PP2 * 3276.7); (*0..10V*)


IF NOT TANK.Enable OR ENGINE.Engine_STOP OR NOT MAIN.aSys_Enable[8] THEN

	IF engCnt > 5 THEN
		N0_DO2 := FALSE;
	ELSE
		engCnt := engCnt + MAIN.Cycle_Time;
	END_IF

ELSE
	N0_DO2 := TRUE;


END_IF

(***STERN Nodes***)
(*Node36/37 - TANK + GS + MF00 + PP *)
	N36_EVP3_CH1_2 := EVP001;
