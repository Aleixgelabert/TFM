fbResetCan3 ( DEVICEID:=  4, RESET:= ResetCan3, TMOUT:= T#20s );
fbResetCan4 ( DEVICEID:=  5, RESET:= ResetCan4, TMOUT:= T#20s );
fbResetCan5 ( DEVICEID:=  7, RESET:= ResetCan5, TMOUT:= T#20s );

