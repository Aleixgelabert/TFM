(*Move - WAIT BEFORE PUMP*)
3210,3220,3230,3240:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF Event_Dump = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS THEN
		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	ELSE
		IF Event_Move = INIT_CONTINUOUS THEN
			Pause := NOT Pause;
		END_IF

		IF Event_Stop = INIT_CONTINUOUS OR TimeCnt > TimeMove THEN
			TimeCnt := 0.0;
			State   := State + 100;
		END_IF

	END_IF

