	ELSIF Event_Stop = INIT_CONTINUOUS OR Event_Dump = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS THEN
		WB_N.B_Close := FALSE;
		WB_R.B_Close := FALSE;

		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	ELSE
		IF Event_Move = INIT_CONTINUOUS THEN
			Pause := NOT Pause;
		END_IF

		Init := TRUE;
	
		IF NOT (WB_N.SF_Close AND WB_N.State = 0) THEN WB_N.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_R.SF_Close AND WB_R.State = 0) THEN WB_R.B_Close := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_N.B_Close := FALSE;
			WB_R.B_Close := FALSE;

			State := State + 100;

		END_IF
	END_IF

(*Stbd Aft Move - Close Valves*)
3440:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSIF Event_Stop = INIT_CONTINUOUS OR Event_Dump = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS THEN
		WB_I.B_Close := FALSE;

		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	ELSE
		IF Event_Move = INIT_CONTINUOUS THEN
			Pause := NOT Pause;
		END_IF

		Init := TRUE;
	
		IF NOT (WB_I.SF_Close AND WB_I.State = 0) THEN WB_I.B_Close := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_I.B_Close := FALSE;

			State := State + 100;

		END_IF
	END_IF

(*Port Fwd Move - Open Valves3*)
3510:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSIF Event_Stop = INIT_CONTINUOUS OR Event_Dump = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS THEN
		WB_A.B_Open := FALSE;
		WB_E.B_Open := FALSE;
		WB_K.B_Open := FALSE;
		WB_L.B_Open := FALSE;

		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	ELSE
		IF Event_Move = INIT_CONTINUOUS THEN
			Pause := NOT Pause;
		END_IF

		Init := TRUE;
	
		IF NOT (WB_A.SF_Open AND WB_A.State = 0) THEN WB_A.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_E.SF_Open AND WB_E.State = 0) THEN WB_E.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_K.SF_Open AND WB_K.State = 0) THEN WB_K.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_L.SF_Open AND WB_L.State = 0) THEN WB_L.B_Open := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_A.B_Open := FALSE;
			WB_E.B_Open := FALSE;
			WB_K.B_Open := FALSE;
			WB_L.B_Open := FALSE;

			TimeCnt  := 0.0;

			IF SF_S_Fwd THEN
				TimeCnt := 0.0;
				State   := 5000;
				Next    := 0;
			ELSE
				EVP_Pump := REAL_TO_INT(EVP_Pump_Tgt * Perc * 10.0);
				OUT_LP   := 1;
				State    := State + 100; (*Port Fwd Dump - Pump*)
			END_IF

		END_IF
	END_IF

(*Port Aft Move - Open Valves3*)
3520:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSIF Event_Stop = INIT_CONTINUOUS OR Event_Dump = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS THEN
		WB_D.B_Open := FALSE;
		WB_E.B_Open := FALSE;
		WB_M.B_Open := FALSE;
		WB_L.B_Open := FALSE;

		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	ELSE
		IF Event_Move = INIT_CONTINUOUS THEN
			Pause := NOT Pause;
		END_IF

		Init := TRUE;
		IF NOT (WB_D.SF_Open AND WB_D.State = 0) THEN WB_D.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_E.SF_Open AND WB_E.State = 0) THEN WB_E.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_M.SF_Open AND WB_M.State = 0) THEN WB_M.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_L.SF_Open AND WB_L.State = 0) THEN WB_L.B_Open := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_D.B_Open := FALSE;
			WB_E.B_Open := FALSE;
			WB_M.B_Open := FALSE;
			WB_L.B_Open := FALSE;

			TimeCnt  := 0.0;

			IF SF_S_Aft THEN
				TimeCnt := 0.0;
				State   := 5000;
				Next    := 0;
			ELSE
				EVP_Pump := REAL_TO_INT(EVP_Pump_Tgt * Perc * 10.0);
				OUT_LP   := 1;
				State    := State + 100; (*Port Fwd Dump - Pump*)
			END_IF

		END_IF
	END_IF

(*Stbd Fwd Move - Open Valves3*)
3530:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSIF Event_Stop = INIT_CONTINUOUS OR Event_Dump = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS THEN
		WB_A.B_Open := FALSE;
		WB_F.B_Open := FALSE;
		WB_H.B_Open := FALSE;
		WB_K.B_Open := FALSE;

		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	ELSE
		IF Event_Move = INIT_CONTINUOUS THEN
			Pause := NOT Pause;
		END_IF

		Init := TRUE;

		IF NOT (WB_A.SF_Open AND WB_A.State = 0) THEN WB_A.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_F.SF_Open AND WB_F.State = 0) THEN WB_F.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_H.SF_Open AND WB_H.State = 0) THEN WB_H.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_K.SF_Open AND WB_K.State = 0) THEN WB_K.B_Open := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_A.B_Open := FALSE;
			WB_F.B_Open := FALSE;
			WB_H.B_Open := FALSE;
			WB_K.B_Open := FALSE;

			TimeCnt  := 0.0;

			IF SF_P_Fwd THEN
				TimeCnt := 0.0;
				State   := 5000;
				Next    := 0;
			ELSE
				EVP_Pump := REAL_TO_INT(EVP_Pump_Tgt * Perc * 10.0);
				OUT_LP   := 1;
				State    := State + 100; (*Port Fwd Dump - Pump*)
			END_IF

		END_IF
	END_IF

(*Stbd Aft Move - Open Valves3*)
3540:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSIF Event_Stop = INIT_CONTINUOUS OR Event_Dump = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS THEN
		WB_D.B_Open := FALSE;
		WB_F.B_Open := FALSE;
		WB_H.B_Open := FALSE;
		WB_M.B_Open := FALSE;

		TimeCnt := 0.0;
		State   := 5000;
		Next    := 0;

	ELSE
		IF Event_Move = INIT_CONTINUOUS THEN
			Pause := NOT Pause;
		END_IF

		Init := TRUE;

		IF NOT (WB_D.SF_Open AND WB_D.State = 0) THEN WB_D.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_F.SF_Open AND WB_F.State = 0) THEN WB_F.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_H.SF_Open AND WB_H.State = 0) THEN WB_H.B_Open := TRUE; Init := FALSE; END_IF
		IF NOT (WB_M.SF_Open AND WB_M.State = 0) THEN WB_M.B_Open := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_D.B_Open := FALSE;
			WB_F.B_Open := FALSE;
			WB_H.B_Open := FALSE;
			WB_M.B_Open := FALSE;

			TimeCnt  := 0.0;

			IF SF_P_Aft THEN
				TimeCnt := 0.0;
				State   := 5000;
				Next    := 0;
			ELSE
				EVP_Pump := REAL_TO_INT(EVP_Pump_Tgt * Perc * 10.0);
				OUT_LP   := 1;
				State    := State + 100; (*Port Fwd Dump - Pump*)
			END_IF

		END_IF
	END_IF

(*Move Pump*)
3610,3620,3630,3640:
	IF Manual OR NOT Ready THEN
		OUT_LP   := 0;
		State    := 0;

	ELSE
		IF Event_Stop = INIT_CONTINUOUS OR Event_Fill = INIT_CONTINUOUS OR Event_Move = INIT_CONTINUOUS
		OR State = 3610 AND SF_S_Fwd
		OR State = 3620 AND SF_S_Aft
		OR State = 3630 AND SF_P_Fwd
		OR State = 3640 AND SF_P_Aft
		THEN
			SoftStop := TRUE;
		END_IF

		IF Event_Move = INIT_CONTINUOUS THEN
			Pause := NOT Pause;
		END_IF

		IF SoftStop OR Pause THEN
			EVP_Pump_Tgt := EVP_Pump_Tgt - CFG.EVP_Pump_Dec * CFG.Cycle;
			EVP_Pump_Tgt := MIN(EVP_Pump_Tgt, CFG.EVP_Pump_Max);
			EVP_Pump_Tgt := MAX(EVP_Pump_Tgt, CFG.EVP_Pump_Min);

			IF EVP_Pump_Tgt = CFG.EVP_Pump_Min OR CFG.EVP_Pump_Dec <= 0
			THEN EVP_Pump := 0;
			ELSE EVP_Pump := REAL_TO_UINT(EVP_Pump_Tgt * Perc * 10.0);
			END_IF

		ELSE
			EVP_Pump_Tgt := EVP_Pump_Tgt + CFG.EVP_Pump_Inc * CFG.Cycle;
			EVP_Pump_Tgt := MIN(EVP_Pump_Tgt, CFG.EVP_Pump_Max);
			EVP_Pump_Tgt := MAX(EVP_Pump_Tgt, CFG.EVP_Pump_Min);

			EVP_Pump := REAL_TO_UINT(EVP_Pump_Tgt * Perc * 10.0);

		END_IF

		IF EVP_Pump = 0 THEN
			OUT_LP := 0;

			IF SoftStop THEN
				TimeCnt := 0.0;
				State   := 5000;
				Next    := 0;
			END_IF

		ELSE
			OUT_LP := 1;

		END_IF
	END_IF


(*****************************************************************************)
(** INIT                                                                    **)
(*****************************************************************************)
(*Init Status - Valves*)
5000:
	OUT_Stop := TRUE;

	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		TimeCnt := 0.0;
		Error   := State;
		State   := 5001; (*Siempre fuerzo el scoop*)

	ELSE
		Init := TRUE;
	
		IF NOT (WB_A.SF_Close AND WB_A.State = 0) THEN WB_A.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_B.SF_Close AND WB_B.State = 0) THEN WB_B.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_C.SF_Close AND WB_C.State = 0) THEN WB_C.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_D.SF_Close AND WB_D.State = 0) THEN WB_D.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_E.SF_Close AND WB_E.State = 0) THEN WB_E.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_F.SF_Close AND WB_F.State = 0) THEN WB_F.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_G.SF_Close AND WB_G.State = 0) THEN WB_G.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_H.SF_Close AND WB_H.State = 0) THEN WB_H.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_I.SF_Close AND WB_I.State = 0) THEN WB_I.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_J.SF_Close AND WB_J.State = 0) THEN WB_J.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_K.SF_Close AND WB_K.State = 0) THEN WB_K.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_L.SF_Close AND WB_L.State = 0) THEN WB_L.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_M.SF_Close AND WB_M.State = 0) THEN WB_M.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_N.SF_Close AND WB_N.State = 0) THEN WB_N.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_R.SF_Close AND WB_R.State = 0) THEN WB_R.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_S.SF_Close AND WB_S.State = 0) THEN WB_S.B_Close := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_A.B_Close := FALSE;
			WB_B.B_Close := FALSE;
			WB_C.B_Close := FALSE;
			WB_D.B_Close := FALSE;
			WB_E.B_Close := FALSE;
			WB_F.B_Close := FALSE;
			WB_G.B_Close := FALSE;
			WB_H.B_Close := FALSE;
			WB_I.B_Close := FALSE;
			WB_J.B_Close := FALSE;
			WB_K.B_Close := FALSE;
			WB_L.B_Close := FALSE;
			WB_M.B_Close := FALSE;
			WB_N.B_Close := FALSE;
			WB_R.B_Close := FALSE;
			WB_S.B_Close := FALSE;

			State := 5001;

		END_IF
	END_IF

(*Init Status - Scoop UP*)
5001:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSE
		Init := TRUE;
	
		IF NOT (WB_PUD.SF_Close AND WB_PUD.State = 0) THEN WB_PUD.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_SUD.SF_Close AND WB_SUD.State = 0) THEN WB_SUD.B_Close := TRUE; Init := FALSE; END_IF

		IF CFG.EnScoopAF THEN
			IF NOT (WB_PAF.SF_Close AND WB_PAF.State = 0) THEN WB_PAF.B_Close := TRUE; Init := FALSE; END_IF (*test1*)
			IF NOT (WB_SAF.SF_Close AND WB_SAF.State = 0) THEN WB_SAF.B_Close := TRUE; Init := FALSE; END_IF (*test2*)
		END_IF

		IF Init THEN
			WB_PUD.B_Close := FALSE;
			WB_SUD.B_Close := FALSE;

			WB_PAF.B_Close := FALSE; (*test3*)
			WB_SAF.B_Close := FALSE; (*test4*)

			TimeCnt := 0.0;	 (*test5*)
			State   := Next; (*test6*)

			IF State = 0 THEN
				OUT_P_Fwd := FALSE;
				OUT_P_Aft := FALSE;
				OUT_S_Fwd := FALSE;
				OUT_S_Aft := FALSE;
				OUT_12    := FALSE;
			END_IF

			(*State := 5002;*) (*test7*)

		END_IF
	END_IF

(*Init Status - Scoop FWD*) (*No enta mas!*)
(*5002:
	IF Manual OR NOT Ready THEN
		State := 0;

	ELSIF TimeCnt > CFG.TimeMax_Init THEN
		Error := State;
		State := 0;

	ELSE
		Init := TRUE;
	
		IF NOT (WB_PAF.SF_Close AND WB_PAF.State = 0) THEN WB_PAF.B_Close := TRUE; Init := FALSE; END_IF
		IF NOT (WB_SAF.SF_Close AND WB_SAF.State = 0) THEN WB_SAF.B_Close := TRUE; Init := FALSE; END_IF

		IF Init THEN
			WB_PAF.B_Close := FALSE;
			WB_SAF.B_Close := FALSE;

			TimeCnt := 0.0;
			State   := Next;

		END_IF
	END_IF*)

END_CASE

OUT_Pump := EVP_Pump <> 0;

(*
	PAF y SAF disabled
*)



(*Recordar PUMP EV1608 multiplicar por 10.0*)

(*	IF NOT (WB_A.SF_Close AND WB_A.State = 0) THEN WB_A.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_B.SF_Close AND WB_B.State = 0) THEN WB_B.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_C.SF_Close AND WB_C.State = 0) THEN WB_C.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_D.SF_Close AND WB_D.State = 0) THEN WB_D.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_E.SF_Close AND WB_E.State = 0) THEN WB_E.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_F.SF_Close AND WB_F.State = 0) THEN WB_F.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_G.SF_Close AND WB_G.State = 0) THEN WB_G.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_H.SF_Close AND WB_H.State = 0) THEN WB_H.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_I.SF_Close AND WB_I.State = 0) THEN WB_I.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_J.SF_Close AND WB_J.State = 0) THEN WB_J.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_K.SF_Close AND WB_K.State = 0) THEN WB_K.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_L.SF_Close AND WB_L.State = 0) THEN WB_L.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_M.SF_Close AND WB_M.State = 0) THEN WB_M.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_N.SF_Close AND WB_N.State = 0) THEN WB_N.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_R.SF_Close AND WB_R.State = 0) THEN WB_R.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_S.SF_Close AND WB_S.State = 0) THEN WB_S.B_Close := TRUE; Init := FALSE; END_IF

	IF NOT (WB_PUD.SF_Close AND WB_PUD.State = 0) THEN WB_PUD.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_PAF.SF_Close AND WB_PAF.State = 0) THEN WB_PAF.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_SUD.SF_Close AND WB_SUD.State = 0) THEN WB_SUD.B_Close := TRUE; Init := FALSE; END_IF
	IF NOT (WB_SAF.SF_Close AND WB_SAF.State = 0) THEN WB_SAF.B_Close := TRUE; Init := FALSE; END_IF

	WB_A.B_Close := FALSE;
	WB_B.B_Close := FALSE;
	WB_C.B_Close := FALSE;
	WB_D.B_Close := FALSE;
	WB_E.B_Close := FALSE;
	WB_F.B_Close := FALSE;
	WB_G.B_Close := FALSE;
	WB_H.B_Close := FALSE;
	WB_I.B_Close := FALSE;
	WB_J.B_Close := FALSE;
	WB_K.B_Close := FALSE;
	WB_L.B_Close := FALSE;
	WB_M.B_Close := FALSE;
	WB_N.B_Close := FALSE;
	WB_R.B_Close := FALSE;
	WB_S.B_Close := FALSE;

	WB_PUD.B_Close := FALSE;
	WB_PAF.B_Close := FALSE;
	WB_SUD.B_Close := FALSE;
	WB_SAF.B_Close := FALSE;

	IF NOT (WB_A.SF_Open AND WB_A.State = 0) THEN WB_A.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_B.SF_Open AND WB_B.State = 0) THEN WB_B.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_C.SF_Open AND WB_C.State = 0) THEN WB_C.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_D.SF_Open AND WB_D.State = 0) THEN WB_D.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_E.SF_Open AND WB_E.State = 0) THEN WB_E.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_F.SF_Open AND WB_F.State = 0) THEN WB_F.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_G.SF_Open AND WB_G.State = 0) THEN WB_G.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_H.SF_Open AND WB_H.State = 0) THEN WB_H.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_I.SF_Open AND WB_I.State = 0) THEN WB_I.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_J.SF_Open AND WB_J.State = 0) THEN WB_J.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_K.SF_Open AND WB_K.State = 0) THEN WB_K.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_L.SF_Open AND WB_L.State = 0) THEN WB_L.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_M.SF_Open AND WB_M.State = 0) THEN WB_M.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_N.SF_Open AND WB_N.State = 0) THEN WB_N.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_R.SF_Open AND WB_R.State = 0) THEN WB_R.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_S.SF_Open AND WB_S.State = 0) THEN WB_S.B_Open := TRUE; Init := FALSE; END_IF

	IF NOT (WB_PUD.SF_Open AND WB_PUD.State = 0) THEN WB_PUD.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_PAF.SF_Open AND WB_PAF.State = 0) THEN WB_PAF.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_SUD.SF_Open AND WB_SUD.State = 0) THEN WB_SUD.B_Open := TRUE; Init := FALSE; END_IF
	IF NOT (WB_SAF.SF_Open AND WB_SAF.State = 0) THEN WB_SAF.B_Open := TRUE; Init := FALSE; END_IF

*)
END_FUNCTION_BLOCK


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FB' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK FB_WB_VALVE
VAR_INPUT
	Enable : BOOL;
	Manual : BOOL;

	B_Open  : BOOL;
	B_Close : BOOL;
	SF_Open  : BOOL;
	SF_Close : BOOL;

END_VAR
VAR_IN_OUT
	P   : ST_SENSOR_BAR;
	CFG : ST_WB_VALVE_CFG;
END_VAR
VAR_OUTPUT
	OUT_Open  : BOOL;
	OUT_Close : BOOL;

	OUT_HP    : BYTE;
END_VAR
VAR
	State : WORD;

	IN_Hmi_Open  : BOOL;
	IN_Hmi_Close : BOOL;

	SI_Open  : FB_SMART_INPUT;
	SI_Close : FB_SMART_INPUT;

	SI_Hmi_Open  : FB_SMART_INPUT;
	SI_Hmi_Close : FB_SMART_INPUT;

	TimeCnt : REAL;
	TimeOut : BOOL;

END_VAR
(* @END_DECLARATION := '0' *)
(*Check Inputs*)
SI_Open (In:= B_Open , T_Cont:= T#0ms, T_DClk:= T#0ms);
SI_Close(In:= B_Close, T_Cont:= T#0ms, T_DClk:= T#0ms);

SI_Hmi_Open (In:= IN_Hmi_Open , T_Cont:= T#0ms, T_DClk:= T#0ms);
SI_Hmi_Close(In:= IN_Hmi_Close, T_Cont:= T#0ms, T_DClk:= T#0ms);

IF NOT Enable THEN
	OUT_Open  := FALSE;
	OUT_Close := FALSE;
	OUT_HP    := 0;

	TimeCnt := 0.0;
	State   := 0;
	RETURN;
END_IF

(*Check Time*)
TimeOut := TimeOut OR ( CFG.TimeMax > 0  AND TimeCnt > CFG.TimeMax );
TimeCnt := TimeCnt + CFG.Cycle;

(*Working States*)
CASE State OF

(*Init State*)
0:
	OUT_Open  := FALSE;
	OUT_Close := FALSE;
	OUT_HP    := 0;

	(*Manual*)
	IF Manual THEN
		IF SI_Hmi_Open.Event = INIT_CONTINUOUS AND NOT P.AlMax THEN
			OUT_Open  := TRUE;
			OUT_HP    := 1;
	
			TimeOut := FALSE; (*Reset TimeOut Error*)
			State   := 1001;  (*Next State*)

		ELSIF SI_Hmi_Close.Event = INIT_CONTINUOUS AND NOT P.AlMax THEN
			OUT_Close := TRUE;
			OUT_HP    := 1;

			TimeOut := FALSE; (*Reset TimeOut Error*)
			State   := 1002;  (*Next State*)

		END_IF

	(*Automatico*)
	ELSE
		IF SI_Open.Event = INIT_CONTINUOUS AND NOT P.AlMax THEN
			OUT_Open  := TRUE;
			OUT_HP    := CFG.HP;

			TimeOut := FALSE; (*Reset TimeOut Error*)
			State   := 1010;  (*Next State*)

		ELSIF SI_Close.Event = INIT_CONTINUOUS AND NOT P.AlMax THEN
			OUT_Close := TRUE;
			OUT_HP    := CFG.HP;

			TimeOut := FALSE; (*Reset TimeOut Error*)
			State   := 1020;  (*Next State*)

		END_IF
	END_IF

    TimeCnt := 0.0; (*Time Count*)

(*Manual OPEN*)
1001:
	(*End*)
	IF SI_Hmi_Open.Event <> NONE OR SI_Hmi_Close.Event <> NONE OR TimeOut OR NOT Manual OR P.AlMax THEN
		OUT_Open  := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	END_IF

(*Manual CLOSE*)
1002:
	(*End*)
	IF SI_Hmi_Open.Event <> NONE OR SI_Hmi_Close.Event <> NONE OR TimeOut OR NOT Manual OR P.AlMax THEN
		OUT_Close := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	END_IF

(*Auto OPEN*)
1010:
	(*End*)
	IF SI_Open.Event <> NONE OR TimeOut OR Manual OR P.AlMax THEN
		OUT_Open  := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	ELSIF SI_Close.Event = INIT_CONTINUOUS THEN
		OUT_Open  := FALSE;
		OUT_Close := TRUE;
		State     := 1020; (*Next State*)

	ELSIF SF_Open THEN
		TimeCnt   := 0.0;
		State     := 1011; (*Next State*)

	END_IF

(*Push OPEN*)
1011:
	(*End*)
	IF SI_Open.Event <> NONE OR TimeOut OR TimeCnt > CFG.PushTime OR (CFG.PushP > 0 AND P.Bar > CFG.PushP) OR Manual OR P.AlMax THEN
		OUT_Open  := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	ELSIF SI_Close.Event = INIT_CONTINUOUS THEN
		OUT_Open  := FALSE;
		OUT_Close := TRUE;
		State     := 1020; (*Next State*)

	END_IF

(*Auto CLOSE*)
1020:
	(*End*)
	IF SI_Close.Event <> NONE OR TimeOut OR Manual OR P.AlMax THEN
		OUT_Close := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	ELSIF SI_Open.Event = INIT_CONTINUOUS THEN
		OUT_Close := FALSE;
		OUT_Open  := TRUE;
		State     := 1010; (*Next State*)

	ELSIF SF_Close THEN
		TimeCnt   := 0.0;
		State     := 1021; (*Next State*)

	END_IF

(*Push CLOSE*)
1021:
	(*End*)
	IF SI_Close.Event <> NONE OR TimeOut OR TimeCnt > CFG.PushTime OR (CFG.PushP > 0 AND P.Bar > CFG.PushP) OR Manual OR P.AlMax THEN
		OUT_Close := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	ELSIF SI_Open.Event = INIT_CONTINUOUS THEN
		OUT_Close := FALSE;
		OUT_Open  := TRUE;
		State     := 1010; (*Next State*)

	END_IF


END_CASE
END_FUNCTION_BLOCK


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FB' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK FB_WB_VALVE_LS
VAR_INPUT
	Enable : BOOL;
	Manual : BOOL;

	B_Open  : BOOL;
	B_Half  : BOOL;
	B_Close : BOOL;

	R_Open  : BOOL;
	R_Close : BOOL;

END_VAR
VAR_IN_OUT
	P   : ST_SENSOR_BAR;
	LS  : ST_SENSOR_POS;
	CFG : ST_WB_VALVE_LS_CFG;
END_VAR
VAR_OUTPUT
	OUT_Open  : BOOL;
	OUT_Close : BOOL;

	OUT_HP    : BYTE;
END_VAR
VAR
	State : WORD;

	IN_Hmi_Open  : BOOL;
	IN_Hmi_Close : BOOL;

	SI_Open  : FB_SMART_INPUT;
	SI_Half  : FB_SMART_INPUT;
	SI_Close : FB_SMART_INPUT;

	SI_Hmi_Open  : FB_SMART_INPUT;
	SI_Hmi_Close : FB_SMART_INPUT;
	SI_HmiR_Open  : FB_SMART_INPUT;
	SI_HmiR_Close : FB_SMART_INPUT;

	TimeCnt : REAL;
	TimeOut : BOOL;

	SF_Open : BOOL;
	SF_Half : BOOL;
	SF_Close : BOOL;

END_VAR
(* @END_DECLARATION := '0' *)
(*Check Inputs*)
SI_Open (In:= B_Open , T_Cont:= T#0ms, T_DClk:= T#0ms);
SI_Half (In:= B_Half , T_Cont:= T#0ms, T_DClk:= T#0ms);
SI_Close(In:= B_Close, T_Cont:= T#0ms, T_DClk:= T#0ms);

SI_Hmi_Open  (In:= IN_Hmi_Open , T_Cont:= T#0ms, T_DClk:= T#0ms);
SI_Hmi_Close (In:= IN_Hmi_Close, T_Cont:= T#0ms, T_DClk:= T#0ms);
SI_HmiR_Open (In:= R_Open , T_Cont:= T#0ms, T_DClk:= T#0ms);
SI_HmiR_Close(In:= R_Close, T_Cont:= T#0ms, T_DClk:= T#0ms);

SF_Open  := NOT LS.Err AND LS.Pos > 100.0 - CFG.LS_DB; 	(*OPEN  -> 100%*)
SF_Half  := NOT LS.Err AND LS.Pos > CFG.TgtLS_Half - CFG.LS_DB; (* CFG.LS_DB > ABS(CFG.TgtLS_Half - LS.Pos);*)
SF_Close := NOT LS.Err AND LS.Pos < CFG.LS_DB;  		(*CLOSE ->   0%*)

IF NOT Enable THEN
	OUT_Open  := FALSE;
	OUT_Close := FALSE;
	OUT_HP    := 0;

	TimeCnt := 0.0;
	State   := 0;
	RETURN;
END_IF

(*Check Time*)
TimeOut := TimeOut OR ( CFG.TimeMax > 0  AND TimeCnt > CFG.TimeMax );
TimeCnt := TimeCnt + CFG.Cycle;

(*Working States*)
CASE State OF

(*Init State*)
0:
	OUT_Open  := FALSE;
	OUT_Close := FALSE;
	OUT_HP    := 0;

	(*Manual*)
	IF Manual AND NOT P.AlMax THEN
		IF SI_Hmi_Open.Event = INIT_CONTINUOUS OR SI_HmiR_Open.Event = INIT_CONTINUOUS THEN
			OUT_Open  := TRUE;
			OUT_HP    := 1;
	
			TimeOut := FALSE; (*Reset TimeOut Error*)
			State   := 1001;  (*Next State*)

		ELSIF SI_Hmi_Close.Event = INIT_CONTINUOUS OR SI_HmiR_Close.Event = INIT_CONTINUOUS THEN
			OUT_Close := TRUE;
			OUT_HP    := 1;

			TimeOut := FALSE; (*Reset TimeOut Error*)
			State   := 1002;  (*Next State*)

		END_IF

	(*Automatico*)
	ELSIF NOT P.AlMax AND NOT LS.Err THEN
		IF SI_Open.Event = INIT_CONTINUOUS THEN
			OUT_Open  := TRUE;
			OUT_HP    := CFG.HP;

			TimeOut := FALSE; (*Reset TimeOut Error*)
			State   := 1010;  (*Next State*)

		ELSIF SI_Close.Event = INIT_CONTINUOUS THEN
			OUT_Close := TRUE;
			OUT_HP    := CFG.HP;

			TimeOut := FALSE; (*Reset TimeOut Error*)
			State   := 1020;  (*Next State*)

		ELSIF SI_Half.Event = INIT_CONTINUOUS THEN
			IF LS.Pos < CFG.TgtLS_Half - CFG.LS_DB THEN
				OUT_Open  := TRUE;
				OUT_HP    := CFG.HP;

				TimeOut := FALSE; (*Reset TimeOut Error*)
				State   := 1030;  (*Next State*)

			ELSIF LS.Pos > CFG.TgtLS_Half + CFG.LS_DB THEN
				OUT_Close := TRUE;
				OUT_HP    := CFG.HP;

				TimeOut := FALSE; (*Reset TimeOut Error*)
				State   := 1040;  (*Next State*)

			END_IF
		END_IF
	END_IF

    TimeCnt := 0.0; (*Time Count*)

(*Manual OPEN*)
1001:
	(*End*)
	IF SI_Hmi_Open.Event <> NONE OR SI_HmiR_Open.Event <> NONE
	OR SI_Hmi_Close.Event <> NONE OR SI_HmiR_Close.Event <> NONE
	OR TimeOut OR NOT Manual OR P.AlMax THEN
		OUT_Open  := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	END_IF

(*Manual CLOSE*)
1002:
	(*End*)
	IF SI_Hmi_Open.Event <> NONE OR SI_HmiR_Open.Event <> NONE
	OR SI_Hmi_Close.Event <> NONE OR SI_HmiR_Close.Event <> NONE
	OR TimeOut OR NOT Manual OR P.AlMax THEN
		OUT_Close := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	END_IF

(*Auto OPEN*)
1010,1030:
	(*End*)
	IF SI_Open.Event <> NONE OR SI_Half.Event <> NONE OR TimeOut OR Manual OR P.AlMax OR LS.Err THEN
		OUT_Open  := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	ELSIF SI_Close.Event = INIT_CONTINUOUS THEN
		OUT_Open  := FALSE;
		OUT_Close := TRUE;
		State     := 1020; (*Next State*)

	ELSIF State = 1030 AND LS.Pos > CFG.TgtLS_Half - CFG.LS_DB THEN
		OUT_Open  := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	ELSIF SF_Open THEN
		TimeCnt   := 0.0;
		State     := 1011; (*Next State*)

	END_IF

(*Push OPEN*)
1011:
	(*End*)
	IF SI_Open.Event <> NONE OR TimeOut OR TimeCnt > CFG.PushTime OR (CFG.PushP > 0 AND P.Bar > CFG.PushP) OR Manual OR P.AlMax THEN
		OUT_Open  := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	ELSIF SI_Close.Event = INIT_CONTINUOUS THEN
		OUT_Open  := FALSE;
		OUT_Close := TRUE;
		State     := 1020; (*Next State*)

	END_IF

(*Auto CLOSE*)
1020,1040:
	(*End*)
	IF SI_Close.Event <> NONE OR SI_Half.Event <> NONE OR TimeOut OR Manual OR P.AlMax OR LS.Err THEN
		OUT_Close := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	ELSIF SI_Open.Event = INIT_CONTINUOUS THEN
		OUT_Close := FALSE;
		OUT_Open  := TRUE;
		State     := 1010; (*Next State*)

	ELSIF State = 1040 AND LS.Pos < CFG.TgtLS_Half + CFG.LS_DB THEN
		OUT_Close := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	ELSIF SF_Close THEN
		TimeCnt   := 0.0;
		State     := 1021; (*Next State*)

	END_IF

(*Push CLOSE*)
1021:
	(*End*)
	IF SI_Close.Event <> NONE OR TimeOut OR TimeCnt > CFG.PushTime OR (CFG.PushP > 0 AND P.Bar > CFG.PushP) OR Manual OR P.AlMax THEN
		OUT_Close := FALSE;
		OUT_HP    := 0;
		State     := 0; (*Next State*)

	ELSIF SI_Open.Event = INIT_CONTINUOUS THEN
		OUT_Close := FALSE;
		OUT_Open  := TRUE;
		State     := 1010; (*Next State*)

	END_IF


END_CASE
END_FUNCTION_BLOCK


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FB' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK FB_WINCHE_V2
VAR_INPUT
	Enable : BOOL;
	Ready  : BOOL;

	Perc : REAL;

	IN_1 : ARRAY[1..4] OF BOOL;
	IN_2 : ARRAY[1..4] OF BOOL;
	IN_3 : BOOL;

	Override : BOOL := FALSE;

END_VAR
VAR_IN_OUT
	P_A : ST_SENSOR_BAR;
	P_B : ST_SENSOR_BAR;
	CFG : ST_WINCHE_CFG;
	RAMP: ST_WINCHE_RAMP_CFG;
END_VAR
VAR_OUTPUT
	OUT_TWC : INT;
	OUT_LP  : BYTE;
END_VAR
VAR
	State : WORD;

	IN_SelA : REAL;
	IN_SelB : REAL;
	IN_MaxA : REAL;
	IN_MaxB : REAL;

	IN_Hmi_1 : BOOL;
	IN_Hmi_2 : BOOL;

	SI_A : ARRAY[1..5] OF FB_SMART_INPUT;
	SI_B : ARRAY[1..5] OF FB_SMART_INPUT;

	EventA : EN_SMART_INPUT_STATE;
	EventB : EN_SMART_INPUT_STATE;

	Spd_Tgt  : REAL;
	SoftStop : BOOL;
	Boost    : BOOL;

	CyclCnt : REAL;
	TimeOut : BOOL;

	IsIN_3     : BOOL;
	IsIN_3_Cnt : REAL;

	SpdA : INT;
	SpdB : INT;
	Spd1 : STRING;
	Spd2 : STRING;
	Out_1: BOOL;
	Out_2: BOOL;

	ToFaroInput  : REAL;
	ToFaroOutput : REAL;
END_VAR
(* @END_DECLARATION := '0' *)
IF IN_3 THEN
	IsIN_3     := TRUE;
	IsIN_3_Cnt := 0;
ELSE
	IF IsIN_3_Cnt > 0.25 THEN
		IsIN_3 := FALSE;
	ELSE
		IsIN_3_Cnt := IsIN_3_Cnt + CFG.Cycle;
	END_IF
END_IF


IF Cfg.A_Spd1 THEN
	SpdA := 1;
	SpdB := 2;
	Spd1 := 'A';
	Spd2 := 'B';

	SI_A[1](In:= IN_1[1], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_A[2](In:= IN_1[2], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_A[3](In:= IN_1[3], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_A[4](In:= IN_1[4], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_A[5](In:= IN_Hmi_1, T_Cont:= T#0ms, T_DClk:= T#0ms);


	SI_B[1](In:= IN_2[1], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_B[2](In:= IN_2[2], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_B[3](In:= IN_2[3], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_B[4](In:= IN_2[4], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_B[5](In:= IN_Hmi_2, T_Cont:= T#0ms, T_DClk:= T#0ms);

	IF    SI_A[1].Event <> NONE THEN EventA := SI_A[1].Event;
	ELSIF SI_A[2].Event <> NONE THEN EventA := SI_A[2].Event;
	ELSIF SI_A[3].Event <> NONE THEN EventA := SI_A[3].Event;
	ELSIF SI_A[4].Event <> NONE THEN EventA := SI_A[4].Event;
	ELSIF SI_A[5].Event <> NONE THEN EventA := SI_A[5].Event;
	ELSE							 EventA := NONE;
	END_IF

	IF    SI_B[1].Event <> NONE THEN EventB := SI_B[1].Event;
	ELSIF SI_B[2].Event <> NONE THEN EventB := SI_B[2].Event;
	ELSIF SI_B[3].Event <> NONE THEN EventB := SI_B[3].Event;
	ELSIF SI_B[4].Event <> NONE THEN EventB := SI_B[4].Event;
	ELSIF SI_B[5].Event <> NONE THEN EventB := SI_B[5].Event;
	ELSE							 EventB := NONE;
	END_IF

	IF IsIN_3 THEN
		IN_SelA := CFG.Spd3[1];
		IN_MaxA := CFG.Spd3[7];

		P_A.MaxBar := CFG.P3_Max;
	ELSE
		IN_SelA := CFG.Spd1[1];
		IN_MaxA := CFG.Spd1[7];

		P_A.MaxBar := CFG.P1_Max;
	END_IF

	IN_SelB := CFG.Spd2[1];
	IN_MaxB := CFG.Spd2[7];

	P_B.MaxBar := CFG.P2_Max;

ELSE
	SpdA := 2;
	SpdB := 1;
	Spd1 := 'B';
	Spd2 := 'A';

	SI_A[1](In:= IN_2[1], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_A[2](In:= IN_2[2], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_A[3](In:= IN_2[3], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_A[4](In:= IN_2[4], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_A[5](In:= IN_Hmi_2, T_Cont:= T#0ms, T_DClk:= T#0ms);

	SI_B[1](In:= IN_1[1], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_B[2](In:= IN_1[2], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_B[3](In:= IN_1[3], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_B[4](In:= IN_1[4], T_Cont:= T#0ms, T_DClk:= T#0ms);
	SI_B[5](In:= IN_Hmi_1, T_Cont:= T#0ms, T_DClk:= T#0ms);

	IF    SI_A[1].Event <> NONE THEN EventA := SI_A[1].Event;
	ELSIF SI_A[2].Event <> NONE THEN EventA := SI_A[2].Event;
	ELSIF SI_A[3].Event <> NONE THEN EventA := SI_A[3].Event;
	ELSIF SI_A[4].Event <> NONE THEN EventA := SI_A[4].Event;
	ELSIF SI_A[5].Event <> NONE THEN EventA := SI_A[5].Event;
	ELSE							 EventA := NONE;
	END_IF

	IF    SI_B[1].Event <> NONE THEN EventB := SI_B[1].Event;
	ELSIF SI_B[2].Event <> NONE THEN EventB := SI_B[2].Event;
	ELSIF SI_B[3].Event <> NONE THEN EventB := SI_B[3].Event;
	ELSIF SI_B[4].Event <> NONE THEN EventB := SI_B[4].Event;
	ELSIF SI_B[5].Event <> NONE THEN EventB := SI_B[5].Event;
	ELSE							 EventB := NONE;
	END_IF

	IF IsIN_3 THEN
		IN_SelB := CFG.Spd3[1];
		IN_MaxB := CFG.Spd3[7];

		P_B.MaxBar := CFG.P3_Max;
	ELSE
		IN_SelB := CFG.Spd1[1];
		IN_MaxB := CFG.Spd1[7];

		P_B.MaxBar := CFG.P1_Max;
	END_IF

	IN_SelA := CFG.Spd2[1];
	IN_MaxA := CFG.Spd2[7];

	P_A.MaxBar := CFG.P2_Max;

END_IF
(*
IF    IN_SpdA < 1 THEN IN_SpdA := 1;
ELSIF IN_SpdA > 7 THEN IN_SpdA := 7;
END_IF

IF    IN_SpdB < 1 THEN IN_SpdB := 1;
ELSIF IN_SpdB > 7 THEN IN_SpdB := 7;
END_IF
*)
ToFaroInput := 0.0;
IF IN_1[1] OR IN_1[2] OR IN_1[3] OR IN_1[4] OR IN_Hmi_1 THEN ToFaroInput := 1.0;               END_IF
IF IN_2[1] OR IN_2[2] OR IN_2[3] OR IN_2[4] OR IN_Hmi_2 THEN ToFaroInput := 2.0 + ToFaroInput; END_IF

IF NOT Enable THEN
	OUT_TWC := 0;
	OUT_LP  := 0;

	CyclCnt := 0;
	State   := 0;
	RETURN;
END_IF

(*Check Time*)
TimeOut := TimeOut OR (CFG.TimeMax > 0 AND CyclCnt > CFG.TimeMax);
CyclCnt := CyclCnt + CFG.Cycle;

CASE State OF
0: (*INIT*)
	OUT_TWC := 0;
	CyclCnt := 0;

	SoftStop := FALSE;
	Boost    := FALSE;

	IF Ready THEN
		IF EventA = INIT_CONTINUOUS AND NOT P_A.AlMax THEN
			Spd_Tgt := RAMP.Spd_Min;
			OUT_TWC := REAL_TO_INT(Spd_Tgt * Perc * 10.0);
			TimeOut := FALSE;
			State   := 10;

		ELSIF EventB = INIT_CONTINUOUS AND NOT P_B.AlMax THEN
			Spd_Tgt := RAMP.Spd_Min;
			OUT_TWC := REAL_TO_INT(-Spd_Tgt * Perc * 10.0);
			TimeOut := FALSE;
			State   := 20;

		END_IF
	END_IF


10: (*A*)
	IF TimeOut OR P_A.AlMax THEN
		OUT_TWC := 0;
		State   := 0;

	ELSE
		IF EventA = INIT_CONTINUOUS THEN
			SoftStop := FALSE;
			CyclCnt  := 0;
		ELSIF EventA = END_CONTINUOUS THEN
			SoftStop := TRUE;
		END_IF

		IF SoftStop THEN
			IF EventB = INIT_CONTINUOUS THEN
				Spd_Tgt := RAMP.Spd_Min;
				OUT_TWC := REAL_TO_INT(-Spd_Tgt * Perc * 10.0);
				TimeOut := FALSE;
				State   := 20;

			ELSE
				Spd_Tgt := Spd_Tgt - RAMP.Spd_Dec * CFG.Cycle;
				Spd_Tgt := MIN(Spd_Tgt, IN_SelA     );
				Spd_Tgt := MAX(Spd_Tgt, RAMP.Spd_Min);

				IF Spd_Tgt = RAMP.Spd_Min OR RAMP.Spd_Dec <= 0
				THEN OUT_TWC := 0;
				ELSE OUT_TWC := REAL_TO_INT(Spd_Tgt * Perc * 10.0);
				END_IF

			END_IF

		ELSE
			IF EventB = INIT_CONTINUOUS OR Override THEN
				Boost := TRUE;
			ELSIF EventB = END_CONTINUOUS THEN
				Boost := FALSE;
			END_IF

			Spd_Tgt := Spd_Tgt + RAMP.Spd_Inc * CFG.Cycle;
			IF Boost
			THEN Spd_Tgt := MIN(Spd_Tgt, IN_MaxA );
			ELSE Spd_Tgt := MIN(Spd_Tgt, IN_SelA );
			END_IF
			Spd_Tgt := MAX(Spd_Tgt, RAMP.Spd_Min);

			OUT_TWC := REAL_TO_INT(Spd_Tgt * Perc * 10.0);

		END_IF

		IF OUT_TWC = 0 THEN
			State    := 0; (*Next State*)
		END_IF

		(*OUT_TWC := REAL_TO_INT(CFG.SpdA[IN_SpdA] * Perc * 10.0);*)

	END_IF

20: (*B*)
	IF TimeOut OR P_B.AlMax THEN
		OUT_TWC := 0;
		State   := 0;

	ELSE
		IF EventB = INIT_CONTINUOUS THEN
			SoftStop := FALSE;
			CyclCnt  := 0;
		ELSIF EventB = END_CONTINUOUS THEN
			SoftStop := TRUE;
		END_IF

		IF SoftStop THEN
			IF EventA = INIT_CONTINUOUS THEN
				Spd_Tgt := RAMP.Spd_Min;
				OUT_TWC := REAL_TO_INT(Spd_Tgt * Perc * 10.0);
				TimeOut := FALSE;
				State   := 10;

			ELSE
				Spd_Tgt := Spd_Tgt - RAMP.Spd_Dec * CFG.Cycle;
				Spd_Tgt := MIN(Spd_Tgt, IN_SelB     );
				Spd_Tgt := MAX(Spd_Tgt, RAMP.Spd_Min);
	
				IF Spd_Tgt = RAMP.Spd_Min OR RAMP.Spd_Dec <= 0
				THEN OUT_TWC := 0;
				ELSE OUT_TWC := REAL_TO_INT(-Spd_Tgt * Perc * 10.0);
				END_IF

			END_IF

		ELSE
			IF EventA = INIT_CONTINUOUS OR Override THEN
				Boost := TRUE;
			ELSIF EventA = END_CONTINUOUS THEN
				Boost := FALSE;
			END_IF

			Spd_Tgt := Spd_Tgt + RAMP.Spd_Inc * CFG.Cycle;
			IF Boost
			THEN Spd_Tgt := MIN(Spd_Tgt, IN_MaxB );
			ELSE Spd_Tgt := MIN(Spd_Tgt, IN_SelB );
			END_IF
			Spd_Tgt := MAX(Spd_Tgt, RAMP.Spd_Min);

			OUT_TWC := REAL_TO_INT(-Spd_Tgt * Perc * 10.0);

		END_IF

		IF OUT_TWC = 0 THEN
			State    := 0; (*Next State*)
		END_IF

		(*OUT_TWC := REAL_TO_INT(-CFG.SpdB[IN_SpdB] * Perc * 10.0);*)

	END_IF

END_CASE

IF Cfg.A_Spd1 THEN
	Out_1 := OUT_TWC > 0;
	Out_2 := OUT_TWC < 0;
ELSE
	Out_1 := OUT_TWC < 0;
	Out_2 := OUT_TWC > 0;
END_IF

IF OUT_TWC = 0 THEN
	OUT_LP := 0;
ELSE
	OUT_LP  := 1; (*How Many*)
END_IF

(*Gear to FARO*)
IF Out_1 THEN
	IF IsIN_3
	THEN ToFaroOutput := 1;
	ELSE ToFaroOutput := 3;
	END_IF
ELSIF Out_2 THEN
	ToFaroOutput := 2;
ELSE
	ToFaroOutput := 0;
END_IF

END_FUNCTION_BLOCK


