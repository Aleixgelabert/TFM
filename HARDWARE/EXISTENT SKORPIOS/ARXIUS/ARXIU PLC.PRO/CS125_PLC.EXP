F_CALC_SENSOR_BAR ( N20_AI3_CH5_2 * 0.004, ALARMS.Clear,  P601 );
F_CALC_SENSOR_BAR ( N20_AI2_CH5_4 * 0.004, ALARMS.Clear,  P603 );
F_CALC_SENSOR_BAR ( N20_AI1_CH6_2 * 0.004, ALARMS.Clear,  P605 );
F_CALC_SENSOR_BAR ( N20_AI0_CH6_4 * 0.004, ALARMS.Clear,  P607 );

F_CALC_SENSOR_POS ( N47_AI1_CH6_2 * 0.004, ALARMS.Clear, LS601 );
