IF ResetCan2 THEN ResetCan2 := FALSE; END_IF
IF ResetCan3 THEN ResetCan3 := FALSE; END_IF
IF ResetCan4 THEN ResetCan4 := FALSE; END_IF
IF ResetCan5 THEN ResetCan5 := FALSE; END_IF


END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM PARAMS
VAR CONSTANT
	BUF_SIZE: WORD := 15000;
END_VAR
VAR
	Loaded : BOOL;
	Error  : BOOL;
	Save   : BOOL;
	Saved  : BOOL;
	State  : WORD;
	SavedCnt : REAL;

	fbParamList : FB_IDLIST;
	fbSaveList  : FB_FILE_WRITE;

	aBuffer : ARRAY[1..BUF_SIZE] OF BYTE;
	wBufPos : DWORD;

	i : INT;

(*Sensors*)
	SF_Delay : REAL;

(*Parameters*)
	(*stTankCfg*)
	stEngineCfg     : ST_ENGINE_CFG;
	stPropulsionCfg : ST_PROPULSION_CFG;
	stPowerpackCfg  : ST_POWERPACK_CFG;

	(*Cilinders*)
	stSE301Cfg  : ST_SE_CYLINDER_POS_CFG;
	stSE303Cfg  : ST_SE_CYLINDER_POS_CFG;
	stSE305Cfg  : ST_SE_CYLINDER_POS_CFG;
	stSE307Cfg  : ST_SE_CYLINDER_POS_CFG;
	stSE309Cfg  : ST_SE_CYLINDER_POS_CFG;
	stSE311Cfg  : ST_SE_CYLINDER_POS_CFG;

	stSE501Cfg  : ST_SE_CYLINDER_CFG;
	stSE503Cfg  : ST_SE_CYLINDER_CFG;
	stSE505Cfg  : ST_SE_CYLINDER_CFG;

	stDE601Cfg  : ST_LIFT_PROP_CFG;
	stDE605Cfg  : ST_DE_CYLINDER_POS_CFG;

	stSE701Cfg  : ST_SE_CYLINDER_CFG;
	stSE703Cfg  : ST_SE_CYLINDER_CFG;
	stSE705Cfg  : ST_SE_CYLINDER_CFG;
	stSE707Cfg  : ST_SE_CYLINDER_POS_CFG;
	stSE709Cfg  : ST_SE_CYLINDER_POS_CFG;

	stSE901Cfg  : ST_SE_CYLINDER_POS_CFG;
	(*stSE903Cfg  : ST_SE_CYLINDER_POS_CFG;*)

	(*Water Ballast*)
	stWBCfg        : ST_WB_CFG;
	stWBValveSFCfg : ST_WB_VALVE_CFG;
	stWBValveLSCfg : ST_WB_VALVE_LS_CFG;

	(*Winches*)
	stW1202Cfg    : ST_WINCHE_CFG;
	stW1204Cfg    : ST_WINCHE_CFG;
	stW1206Cfg    : ST_WINCHE_CFG;
	stW1208Cfg    : ST_WINCHE_CFG;
	stW1210Cfg    : ST_WINCHE_CFG;
	stW1212Cfg    : ST_WINCHE_CFG;
	stW1214Cfg    : ST_WINCHE_CFG;

	stW1602Cfg    : ST_WINCHE_CFG;
	stW1604Cfg    : ST_WINCHE_CFG;

	stWRampCfg    : ST_WINCHE_RAMP_CFG;

	(*Other*)
	stBoardCfg     : ST_BOARD_CFG;
	stKeelCfg      : ST_KEEL_CFG;
	stTravellerCfg : ST_TRAVELLER_CFG;

	stBowThrCfg     : ST_LP_FUNC_CFG;
	stBowThrUpDwCfg : ST_LP_FUNC_CFG;

	stTackValveCfg  : ST_TACK_VALVE_CFG;

	stMastSetup : ST_MAST_SETUP;

(*UDP Parameter Vars*)
	sUDPSendHost : STRING(15);
	nUDPSendPort : UDINT;
	nUDPSendTime : UINT;
	nUDPRecvPort : UDINT;

	sUDPAlarmsHost : STRING(15);
	nUDPAlarmsPort : UDINT;
END_VAR
(* @END_DECLARATION := '0' *)
IF SavedCnt > 0 THEN
	Saved    := FALSE;
	SavedCnt := SavedCnt - 0.005;
ELSE
	Saved := TRUE;
END_IF

CASE State OF
0: (*Init State*)
	IF NOT Loaded THEN
		fbParamList.sFilePath := '\Hard Disk\FTP\Sensors.txt';
		(*fbParamList.sFilePath := '\Hard Disk\FTP\Parameters.txt';*)
		Error := FALSE;
		State := 100;
	ELSIF Save THEN
		fbSaveList.sFilePath := '\Hard Disk\FTP\';
		fbSaveList.sFileName := 'Sensors';
(*		fbSaveList.sFileName := 'Parameters';*)
		fbSaveList.sFileExt  := '.txt';
		fbSaveList.Backup    := TRUE;

		Save  := FALSE;
		SavedCnt := 1.5;
		State := 200;
	ELSE
		fbParamList( bEnable := FALSE );
		fbSaveList ( bEnable := FALSE );

	END_IF

100: (*Load Sensors*)
	fbParamList( bEnable := TRUE );

	IF fbParamList.bInit THEN
		State := 110;
	ELSIF fbParamList.byError > 0 THEN
		Loaded := TRUE;
		Error  := TRUE;
		State  := 0;
	END_IF

110:(*Read SENSORS*)
	(*EVP*)
	EVP313.Cal_K    := F_IDLIST_GETREAL( 'EVP313_K'   , fbParamList );
	EVP313.Cal_Off  := F_IDLIST_GETREAL( 'EVP313_Off' , fbParamList );
	EVP513.Cal_K    := F_IDLIST_GETREAL( 'EVP513_K'   , fbParamList );
	EVP513.Cal_Off  := F_IDLIST_GETREAL( 'EVP513_Off' , fbParamList );
	EVP709.Cal_K    := F_IDLIST_GETREAL( 'EVP709_K'   , fbParamList );
	EVP709.Cal_Off  := F_IDLIST_GETREAL( 'EVP709_Off' , fbParamList );
	EVP1005.Cal_K   := F_IDLIST_GETREAL( 'EVP1005_K'  , fbParamList );
	EVP1005.Cal_Off := F_IDLIST_GETREAL( 'EVP1005_Off', fbParamList );
	EVP1010.Cal_K   := F_IDLIST_GETREAL( 'EVP1010_K'  , fbParamList );
	EVP1010.Cal_Off := F_IDLIST_GETREAL( 'EVP1010_Off', fbParamList );

	(*Node36/37 - TANK + GS + MF00 + PP*)
	SF_Delay := F_IDLIST_GETREAL( 'SF_Delay', fbParamList );

	F_READ_SENSOR_BAR(  P010, fbParamList );
	P010.MinBar := F_IDLIST_GETREAL( CONCAT(P010.Name, '_Min'), fbParamList );

	F_READ_SENSOR_BAR(  P001, fbParamList );
	F_READ_SENSOR_BAR(  P002, fbParamList );
	F_READ_SENSOR_BAR(  P003, fbParamList );

	F_READ_SENSOR_BAR(  P051, fbParamList );
	F_READ_SENSOR_BAR(  P052, fbParamList );

	F_READ_SENSOR_TEMP( S011, fbParamList );
	F_READ_SENSOR_TEMP( S100, fbParamList );
	F_READ_SENSOR_TEMP( S101, fbParamList );
	F_READ_SENSOR_TEMP( S102, fbParamList );

	(*Water Ballast - Nodes...*)
	F_READ_SENSOR_POS( LS021, fbParamList );
	F_READ_SENSOR_POS( LS022, fbParamList );
	F_READ_SENSOR_POS( LS023, fbParamList );
	F_READ_SENSOR_POS( LS024, fbParamList );

	(*MF01 - Node42*)
	F_READ_SENSOR_BAR(  P101, fbParamList );
	F_READ_SENSOR_BAR(  P103, fbParamList );

	(*MF02 - Node34*)
	F_READ_SENSOR_BAR(  P201 , fbParamList );

	(*MF03 - Node43/44*)
	F_READ_SENSOR_BAR(  P301, fbParamList );
	F_READ_SENSOR_BAR(  P303, fbParamList );
	F_READ_SENSOR_BAR(  P305, fbParamList );
	F_READ_SENSOR_BAR(  P307, fbParamList );
	F_READ_SENSOR_BAR(  P309, fbParamList );
	F_READ_SENSOR_BAR(  P311, fbParamList );

	F_READ_SENSOR_POS( LS301, fbParamList );
	F_READ_SENSOR_POS( LS303, fbParamList );
	F_READ_SENSOR_POS( LS305, fbParamList );
	F_READ_SENSOR_POS( LS307, fbParamList );
	F_READ_SENSOR_POS( LS309, fbParamList );
	F_READ_SENSOR_POS( LS311, fbParamList );

	F_READ_SENSOR_KG(  L301, fbParamList );
	F_READ_SENSOR_KG(  L303, fbParamList );
	F_READ_SENSOR_KG(  L305, fbParamList );
	F_READ_SENSOR_KG(  L307, fbParamList );
	F_READ_SENSOR_KG(  L309, fbParamList );
	F_READ_SENSOR_KG(  L311, fbParamList );

	(*MF05 - Node41*)
	F_READ_SENSOR_BAR(  P501, fbParamList );
	F_READ_SENSOR_BAR(  P503, fbParamList );
	F_READ_SENSOR_BAR(  P505, fbParamList );
	F_READ_SENSOR_BAR(  P507, fbParamList );

	F_READ_SENSOR_KG(  L501, fbParamList );
	F_READ_SENSOR_KG(  L503, fbParamList );
	F_READ_SENSOR_KG(  L505, fbParamList );

	(*MF06 - Node20*)
	F_READ_SENSOR_BAR(  P601, fbParamList );
	F_READ_SENSOR_BAR(  P603, fbParamList );
	F_READ_SENSOR_BAR(  P605, fbParamList );
	F_READ_SENSOR_BAR(  P607, fbParamList );

	F_READ_SENSOR_POS( LS601, fbParamList );
	F_READ_SENSOR_POS( LS605, fbParamList );

	(*MF07 - Node21/22*)
	F_READ_SENSOR_BAR(  P701, fbParamList );
	F_READ_SENSOR_BAR(  P703, fbParamList );
	F_READ_SENSOR_BAR(  P705, fbParamList );
	F_READ_SENSOR_BAR(  P707, fbParamList );
	F_READ_SENSOR_BAR(  P709, fbParamList );

	F_READ_SENSOR_KG(  L701, fbParamList );
	F_READ_SENSOR_KG(  L703, fbParamList );
	F_READ_SENSOR_KG(  L705, fbParamList );
	F_READ_SENSOR_KG(  L707, fbParamList );
	F_READ_SENSOR_KG(  L709, fbParamList );

	F_READ_SENSOR_POS( LS707, fbParamList );
	F_READ_SENSOR_POS( LS709, fbParamList );

	(*MF08 - Node23*)
	F_READ_SENSOR_BAR(  P802, fbParamList );
	F_READ_SENSOR_BAR(  P804, fbParamList );

	F_READ_SENSOR_POS( LS801, fbParamList );
	F_READ_SENSOR_POS( LS803, fbParamList );

	(*MF09 - Node35*)
	F_READ_SENSOR_BAR(  P901, fbParamList );
	F_READ_SENSOR_BAR(  P903, fbParamList );

	F_READ_SENSOR_KG(  L901, fbParamList );
	F_READ_SENSOR_KG(  L903, fbParamList );

	F_READ_SENSOR_POS( LS901, fbParamList );
	F_READ_SENSOR_POS( LS903, fbParamList );

	(*MF10 - Node40*)
	F_READ_SENSOR_BAR(  P1001, fbParamList );
	F_READ_SENSOR_BAR(  P1002, fbParamList );

	F_READ_SENSOR_POS( LS1001, fbParamList );
	F_READ_SENSOR_POS( LS1002, fbParamList );

	(*MF11 - Node21*)
	F_READ_SENSOR_BAR(  P1101, fbParamList );
	F_READ_SENSOR_BAR(  P1102, fbParamList );
	F_READ_SENSOR_TEMP( S1100, fbParamList );

	(*MF12 - Node24/25*)
	F_READ_SENSOR_BAR(  P1202, fbParamList );
	F_READ_SENSOR_BAR(  P1203, fbParamList );
	F_READ_SENSOR_BAR(  P1204, fbParamList );
	F_READ_SENSOR_BAR(  P1205, fbParamList );
	F_READ_SENSOR_BAR(  P1206, fbParamList );
	F_READ_SENSOR_BAR(  P1207, fbParamList );
	F_READ_SENSOR_BAR(  P1208, fbParamList );
	F_READ_SENSOR_BAR(  P1209, fbParamList );
	F_READ_SENSOR_BAR(  P1210, fbParamList );
	F_READ_SENSOR_BAR(  P1211, fbParamList );
	F_READ_SENSOR_BAR(  P1212, fbParamList );
	F_READ_SENSOR_BAR(  P1213, fbParamList );
	F_READ_SENSOR_BAR(  P1214, fbParamList );
	F_READ_SENSOR_BAR(  P1215, fbParamList );
	F_READ_SENSOR_BAR(  P1216, fbParamList );
	F_READ_SENSOR_BAR(  P1219, fbParamList );

	(*MF13 - Node33 - Traveller*)
	F_READ_SENSOR_BAR(  P1301, fbParamList );
	F_READ_SENSOR_BAR(  P1302, fbParamList );

	F_READ_SENSOR_POS( LS1303, fbParamList );

	(*MF16 - Node34*)
	F_READ_SENSOR_BAR(  P1602, fbParamList );
	F_READ_SENSOR_BAR(  P1603, fbParamList );
	F_READ_SENSOR_BAR(  P1604, fbParamList );
	F_READ_SENSOR_BAR(  P1605, fbParamList );

	(*MF19 - Node32*)
	F_READ_SENSOR_POS( LS1905, fbParamList );

	(*MF20 - Node31*)
	F_READ_SENSOR_POS( LS2001, fbParamList );
	F_READ_SENSOR_POS( LS2005, fbParamList );

	(*MF22 - Node31*)
	F_READ_SENSOR_POS( LS2201, fbParamList );

	(*MF23 - Node30*)
	F_READ_SENSOR_POS( LS2301, fbParamList );
	F_READ_SENSOR_POS( LS2305, fbParamList );

	(*MF24 - Node29*)
	F_READ_SENSOR_POS( LS2401, fbParamList );
	F_READ_SENSOR_POS( LS2409, fbParamList );

	(*MF25 - Node26*)
	F_READ_SENSOR_BAR(  P2500, fbParamList );
	F_READ_SENSOR_POS( LS2501, fbParamList );
	F_READ_SENSOR_POS( LS2505, fbParamList );

	(*DGB Seal - Node48*)
	F_READ_SENSOR_BAR(  P_SealP, fbParamList );
	F_READ_SENSOR_BAR(  P_SealS, fbParamList );


	(*Next State*)
	fbParamList( bEnable := FALSE );
	fbParamList.sFilePath := '\Hard Disk\FTP\Parameters.txt';
	State := 120;

120: (*Load Parameters*)
	fbParamList( bEnable := TRUE );
	IF fbParamList.bInit THEN
		State := 130;
	ELSIF fbParamList.byError > 0 THEN
		Loaded := TRUE;
		Error  := TRUE;
		State  := 0;
	END_IF

130:(*Read PARAMETERS*)

(*1- Engine*)
	F_READ_ENGINE_CFG    ( 'Engine'    , MAIN.Cycle_Time, stEngineCfg    , fbParamList );
	F_READ_POWERPACK_CFG ( 'Powerpack' , MAIN.Cycle_Time, stPowerpackCfg , fbParamList );
	F_READ_PROPULSION_CFG( 'Propulsion', MAIN.Cycle_Time, stPropulsionCfg, fbParamList );


(*2- HP functions*)
	F_READ_SE_CYLINDER_POS_CFG	( 'A3Tack', MAIN.Cycle_Time, stSE301Cfg , fbParamList );
	F_READ_SE_CYLINDER_POS_CFG	( 'FrTack', MAIN.Cycle_Time, stSE303Cfg , fbParamList );
	F_READ_SE_CYLINDER_POS_CFG	( 'J5'    , MAIN.Cycle_Time, stSE305Cfg , fbParamList );
	F_READ_SE_CYLINDER_POS_CFG	( 'J4'    , MAIN.Cycle_Time, stSE307Cfg , fbParamList );
	F_READ_SE_CYLINDER_POS_CFG	( 'Fsy'   , MAIN.Cycle_Time, stSE309Cfg , fbParamList );
	F_READ_SE_CYLINDER_POS_CFG	( 'J2'    , MAIN.Cycle_Time, stSE311Cfg , fbParamList );

	F_READ_SE_CYLINDER_CFG		( 'JibIO' , MAIN.Cycle_Time, stSE501Cfg , fbParamList );
	F_READ_SE_CYLINDER_CFG		( 'JibUD' , MAIN.Cycle_Time, stSE503Cfg , fbParamList );
	F_READ_SE_CYLINDER_CFG		( 'Vang'  , MAIN.Cycle_Time, stSE505Cfg , fbParamList );

	F_READ_LIFT_PROP_CFG        ( 'PropUpDw', MAIN.Cycle_Time, stDE601Cfg, fbParamList );
	F_READ_DE_CYLINDER_POS_CFG	( 'TrimTab' , MAIN.Cycle_Time, stDE605Cfg, fbParamList );

	F_READ_SE_CYLINDER_CFG		( 'Inn'   , MAIN.Cycle_Time, stSE701Cfg , fbParamList );
	F_READ_SE_CYLINDER_CFG		( 'Out'   , MAIN.Cycle_Time, stSE703Cfg , fbParamList );
	F_READ_SE_CYLINDER_CFG		( 'Cunn'  , MAIN.Cycle_Time, stSE705Cfg , fbParamList );
	F_READ_SE_CYLINDER_POS_CFG	( 'Runn'  , MAIN.Cycle_Time, stSE707Cfg , fbParamList );
	F_READ_SE_CYLINDER_POS_CFG	( 'Chksy' , MAIN.Cycle_Time, stSE709Cfg , fbParamList );

	F_READ_SE_CYLINDER_POS_CFG	( 'BsyP'  , MAIN.Cycle_Time, stSE901Cfg , fbParamList );
	(*F_READ_SE_CYLINDER_POS_CFG	( 'BsyS'  , MAIN.Cycle_Time, stSE903Cfg , fbParamList );*)

(*3- Water Ballast*)
	F_READ_WB_CFG        ( 'WB'        , MAIN.Cycle_Time, stWBCfg        , fbParamList );
	F_READ_WB_VALVESF_CFG( 'WBValves'  , MAIN.Cycle_Time, stWBValveSFCfg , fbParamList );
	F_READ_WB_VALVELS_CFG( 'WBValvesLS', MAIN.Cycle_Time, stWBValveLSCfg , fbParamList );

(*4- LP Fucntions*)
	F_READ_WINCHE_CFG ( 'W1202', MAIN.Cycle_Time, stW1202Cfg, fbParamList );
	F_READ_WINCHE_CFG ( 'W1204', MAIN.Cycle_Time, stW1204Cfg, fbParamList );
	F_READ_WINCHE_CFG ( 'W1206', MAIN.Cycle_Time, stW1206Cfg, fbParamList );
	F_READ_WINCHE_CFG ( 'W1208', MAIN.Cycle_Time, stW1208Cfg, fbParamList );
	F_READ_WINCHE_CFG ( 'W1210', MAIN.Cycle_Time, stW1210Cfg, fbParamList );
	F_READ_WINCHE_CFG ( 'W1212', MAIN.Cycle_Time, stW1212Cfg, fbParamList );
	F_READ_WINCHE_CFG ( 'W1214', MAIN.Cycle_Time, stW1214Cfg, fbParamList );
	F_READ_WINCHE_CFG ( 'W1602', MAIN.Cycle_Time, stW1602Cfg, fbParamList );
	F_READ_WINCHE_CFG ( 'W1604', MAIN.Cycle_Time, stW1604Cfg, fbParamList );

	stWRampCfg.Spd_Min := F_IDLIST_GETREAL( 'WRAMP_Min', fbParamList );
	stWRampCfg.Spd_Inc := F_IDLIST_GETREAL( 'WRAMP_Inc', fbParamList );
	stWRampCfg.Spd_Dec := F_IDLIST_GETREAL( 'WRAMP_Dec', fbParamList );

	F_READ_BOARD_CFG    ( 'Board'    , MAIN.Cycle_Time, stBoardCfg    , fbParamList );
	F_READ_KEEL_CFG     ( 'Keel'     , MAIN.Cycle_Time, stKeelCfg     , fbParamList );
	F_READ_TRAVELLER_CFG( 'Traveller', MAIN.Cycle_Time, stTravellerCfg, fbParamList );

	F_READ_LP_FUNC_CFG( 'BowThr'    , MAIN.Cycle_Time, stBowThrCfg    , fbParamList );
	F_READ_LP_FUNC_CFG( 'BowThrUpDw', MAIN.Cycle_Time, stBowThrUpDwCfg, fbParamList );

	F_READ_TACK_VALVE_CFG ('TackValve', MAIN.Cycle_Time, stTackValveCfg, fbParamList );

	F_READ_MAST_SETUP_CFG ('MastSetup', MAIN.Cycle_Time, stMastSetup, fbParamList);

(*UDP Parameter*)
	sUDPSendHost := F_IDLIST_GETSTRING( 'UDPHost', fbParamList );
	nUDPSendPort := F_IDLIST_GETUDINT ( 'UDPPort', fbParamList );
	nUDPSendTime := F_IDLIST_GETUINT  ( 'UDPTime', fbParamList );
    nUDPRecvPort := F_IDLIST_GETUDINT ( 'UDPRecvPort', fbParamList );

	sUDPAlarmsHost := F_IDLIST_GETSTRING( 'UDPAlarmsHost', fbParamList );
	nUDPAlarmsPort := F_IDLIST_GETUDINT ( 'UDPAlarmsPort', fbParamList );

	(*Next State*)
	State := 300;

200: (*Create Sensors Buffer*)
	wBufPos := 0;

(*Sensors*)
	(*EVP PRESS VAR*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#EVP MAX PRESS VALVE:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'EVP313_K'   , S2:='$t', S3:= REAL_TO_STRING( EVP313.Cal_K    ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'EVP313_Off' , S2:='$t', S3:= REAL_TO_STRING( EVP313.Cal_Off  ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'EVP513_K'   , S2:='$t', S3:= REAL_TO_STRING( EVP513.Cal_K    ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'EVP513_Off' , S2:='$t', S3:= REAL_TO_STRING( EVP513.Cal_Off  ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'EVP709_K'   , S2:='$t', S3:= REAL_TO_STRING( EVP709.Cal_K    ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'EVP709_Off' , S2:='$t', S3:= REAL_TO_STRING( EVP709.Cal_Off  ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'EVP1005_K'  , S2:='$t', S3:= REAL_TO_STRING( EVP1005.Cal_K   ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'EVP1005_Off', S2:='$t', S3:= REAL_TO_STRING( EVP1005.Cal_Off ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'EVP1010_K'  , S2:='$t', S3:= REAL_TO_STRING( EVP1010.Cal_K   ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'EVP1010_Off', S2:='$t', S3:= REAL_TO_STRING( EVP1010.Cal_Off ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	(*TANK + GS + MF00 + PP - Node36/37*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#TANK + GS + MF00 + PP - Node36/37:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'SF_Delay', S2:='$t', S3:= REAL_TO_STRING( SF_Delay ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P010 );
	F_ADD_STRINGX4_TO_BUFFER( S1:= P010.Name , S2:='_Min$t', S3:= REAL_TO_STRING( P010.MinBar ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	F_WRITE_SENSOR_TEMP( BUF_SIZE, ADR(aBuffer), wBufPos, S011 );
	F_WRITE_SENSOR_TEMP( BUF_SIZE, ADR(aBuffer), wBufPos, S100 );
	F_WRITE_SENSOR_TEMP( BUF_SIZE, ADR(aBuffer), wBufPos, S101 );
	F_WRITE_SENSOR_TEMP( BUF_SIZE, ADR(aBuffer), wBufPos, S102 );

	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P001 );
	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P002 );
	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P003 );
	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P051 );
	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P052 );

	(*Water Ballast*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#Water Ballast - Node30/32:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS021 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS022 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS023 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS024 );

	(*MF01 - Node42*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF01 - Node42:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P101 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P103 );

	(*MF02 - Node34*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF02 - Node34:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P201  );

	(*MF03 - Node43/44*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF03 - Node43/44:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P301 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P303 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P305 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P307 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P309 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P311 );

	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS301 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS303 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS305 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS307 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS309 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS311 );

	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L301 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L303 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L305 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L307 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L309 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L311 );

	(*MF05 - Node41*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF05 - Node41:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P501 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P503 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P505 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P507 );

	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L501 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L503 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L505 );

	(*MF06 - Node20*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF06 - Node20:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P601 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P603 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P605 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P607 );

	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS601 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS605 );

	(*MF07 - Node21/22*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF07 - Node21/22:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P701 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P703 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P705 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P707 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P709 );

	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS707 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS709 );

	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L701 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L703 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L705 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L707 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L709 );

	(*MF08 - Node23*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF08 - Node23:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P802 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P804 );

	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS801 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS803 );

	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L901 );
	F_WRITE_SENSOR_KG( BUF_SIZE, ADR(aBuffer), wBufPos, L903 );

	(*MF09 - Node35*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF09 - Node35:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P901 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P903 );

	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS901 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS903 );

	(*MF10 - Node40*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF10 - Node40:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1001 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1002 );

	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS1001 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS1002 );

	(*MF11 - Node21*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF11 - Node21:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P1101 );
	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P1102 );
	F_WRITE_SENSOR_TEMP( BUF_SIZE, ADR(aBuffer), wBufPos, S1100 );


	(*MF12 - Node24/25*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF12 - Node24/25:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1202 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1203 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1204 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1205 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1206 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1207 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1208 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1209 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1210 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1211 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1212 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1213 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1214 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1215 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1216 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1219 );

	(*MF13 - Node33 - Traveller*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF13 - Node33:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1301 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1302 );

	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS1303 );

	(*MF16 - Node34*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF16 - Node34:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1602 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1603 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1604 );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos, P1605 );

	(*MF19 - Node32*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF19 - Node32:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS1905 );

	(*MF20 - Node31*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF20 - Node31:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2001 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2005 );

	(*MF22 - Node29*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF22 - Node29:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2201 );

	(*MF23 - Node30*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF23 - Node30:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2301 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2305 );

	(*MF24 - Node29*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF24 - Node29:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2401 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2409 );

	(*MF25 - Node26*)
	F_ADD_STRING_TO_BUFFER( S1:= '$n#MF25 - Node26:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_WRITE_SENSOR_BAR( BUF_SIZE, ADR(aBuffer), wBufPos,  P2500 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2501 );
	F_WRITE_SENSOR_POS( BUF_SIZE, ADR(aBuffer), wBufPos, LS2505 );

	(*DGB Seal - Node48*)
	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P_SealP );
	F_WRITE_SENSOR_BAR ( BUF_SIZE, ADR(aBuffer), wBufPos, P_SealS );


	(*Next State*)
	State := 210;

210: (*Save Sensors Buffer*)
	fbSaveList( bEnable:= TRUE, pBuffer:= ADR(aBuffer), wBufLen:= wBufPos );

	IF fbSaveList.bDone THEN
		State  := 220;
	END_IF

220: (*Create Parameters Buffer*)
	fbSaveList( bEnable:= FALSE );
	fbSaveList.sFilePath := '\Hard Disk\FTP\';
	fbSaveList.sFileName := 'Parameters';
	fbSaveList.sFileExt  := '.txt';
	fbSaveList.Backup    := TRUE;

	wBufPos := 0;

(*1-Engine*)
	F_WRITE_ENGINE_CFG    ( 'Engine'    , BUF_SIZE, ADR(aBuffer), wBufPos, stEngineCfg     );
	F_WRITE_POWERPACK_CFG ( 'Powerpack' , BUF_SIZE, ADR(aBuffer), wBufPos, stPowerpackCfg  );
	F_WRITE_PROPULSION_CFG( 'Propulsion', BUF_SIZE, ADR(aBuffer), wBufPos, stPropulsionCfg );

(*2- HP Fucntions*)
	F_WRITE_SE_CYLINDER_POS_CFG	( 'A3Tack', BUF_SIZE, ADR(aBuffer), wBufPos, stSE301Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'FrTack', BUF_SIZE, ADR(aBuffer), wBufPos, stSE303Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'J5'    , BUF_SIZE, ADR(aBuffer), wBufPos, stSE305Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'J4'    , BUF_SIZE, ADR(aBuffer), wBufPos, stSE307Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG ( 'Fsy'   , BUF_SIZE, ADR(aBuffer), wBufPos, stSE309Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'J2'    , BUF_SIZE, ADR(aBuffer), wBufPos, stSE311Cfg   );

	F_WRITE_SE_CYLINDER_CFG		( 'JibIO' , BUF_SIZE, ADR(aBuffer), wBufPos, stSE501Cfg   );
	F_WRITE_SE_CYLINDER_CFG		( 'JibUD' , BUF_SIZE, ADR(aBuffer), wBufPos, stSE503Cfg   );
	F_WRITE_SE_CYLINDER_CFG		( 'Vang'  , BUF_SIZE, ADR(aBuffer), wBufPos, stSE505Cfg   );

	F_WRITE_LIFT_PROP_CFG       ( 'PropUpDw', BUF_SIZE, ADR(aBuffer), wBufPos, stDE601Cfg );
	F_WRITE_DE_CYLINDER_POS_CFG	( 'TrimTab' , BUF_SIZE, ADR(aBuffer), wBufPos, stDE605Cfg );

	F_WRITE_SE_CYLINDER_CFG		( 'Inn'   , BUF_SIZE, ADR(aBuffer), wBufPos, stSE701Cfg   );
	F_WRITE_SE_CYLINDER_CFG		( 'Out'   , BUF_SIZE, ADR(aBuffer), wBufPos, stSE703Cfg   );
	F_WRITE_SE_CYLINDER_CFG		( 'Cunn'  , BUF_SIZE, ADR(aBuffer), wBufPos, stSE705Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'Runn'  , BUF_SIZE, ADR(aBuffer), wBufPos, stSE707Cfg   );
	F_WRITE_SE_CYLINDER_POS_CFG	( 'Chksy' , BUF_SIZE, ADR(aBuffer), wBufPos, stSE709Cfg   );

	F_WRITE_SE_CYLINDER_POS_CFG	( 'BsyP'  , BUF_SIZE, ADR(aBuffer), wBufPos, stSE901Cfg   );
	(*F_WRITE_SE_CYLINDER_POS_CFG	( 'BsyS'  , BUF_SIZE, ADR(aBuffer), wBufPos, stSE903Cfg   );*)

(*3- Water Ballast*)
	F_WRITE_WB_CFG        ( 'WB'        , BUF_SIZE, ADR(aBuffer), wBufPos, stWBCfg        );
	F_WRITE_WB_VALVESF_CFG( 'WBValves'  , BUF_SIZE, ADR(aBuffer), wBufPos, stWBValveSFCfg );
	F_WRITE_WB_VALVELS_CFG( 'WBValvesLS', BUF_SIZE, ADR(aBuffer), wBufPos, stWBValveLSCfg );

(*4- LP Functions*)
	F_WRITE_WINCHE_CFG ( 'W1202', BUF_SIZE, ADR(aBuffer), wBufPos, stW1202Cfg );
	F_WRITE_WINCHE_CFG ( 'W1204', BUF_SIZE, ADR(aBuffer), wBufPos, stW1204Cfg );
	F_WRITE_WINCHE_CFG ( 'W1206', BUF_SIZE, ADR(aBuffer), wBufPos, stW1206Cfg );
	F_WRITE_WINCHE_CFG ( 'W1208', BUF_SIZE, ADR(aBuffer), wBufPos, stW1208Cfg );
	F_WRITE_WINCHE_CFG ( 'W1210', BUF_SIZE, ADR(aBuffer), wBufPos, stW1210Cfg );
	F_WRITE_WINCHE_CFG ( 'W1212', BUF_SIZE, ADR(aBuffer), wBufPos, stW1212Cfg );
	F_WRITE_WINCHE_CFG ( 'W1214', BUF_SIZE, ADR(aBuffer), wBufPos, stW1214Cfg );
	F_WRITE_WINCHE_CFG ( 'W1602', BUF_SIZE, ADR(aBuffer), wBufPos, stW1602Cfg );
	F_WRITE_WINCHE_CFG ( 'W1604', BUF_SIZE, ADR(aBuffer), wBufPos, stW1604Cfg );

	F_ADD_STRINGX4_TO_BUFFER( S1:= 'WRAMP_Min', S2:='$t', S3:= REAL_TO_STRING( stWRampCfg.Spd_Min), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'WRAMP_Inc', S2:='$t', S3:= REAL_TO_STRING( stWRampCfg.Spd_Inc), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'WRAMP_Dec', S2:='$t', S3:= REAL_TO_STRING( stWRampCfg.Spd_Dec), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	F_WRITE_BOARD_CFG     ( 'Board'    , BUF_SIZE, ADR(aBuffer), wBufPos, stBoardCfg     );
	F_WRITE_KEEL_CFG      ( 'Keel'     , BUF_SIZE, ADR(aBuffer), wBufPos, stKeelCfg      );
	F_WRITE_TRAVELLER_CFG ( 'Traveller', BUF_SIZE, ADR(aBuffer), wBufPos, stTravellerCfg );

	F_WRITE_LP_FUNC_CFG ( 'BowThr'    , BUF_SIZE, ADR(aBuffer), wBufPos, stBowThrCfg     );
	F_WRITE_LP_FUNC_CFG ( 'BowThrUpDw', BUF_SIZE, ADR(aBuffer), wBufPos, stBowThrUpDwCfg );

	F_WRITE_TACK_VALVE_CFG ( 'TackValve', BUF_SIZE, ADR(aBuffer), wBufPos, stTackValveCfg );

	F_WRITE_MAST_SETUP_CFG ( 'MastSetup', BUF_SIZE, ADR(aBuffer), wBufPos, stMastSetup );


(*UDP Parameters*)
	F_ADD_STRING_TO_BUFFER  ( S1:= '$n#UDP Parameters:$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPHost', S2:='$t', S3:= sUDPSendHost                   , S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPPort', S2:='$t', S3:= UDINT_TO_STRING( nUDPSendPort ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPTime', S2:='$t', S3:= UINT_TO_STRING ( nUDPSendTime ), S4:='$n$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPRecvPort', S2:='$t', S3:= UDINT_TO_STRING( nUDPRecvPort ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPAlarmsHost', S2:='$t', S3:= sUDPAlarmsHost                   , S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );
	F_ADD_STRINGX4_TO_BUFFER( S1:= 'UDPAlarmsPort', S2:='$t', S3:= UDINT_TO_STRING( nUDPAlarmsPort ), S4:='$n', wSize := BUF_SIZE, pBuffer := ADR(aBuffer), wPos := wBufPos );

	(*Next State*)
	State := 230;


230: (*Save PArameters Buffer*)
	fbSaveList( bEnable:= TRUE, pBuffer:= ADR(aBuffer), wBufLen:= wBufPos );

	IF fbSaveList.bDone THEN
		(*Loaded := FALSE;*)	(*No hace falta hacer el Reload despues de save.*)
								(*En CK las rampas las calulo siempre.*)
		State  := 300;
	END_IF


300: (*Calule coefficents*)
	F_CALC_ENGINE_COEF    ( Cycle:= MAIN.Cycle_Time, Cfg:= stEngineCfg     );
	F_CALC_PROPULSION_COEF(                          Cfg:= stPropulsionCfg );
	F_CALC_KEEL_COEF      (                          Cfg:= stKeelCfg       );

	(*Next State*)
	Loaded := TRUE;
	State  := 0;

END_CASE
END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM POWERPACK
VAR
	fbPP1 : FB_POWERPACK;
	fbPP2 : FB_POWERPACK;

	NHP   : UINT;
	NSF   : UINT;
	NLP   : UINT;
	NW    : UINT;

	LP_Perc  : REAL;

	WinchReady : BOOL;

	LP_RPM  : REAL;
	HP_RPM  : REAL;
	TgtRPM  : REAL;

	PP1_HP : BOOL;
	PP1_LP : BOOL;
	PP2_HP : BOOL;
	PP2_LP : BOOL;

	Buzzer: BOOL;
	Mute  : BOOL;
	Bypass: BOOL;
	PP_Adver : BOOL;
	HP_Adver : BOOL;

	EV1502_Time : REAL;
	(*Calib*)
	Calib1 : BOOL;
	Calib2 : BOOL;
	CalThr : REAL;
	CalMax : REAL := 5.0;
	CalInc : REAL := 0.01;

END_VAR
(* @END_DECLARATION := '0' *)
THR_PP1 := 0.0;
THR_PP2 := 0.0;

KEY_PP1 := FALSE;
KEY_PP2 := FALSE;

EV101 := FALSE;
EV102 := FALSE;
EV103 := FALSE;
EV104 := FALSE;

(*Count Small Functions HP*)
NSF := MAIN.fbDE605.OUT_HP

	 + MAIN.fbWB_A.OUT_HP
	 + MAIN.fbWB_B.OUT_HP
	 + MAIN.fbWB_C.OUT_HP
	 + MAIN.fbWB_D.OUT_HP
	 + MAIN.fbWB_E.OUT_HP
	 + MAIN.fbWB_F.OUT_HP
	 + MAIN.fbWB_G.OUT_HP
	 + MAIN.fbWB_H.OUT_HP
	 + MAIN.fbWB_I.OUT_HP
	 + MAIN.fbWB_J.OUT_HP
	 + MAIN.fbWB_K.OUT_HP
	 + MAIN.fbWB_L.OUT_HP
	 + MAIN.fbWB_M.OUT_HP
	 + MAIN.fbWB_N.OUT_HP
	 + MAIN.fbWB_R.OUT_HP
	 + MAIN.fbWB_S.OUT_HP
	 + MAIN.fbWB_PUD.OUT_HP
	 + MAIN.fbWB_PAF.OUT_HP
	 + MAIN.fbWB_SUD.OUT_HP
	 + MAIN.fbWB_SAF.OUT_HP
;

(*Count All HP*)
NHP := NSF
	 + MAIN.fbSE301.OUT_HP
	 + MAIN.fbSE303.OUT_HP
	 + MAIN.fbSE305.OUT_HP
	 + MAIN.fbSE307.OUT_HP
	 + MAIN.fbSE309.OUT_HP
	 + MAIN.fbSE311.OUT_HP
	 + MAIN.fbSE501.OUT_HP
	 + MAIN.fbSE503.OUT_HP
	 + MAIN.fbSE505.OUT_HP
	 + MAIN.fbDE601.OUT_HP
(*	 + MAIN.fbDE605.OUT_HP*)
	 + MAIN.fbSE701.OUT_HP
	 + MAIN.fbSE703.OUT_HP
	 + MAIN.fbSE705.OUT_HP
	 + MAIN.fbSE707.OUT_HP
	 + MAIN.fbSE709.OUT_HP

     + MAIN.fbBSY.OUT_HP
(*	 + MAIN.fbSE901.OUT_HP
	 + MAIN.fbSE903.OUT_HP*)

(*	 + MAIN.fbWB_A.OUT_HP
	 + MAIN.fbWB_B.OUT_HP
	 + MAIN.fbWB_C.OUT_HP
	 + MAIN.fbWB_D.OUT_HP
	 + MAIN.fbWB_E.OUT_HP
	 + MAIN.fbWB_F.OUT_HP
	 + MAIN.fbWB_G.OUT_HP
	 + MAIN.fbWB_H.OUT_HP
	 + MAIN.fbWB_I.OUT_HP
	 + MAIN.fbWB_J.OUT_HP
	 + MAIN.fbWB_K.OUT_HP
	 + MAIN.fbWB_L.OUT_HP
	 + MAIN.fbWB_M.OUT_HP
	 + MAIN.fbWB_N.OUT_HP
	 + MAIN.fbWB_R.OUT_HP
	 + MAIN.fbWB_S.OUT_HP
	 + MAIN.fbWB_PUD.OUT_HP
	 + MAIN.fbWB_PAF.OUT_HP
	 + MAIN.fbWB_SUD.OUT_HP
	 + MAIN.fbWB_SAF.OUT_HP *)

	 + MAIN.fbTraveller.OUT_HP
;

(*Count LP*)
NW := MAIN.fbW1202.OUT_LP
	+ MAIN.fbW1204.OUT_LP
	+ MAIN.fbW1206.OUT_LP
	+ MAIN.fbW1208.OUT_LP
	+ MAIN.fbW1210.OUT_LP
	+ MAIN.fbW1212.OUT_LP
	+ MAIN.fbW1214.OUT_LP
	+ MAIN.fbW1602.OUT_LP
	+ MAIN.fbW1604.OUT_LP
;

NLP := NW
	+ MAIN.fbKeel.OUT_LP
	+ MAIN.fbBoard.OUT_LP
	+ MAIN.fbTraveller.OUT_LP

	+ MAIN.fbWB.OUT_LP

	+ MAIN.fbBowThr.OUT_LP
	+ MAIN.fbBowThrUpDw.OUT_LP
;

TgtRPM  := 0.0;
LP_RPM  := 0.0;
HP_RPM  := 0.0;

PP1_HP := FALSE;
PP1_LP := FALSE;
PP2_HP := FALSE;
PP2_LP := FALSE;


IF ENGINE.Engine_ON THEN
	LP_Perc := ENGINE.fbEngine.Available_Perc;

	(*Evaluate HP*)
	CASE NHP OF
	0:
		EV105 := FALSE;
		EV106 := FALSE;

	1:
		IF    MAIN.aSys_Enable[4] THEN EV105 := TRUE;
		ELSIF MAIN.aSys_Enable[5] THEN EV106 := TRUE;
		END_IF

	ELSE
		EV105 := MAIN.aSys_Enable[4];
		EV106 := MAIN.aSys_Enable[5];

	END_CASE

	(*	Any function only PP?? *)

	IF ENGINE.fbPropulsion.Idle THEN
		WinchReady := NW < PARAMS.stEngineCfg.N_Winch_WOP;

		IF NLP > 0 THEN
			IF MAIN.fbKeel.OUT_LP > 0 THEN
				WinchReady := NW < PARAMS.stEngineCfg.N_Winch_WK;
				LP_RPM := PARAMS.stEngineCfg.LP_CK_RPM;

			ELSIF NLP = 1 THEN LP_RPM := PARAMS.stEngineCfg.LP_1x_RPM;
			ELSIF NLP = 2 THEN LP_RPM := PARAMS.stEngineCfg.LP_2x_RPM;
			ELSIF NLP = 3 THEN LP_RPM := PARAMS.stEngineCfg.LP_3x_RPM;
			ELSE               LP_RPM := PARAMS.stEngineCfg.LP_Nx_RPM;
			END_IF
		END_IF

		IF NHP > 0 THEN
			IF NHP = NSF
			THEN HP_RPM := PARAMS.stEngineCfg.HP_SF_RPM;
			ELSE HP_RPM := PARAMS.stEngineCfg.HP_Nx_RPM;
			END_IF
		END_IF

		TgtRPM := MAX(LP_RPM, HP_RPM);

		IF TgtRPM = 0 THEN

		;

		(*
			Si no TgtRPM pero engine tiene RPM tgt interno sea del delay o del forced con el flag.
			comparo rango de RPM y habilito la Valvula 1611
			Tambien valvula 105 y el Link 107 mas abajo.

			Evaluo tambien la logica del EV1501 y EV1502 o igual solo EV1501 porque no tiene que haber presion.

			MEjor si meto una presion mazima medida en P101.
		*)
		END_IF

	ELSE
		WinchReady := NW < PARAMS.stEngineCfg.N_Winch_WP;

		IF MAIN.fbKeel.OUT_LP > 0 THEN
			PP1_LP := fbPP1.Enable;
			PP2_LP := fbPP2.Enable;
		END_IF

	END_IF

	EV1501 := FALSE;
	EV1502 := FALSE;

(*With PowerPack*)
ELSE
	LP_Perc  := 1;
	WinchReady := TRUE;

	(*Evaluate HP*)
	CASE NHP OF
	0:
		PP1_HP := FALSE;
		PP2_HP := FALSE;

	1:
		IF    fbPP1.Enable THEN PP1_HP := TRUE;
		ELSIF fbPP2.Enable THEN PP2_HP := TRUE;
		END_IF

	ELSE
		PP1_HP := fbPP1.Enable;
		PP2_HP := fbPP2.Enable;

	END_CASE

	(*Evaluate LP*)
	CASE NLP OF
	0:
		PP1_LP := FALSE;
		PP2_LP := FALSE;

	(*1:
		IF    fbPP1.Enable THEN PP1_LP := TRUE;
		ELSIF fbPP2.Enable THEN PP2_LP := TRUE;
		END_IF*)

	ELSE
		PP1_LP := fbPP1.Enable;
		PP2_LP := fbPP2.Enable;

	END_CASE

	EV1501 := PP1_LP OR PP2_LP;

	IF EV1501 = TRUE THEN
		EV1502_Time := 1.0;
		EV1502 := FALSE;

	ELSIF EV1502_Time > 0.0 THEN
		EV1502_Time := EV1502_Time - MAIN.Cycle_Time;
		EV1502 := TRUE;

	ELSE
		EV1502 := FALSE;

	END_IF

END_IF

(*POWERPACKS*)
fbPP1(
	Enable := MAIN.aSys_Enable[6] AND TANK.Enable AND (NOT S101.AlMax OR Bypass),

	IN_HP := PP1_HP,
	IN_LP := PP1_LP,

	LP_P := P101,
	HP_P := P103,
	CFG  := PARAMS.stPowerpackCfg,

	OUT_EV_HP => EV103,
	OUT_EV_LP => EV101,
(*	OUT_EV_LNK=> ,*)
	OUT_KEY   => KEY_PP1,
	OUT_THR   => THR_PP1
);

fbPP2(
	Enable := MAIN.aSys_Enable[7] AND TANK.Enable AND (NOT S102.AlMax OR Bypass),

	IN_HP := PP2_HP,
	IN_LP := PP2_LP,

	LP_P := P101,
	HP_P := P103,
	CFG  := PARAMS.stPowerpackCfg,

	OUT_EV_HP => EV104,
	OUT_EV_LP => EV102,
(*	OUT_EV_LNK=> ,*)
	OUT_KEY   => KEY_PP2,
	OUT_THR   => THR_PP2
);
(*Link*)
EV107 := fbPP1.OUT_EV_LNK OR fbPP2.OUT_EV_LNK;  (******ANADIR si hace falta para la vibracion**************)

(*Alarms*)
Mute   := Mute   AND S101.AlLow AND S102.AlLow;
Bypass := Bypass AND (NOT S101.AlMax OR NOT S102.AlMax);
Buzzer := TANK.Enable AND (S101.AlHig OR S102.AlHig OR S101.AlMax OR S102.AlMax) AND NOT MUTE;

(*THROTTLE CALIBRATION*)
IF Calib1 THEN
	Calib2 := FALSE;

	CalThr := CalThr + CalInc;
	IF CalThr > CalMax THEN CalThr := CalMax; END_IF

	THR_PP1 := CalThr;
	THR_PP2 := 0.0;

	KEY_PP1 := TRUE;
	KEY_PP2 := TRUE;

	EV101 := FALSE;
	EV102 := FALSE;
	EV103 := FALSE;
	EV104 := FALSE;
ELSE
	CalThr := 0.0;
END_IF

IF Calib2 THEN
	Calib1 := FALSE;

	CalThr := CalThr + CalInc;
	IF CalThr > CalMax THEN CalThr := CalMax; END_IF

	THR_PP1 := 0.0;
	THR_PP2 := CalThr;

	KEY_PP1 := TRUE;
	KEY_PP2 := TRUE;

	EV101 := FALSE;
	EV102 := FALSE;
	EV103 := FALSE;
	EV104 := FALSE;
ELSE
	CalThr := 0.0;
END_IF

END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM RECV_J1939
VAR
	i: INT;
	State : WORD;

	F003: FB_DECODE_F003;
	F004: FB_DECODE_F004;
	FEDB: FB_DECODE_FEDB;
	FEE5: FB_DECODE_FEE5;
	FEEE: FB_DECODE_FEEE;
	FEEF: FB_DECODE_FEEF;
	FEF2: FB_DECODE_FEF2;
	FEF6: FB_DECODE_FEF6;
	FEF7: FB_DECODE_FEF7;

	RxFrame: VARTYPE_EXTCANQUEUE;
	MaskID : DWORD;

	rxData: ARRAY [0..7] OF USINT; (*for debug*)


(*VISUALIZATION*)
(*	 vF003 : CobIdDataVisualize;
	strF003 : STRING;
	 vF004 : CobIdDataVisualize;
	strF004 : STRING;
	 vFEEE : CobIdDataVisualize;
	strFEEE : STRING;
*)
END_VAR
(* @END_DECLARATION := '0' *)
(*Receiving block*)
IF J1939_Outputs.RxCounter <> J1939_Inputs.RxCounter THEN
	FOR i := 0 TO (J1939_Inputs.NoOfRxMessages-1) BY 1 DO
		MEMCPY( destAddr := ADR(RxFrame.length ), srcAddr := ADR(J1939_Inputs.RxMessages[i]), n := 14 );

		MaskID := RxFrame.cobId AND 16#01FFFF00;

		(*Case structure to catch specific CobId and parse data from it*)
		CASE MaskID OF

		16#00F00400:(*Electronic Engine Controller 1: EEC1, every 20ms*)
			F004( IN:= RxFrame.RxData );
			(*vF004(rxData:=ADR(RxFrame.RxData) , strRxData=>strF004 );*)

		16#00F00300: (*Electronic Engine Controller 2: EEC2, every 50ms*)
			F003( IN:= RxFrame.RxData );
			(*vF003(rxData:=ADR(RxFrame.RxData) , strRxData=>strF003 );*)

		16#00FEDB00: (*Engine Injector Metering Rail 1 Pressure, every 500ms*)
			FEDB( IN:= RxFrame.RxData );

		16#00FEE500: (*Engine Hours, Revolutions HOURS, *)
			FEE5( IN:= RxFrame.RxData );

		16#00FEEE00: (*Engine Temperature, every 1000ms*)
			FEEE( IN:= RxFrame.RxData );

		16#00FEEF00: (*Engine Fluid Level / Pressure, every 100ms*)
			FEEF( IN:= RxFrame.RxData );

		16#00FEF200: (*Fuel Economy (Liquid) LFE1, every 500ms*)
			FEF2( IN:= RxFrame.RxData );

		16#00FEF600: (*Inlet / Exhaust Conditions #1: IEC1, every 500ms*)
			FEF6( IN:= RxFrame.RxData );

		16#00FEF700: (*Vehicle Electrical Power, every 1000ms*)
			FEF7( IN:= RxFrame.RxData );

			(*MEMCPY( destAddr := ADR(rxData), srcAddr := ADR(RxFrame.RxData), n := 8 );*)


		END_CASE
	END_FOR

	J1939_Outputs.RxCounter := J1939_Outputs.RxCounter+1;
END_IF

State := CAN1_State;
State := State AND 16#00FF;
END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM SEND_J1939
VAR
	i: INT;
	iToSend  : INT;
	aTxFrame : ARRAY [0..9] OF VARTYPE_EXTCANQUEUE;

	fbFF70 : FB_CODE_FF70;

	PedalPerc  : REAL;
	PedalFault : BOOL;
END_VAR
(* @END_DECLARATION := '0' *)

(*2800 = 100%*)
PedalPerc  := ENGINE.fbEngine.Engine_RPM * 0.04504504505 - 30.63063063; (*NEW*)
(*PedalPerc  := ENGINE.fbEngine.Engine_RPM * 0.0448 - 31.883;*)
(*PedalFault := NOT fbEngine.Enable;*)

(*Engine Pedal frame*)
fbFF70(
	Enable := ENGINE.fbEngine.Enable,
	Source     := 16#10,
	PedalPerc  := PedalPerc,
	PedalID    := 0,
	PedalFault := PedalFault,

	TaskTime     := 5,
	TransmitTime := 50
);

IF fbFF70.OUT_Enable THEN
	IF iToSend < 10 THEN
		aTxFrame[iToSend] := fbFF70.OUT;
		iToSend := iToSend + 1;
	END_IF
END_IF

(*SendingCAN*)
IF J1939_Outputs.TxCounter = J1939_Inputs.TxCounter AND iToSend > 0 THEN
	FOR i := 0 TO iToSend-1 BY 1 DO
		MEMCPY( destAddr := ADR(J1939_Outputs.TxMessages[i] ), srcAddr := ADR(aTxFrame[i].length), n := 14 );
	END_FOR

	J1939_Outputs.NoOfTxMessages := iToSend;
	J1939_Outputs.TxCounter      := J1939_Outputs.TxCounter + 1;

	iToSend := 0;
END_IF

END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM TANK
VAR
	Enable : BOOL;
	Buzzer : BOOL;

	Reduced: BOOL; (*Fuerza a las funcones  atrabajar de modo reducido de flujo, Limitacion sobre winches  y sobre el motor?*)
				   (*Solo propulsion o solo hidraulica, y ademas, solo 1 PP*)

	SF002_Mute : BOOL;
	 P010_Mute : BOOL;
	 S011_Mute : BOOL;

	BypassLevel : BOOL;

	TankEnable: BOOL;
END_VAR
(* @END_DECLARATION := '0' *)

SF002_Mute := SF002_Mute AND SF002.Alarm.Alarm;
 P010_Mute := P010_Mute  AND (P010.AlMax OR P010.AlMin);
 S011_Mute := S011_Mute  AND  S011.AlLow;

IF NOT MAIN.aSys_Enable[2] AND NOT MAIN.aSys_Enable[3] THEN
	BypassLevel := FALSE;
END_IF

(*Conclusion*)
Enable := PARAMS.Loaded
	AND NOT SF000.Alarm.Alarm							(*Emergency button*)
	AND NOT SF001.Alarm.Alarm							(*Main Return*)
	AND (NOT SF009.Alarm.Alarm OR  BypassLevel)			(*Level*)
	AND NOT (SF003.Alarm.Alarm AND SF004.Alarm.Alarm) 	(*Return1*)
	AND NOT (SF005.Alarm.Alarm AND SF006.Alarm.Alarm) 	(*Return2*)
	AND NOT (SF007.Alarm.Alarm AND SF008.Alarm.Alarm)	(*Suction*)
	AND NOT (SF007.Alarm.Alarm AND (SF004.Alarm.Alarm OR SF006.Alarm.Alarm))
	AND NOT (SF008.Alarm.Alarm AND (SF003.Alarm.Alarm OR SF005.Alarm.Alarm))
	AND NOT S011.AlMax
;

Enable := Enable AND MAIN.aSys_Enable[1];

Reduced := Enable AND
	 ( SF003.Alarm.Alarm
	OR SF004.Alarm.Alarm
	OR SF005.Alarm.Alarm
	OR SF006.Alarm.Alarm
	OR SF007.Alarm.Alarm
	OR SF008.Alarm.Alarm
);

Buzzer := MAIN.aSys_Enable[1] AND (
	   NOT SF002_Mute AND SF002.Alarm.Alarm
	OR NOT  P010_Mute AND (P010.AlMax OR P010.AlMin)
	OR NOT  S011_Mute AND  S011.AlHig
	OR S011.AlMax
);

(*Enable := TRUE; *)

END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM TOFARO
VAR CONSTANT
	UDP_BUF_SIZE  : WORD := 4096;

END_VAR
VAR
	fbUdpSend        : FB_UDP_SEND;
	fbUdpRecv        : FB_UDP_RECV;
	fbSocketCloseAll : FB_SocketCloseAll;
    bCloseAll 	     : BOOL := TRUE;

	Send_Id          : DWORD;
	Send_NumberOfVars: WORD;
	Send_Offset      : WORD;
	Send_Buffer      : ARRAY[0..UDP_BUF_SIZE] OF BYTE;

	AuxVar : REAL;

	Recv_Id          : DWORD;
	Recv_NumberOfVars: WORD;
	Recv_Offset      : WORD;
	Recv_Buffer      : ARRAY[0..UDP_BUF_SIZE] OF BYTE;
	Recv_ToggleOLD   : BOOL;
	Recv_OldId       : DWORD;
	NoRecv_Cnt       : REAL;
	Recv_Live        : BOOL;

	rBar1 : REAL;
	rBar2 : REAL;
	rHeel : REAL;

	rRunP : REAL;
	rPriP : REAL;
	rMain : REAL;
	rRunS : REAL;
	rPriS : REAL;
	rSecP : REAL;
	rSecS : REAL;



END_VAR
(* @END_DECLARATION := '0' *)
(*UDP STREAMING*)
IF bCloseAll THEN (*On PLC reset or program download close all old connections *)
	bCloseAll := FALSE;
	fbUdpSend( bEnable:= FALSE );
	fbSocketCloseAll( bExecute:= TRUE, tTimeout:= T#10s );

	Recv_Live := FALSE;
ELSE
	fbSocketCloseAll( bExecute:= FALSE );
END_IF

IF NOT fbSocketCloseAll.bBusy THEN

(* UDP Inputs *)
	fbUdpRecv(
		bEnable    := TRUE,
		nLocalPort := PARAMS.nUDPRecvPort,
		pBuffer    := ADR(Recv_Buffer),
		wBufLen    := UDP_BUF_SIZE,
	);

	IF fbUdpRecv.bRecToggle <> Recv_ToggleOLD THEN
		Recv_ToggleOLD := fbUdpRecv.bRecToggle;

		IF fbUdpRecv.nRecBytes >= 48 THEN (* 10*4 + 8 Check size*)
			MEMCPY( ADR(Recv_Id          ), ADR(Recv_Buffer[0]), 4);
			MEMCPY( ADR(Recv_NumberOfVars), ADR(Recv_Buffer[4]), 2);
			MEMCPY( ADR(Recv_Offset      ), ADR(Recv_Buffer[6]), 2);

			(* 1*) MEMCPY( ADR(rBar1) , ADR(Recv_Buffer[ 8]), 4);
			(* 2*) MEMCPY( ADR(rBar2) , ADR(Recv_Buffer[12]), 4);
			(* 3*) MEMCPY( ADR(rHeel) , ADR(Recv_Buffer[16]), 4);
			(* 4*) MEMCPY( ADR(rRunP) , ADR(Recv_Buffer[20]), 4);
			(* 5*) MEMCPY( ADR(rPriP) , ADR(Recv_Buffer[24]), 4);
			(* 6*) MEMCPY( ADR(rMain) , ADR(Recv_Buffer[28]), 4);
			(* 7*) MEMCPY( ADR(rRunS) , ADR(Recv_Buffer[32]), 4);
			(* 8*) MEMCPY( ADR(rPriS) , ADR(Recv_Buffer[36]), 4);
			(* 9*) MEMCPY( ADR(rSecP) , ADR(Recv_Buffer[40]), 4);
			(*10*) MEMCPY( ADR(rSecS) , ADR(Recv_Buffer[44]), 4);

		END_IF
	END_IF

	IF Recv_Id <> Recv_OldId THEN
		NoRecv_Cnt := 0;
		Recv_OldId := Recv_Id;
		Recv_Live  := TRUE;
	ELSE
		NoRecv_Cnt := NoRecv_Cnt + MAIN.Cycle_Time;
	END_IF

	IF NoRecv_Cnt > 1 THEN
		Recv_Live := FALSE;
	END_IF

	IF NoRecv_Cnt > 10 THEN
		bCloseAll  := TRUE;
		NoRecv_Cnt := 0;
	END_IF

(*UDP Outputs*)
	IF fbUdpSend.eStep = UDP_STATE_SEND_START AND PARAMS.nUDPSendTime > 0 THEN

		(*Press Sensors*)
		(* 1*)MEMCPY( ADR(Send_Buffer[  8]), ADR(  P010.Bar ), 4); (*Tank*)
		(* 2*)MEMCPY( ADR(Send_Buffer[ 12]), ADR(  P101.Bar ), 4); (*PowerPack Low Press. Line*)
		(* 3*)MEMCPY( ADR(Send_Buffer[ 16]), ADR(  P103.Bar ), 4); (*Main High Press. Line*)
		(* 4*)MEMCPY( ADR(Send_Buffer[ 20]), ADR(  P201.Bar ), 4); (*Main Low Press. Line*)

		(* 5*)MEMCPY( ADR(Send_Buffer[ 24]), ADR(  P301.Bar ), 4); (*A3 Tack*)
		(* 6*)MEMCPY( ADR(Send_Buffer[ 28]), ADR(  P303.Bar ), 4); (*FRO Tack*)
		(* 7*)MEMCPY( ADR(Send_Buffer[ 32]), ADR(  P305.Bar ), 4); (*J5*)
		(* 8*)MEMCPY( ADR(Send_Buffer[ 36]), ADR(  P307.Bar ), 4); (*J4*)
		(* 9*)MEMCPY( ADR(Send_Buffer[ 40]), ADR(  P309.Bar ), 4); (*Forastay*)
		(*10*)MEMCPY( ADR(Send_Buffer[ 44]), ADR(  P311.Bar ), 4); (*J2*)

		(*11*)MEMCPY( ADR(Send_Buffer[ 48]), ADR(  P501.Bar ), 4); (*Jib InOut*)
		(*12*)MEMCPY( ADR(Send_Buffer[ 52]), ADR(  P503.Bar ), 4); (*Jib UpDw*)
		(*13*)MEMCPY( ADR(Send_Buffer[ 56]), ADR(  P505.Bar ), 4); (*Vang*)

		(*14*)MEMCPY( ADR(Send_Buffer[ 60]), ADR(  P601.Bar ), 4); (*Propulsion Dw*)
		(*15*)MEMCPY( ADR(Send_Buffer[ 64]), ADR(  P603.Bar ), 4); (*Propulsion Up*)
		(*16*)MEMCPY( ADR(Send_Buffer[ 68]), ADR(  P605.Bar ), 4); (*Trim Tab Out*)
		(*17*)MEMCPY( ADR(Send_Buffer[ 72]), ADR(  P607.Bar ), 4); (*Trim Tab In*)

		(*18*)MEMCPY( ADR(Send_Buffer[ 76]), ADR(  P701.Bar ), 4); (*Inner Staysail*)
		(*19*)MEMCPY( ADR(Send_Buffer[ 80]), ADR(  P703.Bar ), 4); (*Outhau*)
		(*20*)MEMCPY( ADR(Send_Buffer[ 84]), ADR(  P705.Bar ), 4); (*Main Cunningham*)
		(*21*)MEMCPY( ADR(Send_Buffer[ 88]), ADR(  P707.Bar ), 4); (*Bottom Deflectorl*)
		(*22*)MEMCPY( ADR(Send_Buffer[ 92]), ADR(  P709.Bar ), 4); (*Top Deflector*)

		(*23*)MEMCPY( ADR(Send_Buffer[ 96]), ADR(  P802.Bar ), 4); (*Daggerborad Port Pump*)
		(*24*)MEMCPY( ADR(Send_Buffer[100]), ADR(  P804.Bar ), 4); (*Daggerborad Stbd Pump*)

		(*25*)MEMCPY( ADR(Send_Buffer[104]), ADR(  P901.Bar ), 4); (*Backstay Tail Port*)
		(*26*)MEMCPY( ADR(Send_Buffer[108]), ADR(  P903.Bar ), 4); (*Backstay Tail Stbd*)

		(*27*)MEMCPY( ADR(Send_Buffer[112]), ADR( P1001.Bar ), 4); (*Keel IN*)
		(*28*)MEMCPY( ADR(Send_Buffer[116]), ADR( P1002.Bar ), 4); (*Keel OUT*)

		(*29*)MEMCPY( ADR(Send_Buffer[120]), ADR( P1101.Bar ), 4); (*Propulsion*)
		(*30*)MEMCPY( ADR(Send_Buffer[124]), ADR( P1102.Bar ), 4); (*Propulsion*)

		(*31*)MEMCPY( ADR(Send_Buffer[128]), ADR( P1202.Bar ), 4); (*Primary Winch Stbd A*)
		(*32*)MEMCPY( ADR(Send_Buffer[132]), ADR( P1203.Bar ), 4); (*Primary Winch Stbd B*)
		(*33*)MEMCPY( ADR(Send_Buffer[136]), ADR( P1204.Bar ), 4); (*Pit Winch Stbd A*)
		(*34*)MEMCPY( ADR(Send_Buffer[140]), ADR( P1205.Bar ), 4); (*Pit Winch Stbd B*)
		(*35*)MEMCPY( ADR(Send_Buffer[144]), ADR( P1206.Bar ), 4); (*Mainsheet Winch A*)
		(*36*)MEMCPY( ADR(Send_Buffer[148]), ADR( P1207.Bar ), 4); (*Mainsheet Winch B*)
		(*37*)MEMCPY( ADR(Send_Buffer[152]), ADR( P1208.Bar ), 4); (*Runner Winch Port A*)
		(*38*)MEMCPY( ADR(Send_Buffer[156]), ADR( P1209.Bar ), 4); (*Runner Winch Port B*)
		(*39*)MEMCPY( ADR(Send_Buffer[160]), ADR( P1210.Bar ), 4); (*Primary Winch Port A*)
		(*40*)MEMCPY( ADR(Send_Buffer[164]), ADR( P1211.Bar ), 4); (*Primary Winch Port B*)
		(*41*)MEMCPY( ADR(Send_Buffer[168]), ADR( P1212.Bar ), 4); (*Secondary Winch Port A*)
		(*42*)MEMCPY( ADR(Send_Buffer[172]), ADR( P1213.Bar ), 4); (*Secondary Winch Port B*)
		(*43*)MEMCPY( ADR(Send_Buffer[176]), ADR( P1214.Bar ), 4); (*Pit Winch Port	A*)
		(*44*)MEMCPY( ADR(Send_Buffer[180]), ADR( P1215.Bar ), 4); (*Pit Winch Port	B*)
		(*45*)MEMCPY( ADR(Send_Buffer[184]), ADR( P1216.Bar ), 4); (*Daggerborad Port Ease*)
		(*46*)MEMCPY( ADR(Send_Buffer[188]), ADR( P1219.Bar ), 4); (*Daggerborad Stbd Ease*)

		(*47*)MEMCPY( ADR(Send_Buffer[192]), ADR( P1301.Bar ), 4); (*Traveller A*)
		(*48*)MEMCPY( ADR(Send_Buffer[196]), ADR( P1302.Bar ), 4); (*Traveller B*)

		(*49*)MEMCPY( ADR(Send_Buffer[200]), ADR( P1602.Bar ), 4); (*Runner Winch Stbd A*)
		(*50*)MEMCPY( ADR(Send_Buffer[204]), ADR( P1603.Bar ), 4); (*Runner Winch Stbd B*)
		(*51*)MEMCPY( ADR(Send_Buffer[208]), ADR( P1604.Bar ), 4); (*Secondary Winch Stbd A*)
		(*52*)MEMCPY( ADR(Send_Buffer[212]), ADR( P1605.Bar ), 4); (*Secondary Winch Stbd B*)

		(*Position Sensors*)
		(*53*)MEMCPY( ADR(Send_Buffer[216]), ADR(  LS301.Pos ), 4); (*A3 Tack*)
		(*54*)MEMCPY( ADR(Send_Buffer[220]), ADR(  LS303.Pos ), 4); (*FRO Tack*)
		(*55*)MEMCPY( ADR(Send_Buffer[224]), ADR(  LS305.Pos ), 4); (*J5*)
		(*56*)MEMCPY( ADR(Send_Buffer[228]), ADR(  LS307.Pos ), 4); (*J4*)
		(*57*)MEMCPY( ADR(Send_Buffer[232]), ADR(  LS309.Pos ), 4); (*Forastay*)
		(*58*)MEMCPY( ADR(Send_Buffer[236]), ADR(  LS311.Pos ), 4); (*J2*)

		(*59*)MEMCPY( ADR(Send_Buffer[240]), ADR(  LS601.Pos ), 4); (*Propulsion*)
		(*60*)MEMCPY( ADR(Send_Buffer[244]), ADR(  LS605.Pos ), 4); (*Trim Tab*)

		(*61*)MEMCPY( ADR(Send_Buffer[248]), ADR(  LS707.Pos ), 4); (*Bottom Deflector*)
		(*62*)MEMCPY( ADR(Send_Buffer[252]), ADR(  LS709.Pos ), 4); (*Top Deflector*)

		(*63*)MEMCPY( ADR(Send_Buffer[256]), ADR(  LS801.Pos ), 4); (*Daggerboard Port*)
		(*64*)MEMCPY( ADR(Send_Buffer[260]), ADR(  LS803.Pos ), 4); (*Daggerboard Stbd*)

		(*65*)MEMCPY( ADR(Send_Buffer[264]), ADR(  LS901.Pos ), 4); (*Backstay Tail Port*)
		(*66*)MEMCPY( ADR(Send_Buffer[268]), ADR(  LS903.Pos ), 4); (*Backstay Tail Stbd*)

		(*67*)MEMCPY( ADR(Send_Buffer[272]), ADR( LS1001.Pos ), 4); (*Keel Main*)
		(*68*)MEMCPY( ADR(Send_Buffer[276]), ADR( LS1002.Pos ), 4); (*Keel Recovery*)

		(*69*)MEMCPY( ADR(Send_Buffer[280]), ADR( LS1303.Pos ), 4); (*Traveller*)

		(*Water Ballast*)
		(*70*)MEMCPY( ADR(Send_Buffer[284]), ADR( LS021.Pos ), 4); (*Aft. Tank (Port)*)
		(*71*)MEMCPY( ADR(Send_Buffer[288]), ADR( LS022.Pos ), 4); (*Fwd. Tank (Port)*)
		(*72*)MEMCPY( ADR(Send_Buffer[292]), ADR( LS023.Pos ), 4); (*Aft. Tank (Stbd)*)
		(*73*)MEMCPY( ADR(Send_Buffer[296]), ADR( LS024.Pos ), 4); (*Fwd. Tank (Stbd)*)

		(*Engine*)
		(*74*)MEMCPY( ADR(Send_Buffer[300]), ADR( RECV_J1939.F004.EngineActualSpeed        ), 4); (*Engine Speed RPM*)
			  AuxVar := SINT_TO_REAL( RECV_J1939.F004.EngineActualTorque );
		(*75*)MEMCPY( ADR(Send_Buffer[304]), ADR( AuxVar                                   ), 4); (*Engine Torque %*)
		(*76*)MEMCPY( ADR(Send_Buffer[308]), ADR( RECV_J1939.FEEE.EngineCoolantTemperature ), 4); (*Engine Coolant Temp*)
		(*77*)MEMCPY( ADR(Send_Buffer[312]), ADR( RECV_J1939.FEEF.EngineOilPressure        ), 4); (*Engine Oil Press kPa*)
		(*78*)MEMCPY( ADR(Send_Buffer[316]), ADR( Prop_RPM                                 ), 4); (*Propulsion RPM*)

		(*Tank*)
		(*79*)MEMCPY( ADR(Send_Buffer[320]), ADR( S011.Deg ), 4); (*Oil Tank Temp*)

			  IF    MAIN.fbBowThrUpDw.IN_SF1 THEN AuxVar :=   0.0;
			  ELSIF MAIN.fbBowThrUpDw.IN_SF2 THEN AuxVar := 100.0;
			  ELSE                                AuxVar :=  50.0;
			  END_IF

		(*80*)MEMCPY( ADR(Send_Buffer[324]), ADR( AuxVar ), 4); (*BowThrUpDw*)

		(*HP VALVES*)
		(*81*)MEMCPY( ADR(Send_Buffer[328]), ADR( MAIN.fbSE301.ToFaroValue ), 4);
		(*82*)MEMCPY( ADR(Send_Buffer[332]), ADR( MAIN.fbSE303.ToFaroValue ), 4);
		(*83*)MEMCPY( ADR(Send_Buffer[336]), ADR( MAIN.fbSE305.ToFaroValue ), 4);
		(*84*)MEMCPY( ADR(Send_Buffer[340]), ADR( MAIN.fbSE307.ToFaroValue ), 4);
		(*85*)MEMCPY( ADR(Send_Buffer[344]), ADR( MAIN.fbSE309.ToFaroValue ), 4);
		(*86*)MEMCPY( ADR(Send_Buffer[348]), ADR( MAIN.fbSE311.ToFaroValue ), 4);

		(*87*)MEMCPY( ADR(Send_Buffer[352]), ADR( MAIN.fbSE501.ToFaroValue ), 4);
		(*88*)MEMCPY( ADR(Send_Buffer[356]), ADR( MAIN.fbSE503.ToFaroValue ), 4);
		(*89*)MEMCPY( ADR(Send_Buffer[360]), ADR( MAIN.fbSE505.ToFaroValue ), 4);

		(*90*)MEMCPY( ADR(Send_Buffer[364]), ADR( MAIN.fbDE601.ToFaroValue ), 4);
		(*91*)MEMCPY( ADR(Send_Buffer[368]), ADR( MAIN.fbDE605.ToFaroValue ), 4);

		(*92*)MEMCPY( ADR(Send_Buffer[372]), ADR( MAIN.fbSE701.ToFaroValue ), 4);
		(*93*)MEMCPY( ADR(Send_Buffer[376]), ADR( MAIN.fbSE703.ToFaroValue ), 4);
		(*94*)MEMCPY( ADR(Send_Buffer[380]), ADR( MAIN.fbSE705.ToFaroValue ), 4);
		(*95*)MEMCPY( ADR(Send_Buffer[384]), ADR( MAIN.fbSE707.ToFaroValue ), 4);
		(*96*)MEMCPY( ADR(Send_Buffer[388]), ADR( MAIN.fbSE709.ToFaroValue ), 4);

		(*97*)MEMCPY( ADR(Send_Buffer[392]), ADR( MAIN.fbBSY.ToFaroValueP ), 4);
		(*98*)MEMCPY( ADR(Send_Buffer[396]), ADR( MAIN.fbBSY.ToFaroValueS ), 4);

		(*99*)MEMCPY( ADR(Send_Buffer[400]), ADR( MAIN.fbTraveller.ToFaroValue ), 4);

		(*LP VALVES*)
		(*100*)AuxVar := UINT_TO_REAL(EVP001); MEMCPY( ADR(Send_Buffer[404]), ADR( AuxVar ), 4);
		(*101*)AuxVar := UINT_TO_REAL(EVP002); MEMCPY( ADR(Send_Buffer[408]), ADR( AuxVar ), 4);

		(*102*)AuxVar := INT_TO_REAL(EVP1202_3); MEMCPY( ADR(Send_Buffer[412]), ADR( AuxVar ), 4);
		(*103*)AuxVar := INT_TO_REAL(EVP1204_5); MEMCPY( ADR(Send_Buffer[416]), ADR( AuxVar ), 4);
		(*104*)AuxVar := INT_TO_REAL(EVP1206_7); MEMCPY( ADR(Send_Buffer[420]), ADR( AuxVar ), 4);
		(*105*)AuxVar := INT_TO_REAL(EVP1208_9); MEMCPY( ADR(Send_Buffer[424]), ADR( AuxVar ), 4);
		(*106*)AuxVar := INT_TO_REAL(EVP1210_1); MEMCPY( ADR(Send_Buffer[428]), ADR( AuxVar ), 4);
		(*107*)AuxVar := INT_TO_REAL(EVP1212_3); MEMCPY( ADR(Send_Buffer[432]), ADR( AuxVar ), 4);
		(*108*)AuxVar := INT_TO_REAL(EVP1214_5); MEMCPY( ADR(Send_Buffer[436]), ADR( AuxVar ), 4);
		(*109*)AuxVar := INT_TO_REAL(EVP1216_7); MEMCPY( ADR(Send_Buffer[440]), ADR( AuxVar ), 4);
		(*110*)AuxVar := INT_TO_REAL(EVP1218_9); MEMCPY( ADR(Send_Buffer[444]), ADR( AuxVar ), 4);
		(*111*)AuxVar := INT_TO_REAL(EVP1220_1); MEMCPY( ADR(Send_Buffer[448]), ADR( AuxVar ), 4);

		(*112*)AuxVar := INT_TO_REAL(EVP402_3); MEMCPY( ADR(Send_Buffer[452]), ADR( AuxVar ), 4);
		(*113*)AuxVar := INT_TO_REAL(EVP404_5); MEMCPY( ADR(Send_Buffer[456]), ADR( AuxVar ), 4);
		(*114*)AuxVar := INT_TO_REAL(EVP406_7); MEMCPY( ADR(Send_Buffer[460]), ADR( AuxVar ), 4);

		(*115*)AuxVar := INT_TO_REAL(EVP1602_3); MEMCPY( ADR(Send_Buffer[464]), ADR( AuxVar ), 4);
		(*116*)AuxVar := INT_TO_REAL(EVP1604_5); MEMCPY( ADR(Send_Buffer[468]), ADR( AuxVar ), 4);
		(*117*)AuxVar := INT_TO_REAL(EVP1606_7); MEMCPY( ADR(Send_Buffer[472]), ADR( AuxVar ), 4);
		(*118*)AuxVar := INT_TO_REAL(EVP1608_9); MEMCPY( ADR(Send_Buffer[476]), ADR( AuxVar ), 4);
		(*119*)AuxVar := INT_TO_REAL(EVP1610_1); MEMCPY( ADR(Send_Buffer[480]), ADR( AuxVar ), 4);

		(*FUNCTIONS IN USE*)
		(*120*)AuxVar := UINT_TO_REAL(POWERPACK.NHP); MEMCPY( ADR(Send_Buffer[484]), ADR( AuxVar ), 4);
		(*121*)AuxVar := UINT_TO_REAL(POWERPACK.NLP); MEMCPY( ADR(Send_Buffer[488]), ADR( AuxVar ), 4);
		(*122*)AuxVar := UINT_TO_REAL(POWERPACK.NW ); MEMCPY( ADR(Send_Buffer[492]), ADR( AuxVar ), 4);

		(*123*)MEMCPY( ADR(Send_Buffer[496]), ADR( POWERPACK.LP_Perc ), 4); (*Flow Percentage*)

		(*WINCHES INPUTS*)
		(*124*)MEMCPY( ADR(Send_Buffer[500]), ADR( MAIN.fbW1202.ToFaroInput ), 4); (*Primary Winch Stbd*)
		(*125*)MEMCPY( ADR(Send_Buffer[504]), ADR( MAIN.fbW1204.ToFaroInput ), 4); (*Pit Winch Stbd*)
		(*126*)MEMCPY( ADR(Send_Buffer[508]), ADR( MAIN.fbW1206.ToFaroInput ), 4); (*Mainsheet Winch*)
		(*127*)MEMCPY( ADR(Send_Buffer[512]), ADR( MAIN.fbW1208.ToFaroInput ), 4); (*Runner Winch Port*)
		(*128*)MEMCPY( ADR(Send_Buffer[516]), ADR( MAIN.fbW1210.ToFaroInput ), 4); (*Primary Winch Port*)
		(*129*)MEMCPY( ADR(Send_Buffer[520]), ADR( MAIN.fbW1212.ToFaroInput ), 4); (*Secondary Winch Port*)
		(*130*)MEMCPY( ADR(Send_Buffer[524]), ADR( MAIN.fbW1214.ToFaroInput ), 4); (*Pit Winch Port*)

		(*131*)MEMCPY( ADR(Send_Buffer[528]), ADR( MAIN.fbW1602.ToFaroInput ), 4); (*Runner Winch Stbd*)
		(*132*)MEMCPY( ADR(Send_Buffer[532]), ADR( MAIN.fbW1604.ToFaroInput ), 4); (*Secondary Winch Stbd*)

		(*WINCHES OUTPUS*)
		(*133*)MEMCPY( ADR(Send_Buffer[536]), ADR( MAIN.fbW1202.ToFaroOutput ), 4); (*Primary Winch Stbd*)
		(*134*)MEMCPY( ADR(Send_Buffer[540]), ADR( MAIN.fbW1204.ToFaroOutput ), 4); (*Pit Winch Stbd*)
		(*135*)MEMCPY( ADR(Send_Buffer[544]), ADR( MAIN.fbW1206.ToFaroOutput ), 4); (*Mainsheet Winch*)
		(*136*)MEMCPY( ADR(Send_Buffer[548]), ADR( MAIN.fbW1208.ToFaroOutput ), 4); (*Runner Winch Port*)
		(*137*)MEMCPY( ADR(Send_Buffer[552]), ADR( MAIN.fbW1210.ToFaroOutput ), 4); (*Primary Winch Port*)
		(*138*)MEMCPY( ADR(Send_Buffer[556]), ADR( MAIN.fbW1212.ToFaroOutput ), 4); (*Secondary Winch Port*)
		(*139*)MEMCPY( ADR(Send_Buffer[560]), ADR( MAIN.fbW1214.ToFaroOutput ), 4); (*Pit Winch Port*)

		(*140*)MEMCPY( ADR(Send_Buffer[564]), ADR( MAIN.fbW1602.ToFaroOutput ), 4); (*Runner Winch Stbd*)
		(*141*)MEMCPY( ADR(Send_Buffer[568]), ADR( MAIN.fbW1604.ToFaroOutput ), 4); (*Secondary Winch Stbd*)

		(*Extra Variables*)
		(*142*)AuxVar := UINT_TO_REAL(MAIN.fbMastSetup.Selected_MS); MEMCPY( ADR(Send_Buffer[572]), ADR( AuxVar ), 4);
		(*143*)AuxVar := UINT_TO_REAL(MAIN.fbMastSetup.Selected_HS); MEMCPY( ADR(Send_Buffer[576]), ADR( AuxVar ), 4);

		(*144*)MEMCPY( ADR(Send_Buffer[580]), ADR( S1100.Deg ), 4);

		(*145*)MEMCPY( ADR(Send_Buffer[584]), ADR( ENGINE.fbEngine.Engine_RPM), 4); (*TargetRPM*)
		(*146*)MEMCPY( ADR(Send_Buffer[588]), ADR( SEND_J1939.PedalPerc), 4); (*TagetRPM_Perc*)

		(*147*)MEMCPY( ADR(Send_Buffer[592]), ADR( P003.Bar ), 4); (*TagetRPM_Perc*)

(*
*)

		Send_ID           := Send_ID + 1;
		Send_NumberOfVars := 147;
		Send_Offset       := 0;

		MEMCPY( ADR(Send_Buffer[ 0]), ADR(Send_Id           ), 4);
		MEMCPY( ADR(Send_Buffer[ 4]), ADR(Send_NumberOfVars ), 2);
		MEMCPY( ADR(Send_Buffer[ 6]), ADR(Send_Offset       ), 2);

	END_IF

	fbUdpSend(
		bEnable    := PARAMS.nUDPSendTime > 0,
		sRemoteHost:= PARAMS.sUDPSendHost,
		nRemotePort:= PARAMS.nUDPSendPort,
		nTime      := PARAMS.nUDPSendTime,

		pBuffer:= ADR(Send_Buffer),
		wBufLen:= 596, (*8 + 147*4*)
		nCycle := 20,
	);

END_IF
END_PROGRAM

