(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_READ_SENSOR_TEMP : BOOL
VAR_INPUT
END_VAR
VAR_IN_OUT
	stSensor : ST_SENSOR_TEMP;
	fbIdList : FB_IDLIST;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)
stSensor.Cal_K   := F_IDLIST_GETREAL( CONCAT(stSensor.Name, '_K'   ), fbIdList );
stSensor.Cal_Off := F_IDLIST_GETREAL( CONCAT(stSensor.Name, '_Off' ), fbIdList );

stSensor.LowDeg  := F_IDLIST_GETREAL( CONCAT(stSensor.Name, '_Mild' ), fbIdList );
stSensor.HigDeg  := F_IDLIST_GETREAL( CONCAT(stSensor.Name, '_High' ), fbIdList );
stSensor.MaxDeg  := F_IDLIST_GETREAL( CONCAT(stSensor.Name, '_Max'  ), fbIdList );
stSensor.Delay   := F_IDLIST_GETREAL( CONCAT(stSensor.Name, '_Dly'  ), fbIdList );
END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN\/PARAMETERS' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_READ_TACK_VALVE_CFG : BOOL
VAR_INPUT
	sHead : STRING;
	rTime : REAL;
END_VAR
VAR_IN_OUT
	stConfig : ST_TACK_VALVE_CFG;
	fbIdList : FB_IDLIST;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)
stConfig.Cycle    := rTime;
stConfig.TimeMax  := F_IDLIST_GETREAL( CONCAT(sHead, '_TimeMax'   ), fbIdList );

stConfig.Hyst_HeelH := F_IDLIST_GETREAL( CONCAT(sHead, '_Hyst_HeelH' ), fbIdList );
stConfig.Hyst_HeelL := F_IDLIST_GETREAL( CONCAT(sHead, '_Hyst_HeelL' ), fbIdList );
stConfig.Hyst_Time  := F_IDLIST_GETREAL( CONCAT(sHead, '_Hyst_Time'  ), fbIdList );
END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN\/PARAMETERS' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_READ_TRAVELLER_CFG : BOOL
VAR_INPUT
	sHead : STRING;
	rTime : REAL;
END_VAR
VAR_IN_OUT
	stConfig : ST_TRAVELLER_CFG;
	fbIdList : FB_IDLIST;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)
stConfig.MaxEVPA := F_IDLIST_GETREAL( CONCAT(sHead, '_MaxEVPA' ), fbIdList );
stConfig.MaxEVPB := F_IDLIST_GETREAL( CONCAT(sHead, '_MaxEVPB' ), fbIdList );
stConfig.MinEVPA := F_IDLIST_GETREAL( CONCAT(sHead, '_MinEVPA' ), fbIdList );
stConfig.MinEVPB := F_IDLIST_GETREAL( CONCAT(sHead, '_MinEVPB' ), fbIdList );

stConfig.Spd_Inc := F_IDLIST_GETREAL( CONCAT(sHead, '_Spd_Inc' ), fbIdList );
stConfig.Spd_Dec := F_IDLIST_GETREAL( CONCAT(sHead, '_Spd_Dec' ), fbIdList );

stConfig.TgtLS_Max  := F_IDLIST_GETREAL( CONCAT(sHead, '_TgtLS_Max'  ), fbIdList );
stConfig.TgtLS_Zero := F_IDLIST_GETREAL( CONCAT(sHead, '_TgtLS_Zero' ), fbIdList );
stConfig.TgtLS_Min  := F_IDLIST_GETREAL( CONCAT(sHead, '_TgtLS_Min'  ), fbIdList );

stConfig.TgtLS_Tack_Off := F_IDLIST_GETREAL( CONCAT(sHead, '_TgtLS_Tack_Off' ), fbIdList );

stConfig.LS_DB    := F_IDLIST_GETREAL( CONCAT(sHead, '_LS_DB'    ), fbIdList );
stConfig.LS_Dist  := F_IDLIST_GETREAL( CONCAT(sHead, '_LS_Dist'  ), fbIdList );
stConfig.LS_Limit := F_IDLIST_GETBOOL( CONCAT(sHead, '_LS_Limit' ), fbIdList );

stConfig.TimeMax  := F_IDLIST_GETREAL( CONCAT(sHead, '_TimeMax'  ), fbIdList );
stConfig.Cycle    := rTime;

stConfig.Hyst_HP := F_IDLIST_GETREAL( CONCAT(sHead, '_Hyst_HP' ), fbIdList );
stConfig.Hyst_LP := F_IDLIST_GETREAL( CONCAT(sHead, '_Hyst_LP' ), fbIdList );
stConfig.Hyst_TM := F_IDLIST_GETREAL( CONCAT(sHead, '_Hyst_TM' ), fbIdList );


stConfig.HP  := F_IDLIST_GETBYTE( CONCAT(sHead, '_HP'  ), fbIdList );
stConfig.LP  := F_IDLIST_GETBYTE( CONCAT(sHead, '_LP'  ), fbIdList );
END_FUNCTION


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/FUN\/PARAMETERS' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION F_READ_WB_CFG : BOOL
VAR_INPUT
	sHead : STRING;
	rTime : REAL;
END_VAR
VAR_IN_OUT
	stConfig : ST_WB_CFG;
	fbIdList : FB_IDLIST;
END_VAR
VAR
END_VAR
(* @END_DECLARATION := '0' *)
stConfig.Cycle    := rTime;
stConfig.TimeMax_Idle  := F_IDLIST_GETREAL( CONCAT(sHead, '_TimeMax_Idle'   ), fbIdList );
stConfig.TimeMax_Init  := F_IDLIST_GETREAL( CONCAT(sHead, '_TimeMax_Init'   ), fbIdList );
stConfig.TimeMax_DumpFwd  := F_IDLIST_GETREAL( CONCAT(sHead, '_TimeMax_DumpFwd'   ), fbIdList );
stConfig.TimeMax_DumpAft  := F_IDLIST_GETREAL( CONCAT(sHead, '_TimeMax_DumpAft'   ), fbIdList );
stConfig.TimeMax_MoveFwd  := F_IDLIST_GETREAL( CONCAT(sHead, '_TimeMax_MoveFwd'   ), fbIdList );
stConfig.TimeMax_MoveAft  := F_IDLIST_GETREAL( CONCAT(sHead, '_TimeMax_MoveAft'   ), fbIdList );

stConfig.EVP_Pump_Min := F_IDLIST_GETREAL( CONCAT(sHead, '_EVP_Pump_Min' ), fbIdList );
stConfig.EVP_Pump_Max := F_IDLIST_GETREAL( CONCAT(sHead, '_EVP_Pump_Max' ), fbIdList );
stConfig.EVP_Pump_Inc := F_IDLIST_GETREAL( CONCAT(sHead, '_EVP_Pump_Inc' ), fbIdList );
stConfig.EVP_Pump_Dec := F_IDLIST_GETREAL( CONCAT(sHead, '_EVP_Pump_Dec' ), fbIdList );

stConfig.LP := F_IDLIST_GETBYTE( CONCAT(sHead, '_LP' ), fbIdList );

stConfig.EnScoopAF := F_IDLIST_GETBOOL( CONCAT(sHead, '_EnScoopAF' ), fbIdList );

END_FUNCTION


