EVP313.Bar := 10000;
IF fbSE301.OUT_CylOut THEN EVP313.Bar := MIN(fbSE301.OUT_Ease, EVP313.Bar); END_IF
IF fbSE303.OUT_CylOut THEN EVP313.Bar := MIN(fbSE303.OUT_Ease, EVP313.Bar); END_IF
IF fbSE305.OUT_CylOut THEN EVP313.Bar := MIN(fbSE305.OUT_Ease, EVP313.Bar); END_IF
IF fbSE307.OUT_CylOut THEN EVP313.Bar := MIN(fbSE307.OUT_Ease, EVP313.Bar); END_IF
IF fbSE309.OUT_CylOut THEN EVP313.Bar := MIN(fbSE309.OUT_Ease, EVP313.Bar); END_IF
IF fbSE311.OUT_CylOut THEN EVP313.Bar := MIN(fbSE311.OUT_Ease, EVP313.Bar); END_IF
IF EVP313.Bar = 10000 THEN EVP313.Bar := 0.0; END_IF

